{
  "// .sar UI = %100 NATIVE Sarmal": "üçüncü-parti indent-rainbow + errorlens .sar için susturuldu; özellikleri girinti.ts + satirici.ts native karşılıyor (Founder 2026-07-09)",
  "indentRainbow.excludedLanguages": [
    "plaintext",
    "sarmal"
  ],
  "errorLens.excludePatterns": [
    "**/*.sar"
  ],
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "entity.name.tag.sar",
        "settings": {
          "foreground": "#E5C07B",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "markup.heading.sar",
        "settings": {
          "foreground": "#C0925C",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "punctuation.definition.comment.begin.sar",
          "punctuation.definition.comment.end.sar"
        ],
        "settings": {
          "foreground": "#2ECC71",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "string.quoted.double.sar",
          "string.quoted.triple.sar"
        ],
        "settings": {
          "foreground": "#FFFFFF"
        }
      },
      {
        "scope": "constant.other.kod.sar",
        "settings": {
          "foreground": "#E5C07B"
        }
      },
      {
        "scope": "constant.numeric.sar",
        "settings": {
          "foreground": "#B5CEA8"
        }
      },
      {
        "scope": "markup.table.sar",
        "settings": {
          "foreground": "#82C7B0"
        }
      },
      {
        "scope": "keyword.control.sar",
        "settings": {
          "foreground": "#C586C0"
        }
      },
      {
        "scope": "entity.name.function.sar",
        "settings": {
          "foreground": "#DCDCAA"
        }
      },
      {
        "scope": "keyword.control.flow.sar",
        "settings": {
          "foreground": "#FF79C6",
          "fontStyle": "bold"
        }
      }
    ],
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "entity.name.tag.sar",
          "settings": {
            "foreground": "#9A6700",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "markup.heading.sar",
          "settings": {
            "foreground": "#8C5A2B",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "punctuation.definition.comment.begin.sar",
            "punctuation.definition.comment.end.sar"
          ],
          "settings": {
            "foreground": "#1E9E50",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "string.quoted.double.sar",
            "string.quoted.triple.sar"
          ],
          "settings": {
            "foreground": "#1F1F1F"
          }
        },
        {
          "scope": "constant.other.kod.sar",
          "settings": {
            "foreground": "#9A6700"
          }
        },
        {
          "scope": "constant.numeric.sar",
          "settings": {
            "foreground": "#098658"
          }
        },
        {
          "scope": "markup.table.sar",
          "settings": {
            "foreground": "#1E6E5C"
          }
        },
        {
          "scope": "keyword.control.sar",
          "settings": {
            "foreground": "#AF00DB"
          }
        },
        {
          "scope": "entity.name.function.sar",
          "settings": {
            "foreground": "#795E26"
          }
        },
        {
          "scope": "keyword.control.flow.sar",
          "settings": {
            "foreground": "#C2185B",
            "fontStyle": "bold"
          }
        }
      ]
    }
  },
  "workbench.colorCustomizations": {
    "editorLightBulb.foreground": "#FFFFFF",
    "editorLightBulbAutoFix.foreground": "#FFFFFF",
    "editorError.foreground": "#EF4444",
    "editorWarning.foreground": "#FF8C42",
    "editorInfo.foreground": "#4D9FFF",
    "editorInfo.background": "#4D9FFF26",
    "editorOverviewRuler.infoForeground": "#4D9FFF",
    "list.errorForeground": "#EF4444",
    "list.warningForeground": "#FF8C42",
    "list.infoForeground": "#4D9FFF",
    "checkbox.foreground": "#8CC152"
  },
  "editor.lightbulb.enabled": "on",
  "workbench.productIconTheme": "sarmal-kuzey-yildizi",
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "sarmalBahce": "#8A6E58",
      "sarmalAgac": "#9A7A5C",
      "sarmalKok": "#AC814F",
      "sarmalGovde": "#C0925C",
      "sarmalDal": "#D0A878",
      "sarmalAltDal": "#D8BE94",
      "sarmalYaprak": "#8CC152",
      "sarmalMeyve": "#C173CE",
      "sarmalBilgi": "#4ec9b0",
      "sarmalOrkestrasyon": "#c9b458",
      "sarmalEtmen": "#c586c0",
      "sarmalYuzey": "#ce9178",
      "sarmalYasa": "#e06c6c",
      "sarmalTeknoloji": "#5b97a3",
      "sarmalSurec": "#9c7256",
      "sarmalNitelik": "#b56a8e",
      "sarmalOz": "#56C8D8",
      "sarmalDavranis": "#4fc1ff",
      "sarmalArkayuz": "#2472c8",
      "sarmalParam": "#9CDCFE",
      "sarmalKod": "#E5C07B",
      "sarmalKenar": "#FF79C6",
      "sarmalDizgi": "#FFFFFF",
      "sarmalKodEtmen": "#D886D3",
      "sarmalKodBeceri": "#4EC9B0",
      "sarmalKodBellek": "#DCDCAA",
      "sarmalKodHatir": "#569CD6",
      "sarmalKodYasa": "#F14C4C",
      "sarmalKodYuzey": "#CE9178",
      "sarmalKodPlan": "#D0A878",
      "sarmalKodOz": "#8A9BA8"
    },
    "[*Light*]": {
      "rules": {
        "sarmalParam": "#0451A5",
        "sarmalKod": "#9A6700",
        "sarmalKodEtmen": "#A626A4",
        "sarmalKodBeceri": "#0E7C6B",
        "sarmalKodBellek": "#8F7A00",
        "sarmalKodHatir": "#0B62B8",
        "sarmalKodYasa": "#C41E1E",
        "sarmalKodYuzey": "#A0522D",
        "sarmalKodPlan": "#8B6A3D",
        "sarmalKodOz": "#5A6B78"
      }
    }
  }
}
