    AltKatman( kod: BKM-OLG-K1, departman: kodlama, ad: "taksonomi örtüsü" ) {
      Adım( kod: BKM-OLG-A01, durum: tamamlandı, üretir: [ KOD-SINIFLAMA ], bağımlı: [],
