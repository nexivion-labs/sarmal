          kabul:  "F7 kanıtı: YOL HARİTASI paneli 0.9.x'te canlı (durum kaydı oturum 23), eklenti süiti yeşil",
          ne:     "🚂 Activity Bar'a tren-ray ikonu + TreeView paneli: Blok→Faz→Katman→Adım, yerli kutucuklarla (checkboxState)",
        )
        Adım( kod: EKL-F7-A03, durum: tamamlandı, üretir: [ KOD-YOLHARITA ], kabul: "F7 kanıtı: YOL HARİTASI paneli 0.9.x'te canlı (durum kaydı oturum 23), eklenti süit>i yeşil",
