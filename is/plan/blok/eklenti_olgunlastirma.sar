  # 🧭 Eklenti Olgunlaştırma Planı — Anlatı Standardıyla

  ## Amaç
  🎯 Sarmal VS Code eklentisini "çalışan araç" seviyesinden "gerçek kod editörü"
  seviyesine taşımak: dil kendini kendi diliyle ifade eder, anlatı akademik
  standarda bağlanır, renk niyeti taşır, biçimlendirme insan yükünü sıfırlar.

  ## Kapsam
  📦 Bu plan yalnız eklenti ve motorun editör-yüzeyini kapsar. Kural ve söz
  dizimi belgelerinin .sar diline çevrilmesi, anlatı katmanının Amaç·Kapsam·Sonuç
  şemasına bağlanması ve motorca denetlenmesi, renk kanonunun SNF-0 tek-kaynağına
  taşınması ve biçimlendiricinin gözden geçirilmesi bu kapsamın içindedir.
  Nexivion OS ürün ağacı, orkestratör-runtime ve git yönetişimi bu planın
  KAPSAMI DIŞINDADIR — onlar OS taşıma gününün işidir. Sonuç olarak sınır:
  eklenti/ + cekirdek/ + oz/ dizinleriyle çizilidir.

  ## Neden
  🌉 5N1K olgu katmanı dilin parametrelerinde zaten kodludur (ne·neZaman·uygular·
  yol·koşul); eksik olan muhakeme katmanıdır. Aynı bilginin iki evde yaşaması
  çift-kayıt drifti üreteceğinden, olgu parametrede kalır, muhakeme belgeye gelir.

  ## Sonuç
  ✅ Plan tamamlandığında: tüm dil belgeleri .sar, tüm anlatılar 3-bölümlü şemadan
  motor denetiminde, renkler tek kaynaktan derlenir ve biçimlendirici uzun niyeti
  kendiliğinden katlar. Kabul ölçütü: her fazın kapı adımı motor-temiz kapanır.
|<--

Blok( kod: BLK-EKLENTI, ad: "eklenti-olgunlastirma", uygular: ORK-7 ) {   // A02 onarımı: ANY-EKLENTI hiç doğmadı — kırık uygular kenarı gerçek anayasaya bağlandı

  // ── FAZ 1 · ÖZ-İFADE: dil kendini kendi diliyle anlatır ────────────────────
  Katman( kod: EKL-F1, kullanır: TAKIM-EKLENTI, ad: "oz-ifade",
    ne: "🪞 Bir dil kendini kendi diliyle ifade etmelidir — kural ve söz dizimi belgeleri .sar diline çevrilir" ) {
    AltKatman(
      kod: ALT-EKL-F1-CEVIRI, departman: kodlama,
      ad:  "belge cevirisi",
      ne:  "🔤 Kural ve söz dizimi belgeleri .md'den .sar diline çevrilir; çift-kayıt kalmaz",
    ) {
      Adım(
        kod:   EKL-F1-A01,
        durum: tamamlandı,
        kabul: "F1 kapısı motor-temiz kapandı: belgeler .sar'a çevrildi, eski .md'ler arşivde (çift-kayıt yok)",
        ne:    "📚 Envanter: çevrilecek belgeler listelenir (soz-dizimi.md · genel_kurallar · rehber.json · walkthrough metinleri)",
      )
      Adım(
        kod:   EKL-F1-A02,
        durum: tamamlandı,
        kabul: "F1 kapısı motor-temiz kapandı: belgeler .sar'a çevrildi, eski .md'ler arşivde (çift-kayıt yok)",
        ne:    "🔤 Çeviri şablonu: Kural/Tip widget'larıyla belge→.sar kalıbı tasarlanır; ilk pilot belge-yorum ailesi olur (bugünkü DIL-2)",
      )
      Adım( kod: EKL-F1-A03, durum: tamamlandı, üretir: [ KOD-YASA-SOZDIZIMI ], kabul: "F1 kapısı motor-temiz kapandı: belgeler .sar'a çevrildi, eski .md'ler arşivde (çift-kayıt yok)", ne: """
          🏗️ Söz dizimi belgeleri (eski söz-dizimi kural ailesi — bugünkü DIL-6) .sar dosyalarına çevrilir:
          — her SD maddesi bir Kural düğümü olur
          — örnek kesitleri belge bloğunda ```sar çitiyle taşınır
          — yasa/genel_kurallar/dizin.md yeni dosyalara bağlanır
          """ )
      Adım(
        kod:   EKL-F1-A04,
        durum: tamamlandı,
        kabul: "F1 kapısı motor-temiz kapandı: belgeler .sar'a çevrildi, eski .md'ler arşivde (çift-kayıt yok)",
        ne:    "🚪 Faz kapısı: çevrilen dosyalar motor-temiz + eski .md'ler arşive iner (çift-kayıt kalmaz)",
      )
    }
  }

  // ── FAZ 2 · ANLATI STANDARDI: olgu parametrede, muhakeme belgede ───────────
  Katman( kod: EKL-F2, kullanır: TAKIM-EKLENTI, ad: "anlati-standardi",
    ne: "🎓 Anlatı katmanı akademik şemaya bağlanır: Amaç · Kapsam (1 giriş + ≥3 gelişme + 1 sonuç) · Sonuç" ) {
    AltKatman(
      kod: ALT-EKL-F2-SEMA, departman: kodlama,
      ad:  "anlati semasi",
      ne:  "🎓 Belge bloğu Amaç·Kapsam·Sonuç şemasına bağlanır; motor bölüm eksikliğini denetler",
    ) {
      Adım( kod: EKL-F2-A01, üretir: [ KOD-YASA-GK ], durum: tamamlandı, kabul: "F2 kapısı motor-temiz kapandı: plan.sar + 5 örnek Blok yeni anlatı şemasından geçti (anlatı-ayrımı kuralı anayasada — bugünkü DIL-2)", ne: """
          ⚖️ Katman ayrımı kanunlaşır (çift-kayıt drifti önlenir):
          — OLGU = 5N1K = parametreler (ne · neZaman · uygular · yol · koşul) — zaten şemalı
          — MUHAKEME = Amaç·Kapsam·Sonuç = belge bloğu bölümleri
          — KÖPRÜ = Neden — yalnız belgede yaşar (## Neden)
          """ )
      Adım( kod: EKL-F2-A02, durum: tamamlandı, üretir: [ KOD-DOGRULAYICI ], kabul: "F2 kapısı motor-temiz kapandı: plan.sar + 5 örnek Blok yeni anlatı şemasından geçti (anlatı-ayrımı kuralı anayasada — bugünkü DIL-2)",
        ne: "🤖 Motor denetimi: şemaya bolumZorunlu alanı eklenir — belge bloğunda Amaç/Kapsam/Sonuç eksikse Türkçe uyarı" )
      Adım( kod: EKL-F2-A03, durum: tamamlandı, üretir: [ KOD-YASA-SOZDIZIMI ], kabul: "F2 kapısı motor-temiz kapandı: plan.sar + 5 örnek Blok yeni anlatı şemasından geçti (anlatı-ayrımı kuralı anayasada — bugünkü DIL-2)",
        ne: "📝 Çok hedefli niyet cümleleri alt alta listelenir (DIL-2.2 üç-tırnak + — imi); kısa, net, anlaşılır" )
      // MEYVE BEYANI (bilinçli boş · Sol RED onarımı 2026-07-18): emoji kuralı o dönem ayrı yasa dosyasına inmedi;
      // hükmün bugünkü evi EMJ rayının emoji-kanonu (kayit.json) ve DIL-1.1 maddesidir — meyve o raya devredildi.
      Adım( kod: EKL-F2-A04, durum: tamamlandı, kabul: "F2 kapısı motor-temiz kapandı: plan.sar + 5 örnek Blok yeni anlatı şemasından geçti (anlatı-ayrımı kuralı anayasada — bugünkü DIL-2)", ne: """
          😊 Emoji kuralı — anlam taşır, süslemez:
          — ANLATI katmanında (ne: · belge · yorum) anlama uygun emoji KULLANILIR
          — KİMLİK katmanında (KOD · tip adı · parametre adı) emoji YASAK
          — ölçüt: simge kategoriyi/durumu/metaforu taşımalı, konfeti değil
          """ )
      Adım( kod: EKL-F2-A05, durum: tamamlandı, kabul: "F2 kapısı motor-temiz kapandı: plan.sar + 5 örnek Blok yeni anlatı şemasından geçti (anlatı-ayrımı kuralı anayasada — bugünkü DIL-2)",
        ne: "🚪 Faz kapısı GEÇİLDİ: plan.sar + 5 örnek Blok yeni şemadan motor-temiz; kural anlatı-ayrımı olarak anayasada (bugünkü DIL-2)" )
    }
  }

  // ── FAZ 3 · RENK KANONU: renk niyetin görsel türevidir ─────────────────────
  Katman( kod: EKL-F3, kullanır: TAKIM-EKLENTI, ad: "renk-kanonu",
