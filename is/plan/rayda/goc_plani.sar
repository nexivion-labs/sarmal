      AltKatman( kod: ALT-GOC-BELGE-KOD, departman: kodlama, ad: "kodlama" ) {
        Adım( kod: GOC-BELGE-A02, durum: tamamlandı ) {
          koşu:  "2026-08-03 · KAPANIŞ. On altı okuma ve öğretim yüzü yeni kanonik kaynaktan yeniden üretildi ve DIATAXIS mühürüyle işaretlendi. İDEMPOTENS KANITLI: üretici aynı girdiyle iki kez koşuldu, sha256 mühür dosyalarının farkı boştur (0 değişti · 16 aynı · 144 madde · 18 araç). Bayatlık tablosu sıfırlandı: eski kod 47'den, eski omurga 11'den, emekli panel adı 8'den, on dokuz araç iddiası 1'den ve kalıcı göç eşlemesi 7'den sıfıra indi; tarihsel plan ve göç kanıtları bilinçli sınır gereği dokunulmadan kaldı. KONTROLCÜ BAĞIMSIZ ÖLÇÜMLERİ: kök yüzlerde emekli panel adı ve eski kod araması sıfır, DIATAXIS mührü yerinde, iki tür denetimi sıfır, çekirdek 964/964, eklenti 377/377, iki varlık denetimi filtresiz sıfır hata ve sıfır uyarı."
          ne:    "Okuma ve öğretim yüzlerini üretmek."
          görev: [
            "Resmi yeni yasa, canlı sınıflama ve motor tanı sicilinden README, indeks, Reference, Tutorial, How-To ve Explanation yüzlerini ilgili mevcut üreticilerle yeniden üret.",
            "`_Sarmal/cekirdek/src/belgele.ts`, `ogret.ts`, `kararlar.ts`, `siniflama.ts` ve ilgili yüz üreticilerini yeni kaynak sözleşmesiyle hizala.",
            "Elle korunan giriş ve anlatı bölgelerini üretim bölgesinden ayır; üreticiyi aynı girdilerle iki kez çalıştır.",
            "Eski kod veya göç eşlemesini kalıcı belge ve öğretim yüzlerine taşımayan içerik taraması çalıştır."
          ]
          kabul: [
            "Envanterdeki bütün okuma ve öğretim yüzleri yeni kanonik kaynaktan üretilir.",
            "İkinci üretim koşusu sıfır fark verir ve elle korunan bölgeler değişmez.",
            "Üretilen yüzlerde eski kod, geçici eşleme ve eski omurga öğretimi sıfırdır.",
            "Her yüz, ilanlı Diátaxis sınıfı başına makinece sayılabilir kontrolü geçer: Reference yüzünde alan tablosu tamdır, Tutorial yüzünde adım zinciri çalıştırılabilirdir, How-To yüzü tam bir görev taşır, Explanation yüzü çalıştırılabilir kod bloğu içermez; sınıf başına yüz sayımı belge envanteriyle birebirdir."
          ]
          bağımlı:  [ GOC-BELGE-A01 ]
          referans: [ YUZ-1.2, YUZ-1.3, YUZ-2.3, OGR-1, OGR-2, OGR-3.2 ]
          üretir:   [
            Göç( kod: GC-GOC-BELGE-YUZLER,
              ne: "Yeni kanondan idempotent üretilmiş okuma, indeks ve öğretim yüzleri — hedef: `_Sarmal/`." )
          ]
          sınır: "Üretilen yüz elle kaynak-gerçeğe dönüştürülmez ve göç haritası kalıcı öğretim girdisi yapılmaz."
        }

        Adım( kod: GOC-BELGE-A03, durum: tamamlandı ) {
          koşu:  "2026-08-03 · KAPANIŞ. Kanon tutarlılık yüzü artık ELLE YAZILMIYOR: kanon-tutarlilik.ts üreticisi sekiz resmî dosyadan türetiyor ve eski bayat tasarım kopyasının halefi doğdu. Ölçümler: 144/144 tekil madde (36 Karar + 108 Kural), dört parçalı madde 144/144, çözülemeyen dayanak sıfır, yeni tanı-madde eşleşme eksiği sıfır, uygulanmış-emekli kesişimi sıfır. Canlı yeni küme YETMİŞTİR (69 taban + tanı-yüzeyi-karışması) ve dağılım 46/16/8 olarak raporlandı; 101 önceki sabit kimlik, 9 sınıflama-türevli kimlik, 14 gerçek emekli ve 39 açık emeklilik borcu ayrı kümelerdir. İkinci koşu birebir aynı sonucu verdi ve sekiz kanon SHA mührü değişmedi. FOUNDER'A DEVİR: 39 emeklilik borcu kimliğinin sicilden çıkarılma sırası Founder kararıdır."
          ne:    "Tutarlılık yüzünü 144 maddeye türetmek."
          görev: [
            "Tutarlılık yüzünü resmi `_Sarmal/yasa/` kaynaklarındaki 144 maddelik güncel kanondan `_Sarmal/nitelik/goc/kanon_tutarlilik.sar` hedefine yeniden türet; `geneldurum/` altındaki bayat türevi kaynak olarak kullanma.",
            "Kanonik örnek, tanı ile madde haritası, değişmezler ve çelişki raporunu güncel YUZ-3.3 maddesi ile yeni tanı siciline göre yeniden hesapla.",
            "Eski 143 madde mührünü, bayat sayımları ve eski tanı sınıflamasını yürür türevden çıkar; `geneldurum/` altındaki bayat türevi final kapısının arşiv kümesine devret.",
            "Türevin kanon gövdesini değiştirmediğini ve kaynak mührünü açıkça taşıdığını doğrula."
          ]
          kabul: [
            "Tutarlılık yüzü 144/144 maddeyi kapsar ve kaynağı resmi yasa kaynaklarıdır.",
            "YUZ-3.3, 69 yeni tanı ve güncel korunan ile emekli tanı kümeleri haritada yer alır.",
            "143 maddelik bayat sayı veya kaynak mührü yürür türevde sıfırdır; `geneldurum/` altındaki bayat türev yürür tüketici taşımaz.",
