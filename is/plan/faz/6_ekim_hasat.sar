          sınır: "Kanon metni bu Adımda düzeltilmez; ayrışma bulunursa bulgu olarak raporlanır"
        }

        Adım( kod: HST-MTR-A02, ad: "Kanon Sayısının Tek Kaynağı", durum: beklemede, öncelik: p2, üretir: [ KOD-SNF-KANON ], bağımlı: [],
