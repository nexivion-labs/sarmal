    ne: "Eklentinin mağaza yüklemesinden önce kapanması gereken kusurlar — EKL-F6-A01'in yolunu açar" ) {

    Katman( kod: MGZ-EKLENTI, takım: TAKIM-EKLENTI, ad: "Yükleme Ön Koşulları",
      ne: "🛍️ Mağazadan kurulan eklentinin ilk izleniminde ve kapılarında ölçülmüş açıklar" ) {

      AltKatman( kod: MGZ-EKLENTI-K1, departman: sınama, ad: "Mağaza Kapısı",
        ne: "entegrasyon süiti, kısıtlı mod, tanı yüzeyi ve paket nöbetleri" ) {

        Adım( kod: MGZ-A01, ad: "Entegrasyon Süitinin On Altı Düşüşü", durum: beklemede, öncelik: p1, üretir: [ KOD-EKL-EKLENTI ], bağımlı: [],
          referans: [ HTR-EKLENTI-ENTEGRASYON-ON-ALTI-DUSUS ],
