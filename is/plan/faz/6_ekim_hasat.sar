          kabul: [
            "entegrasyon süiti yeşil ya da kalan her düşüş adıyla ve gerekçesiyle listelenmiş",
            "Onaylar karar komutunun gerçek çağrı yolu ölçülmüş ve kusur varsa onarılmış",
            "denetim 0 hata, birim süitleri yeşil"
          ]
          sınır: "Sınamalar yalnız yeşile dönsün diye zayıflatılmaz"
        }

