Kod( kod: KOD-SNM-DURUM, dosya: "urun/cekirdek/sinama/durum.test.ts",
  ne: "🍎 sınama nöbeti — durum türetme (bloklu/durumsuz=açık-iş · evre · AST toplama)" )
Kod( kod: KOD-YOL-DEKOR, dosya: "urun/eklenti/src/yol-dekor.ts",
  ne: "🍎 YUZ-4.1 dekor kararı SAF modülü — dekorCoz/DURUM_ROZET/DURUM_ANAHTAR: vscode'suz davranış-testli tek karar noktası (Terra-RED onarımı)" )
Kod( kod: KOD-SNM-MOTORGUVEN, dosya: "urun/cekirdek/sinama/motor-guven.test.ts",
  ne: "🍎 sınama nöbeti — TUR-2 motor güveni: Terra deneyleri regresyonda (öz-bağımlılık hata · yinelenen-parametre uyarı · durum-makinesi senaryoları)" )
Kod( kod: KOD-SNM-DELIK, dosya: "urun/cekirdek/sinama/delik-kapama.test.ts",
  ne: "🍎 sınama nöbeti — teftiş test delikleri kapandı: yolcoz (DIL-1.2 alt-çizgi) · tema YUZ-4.1 (geçersiz-renk/düşük-kontrast) · yazdir · denetleKomutu CLI 'bilgi tanıları çıktıda VAR' alt-süreç nöbeti" )
Kod( kod: KOD-TANI-SICILI, dosya: "urun/cekirdek/src/tani-sicili.ts",
  ne: "🍎 Tanı sicili — motorun tüm tanı kodları tek listede (kaynak-tarama nöbetli); Kural.tanı iddia-doğrulaması + kural↔kapı harita türetimi buradan (RF-T6-A03)" )
Kod( kod: KOD-TIP-DOGUM-KURALI,
  ne: "🍎 TIP-1 tip-doğum kapısı — bir tipin doğmuş sayılma koşulları yasada (motor-vatandaşlık + vitrin + canlı kullanım YA DA muafiyet beyanı); kullanımsız-tip bekçisine tanı: kenarıyla bağlı (RF-T6-A05 ürünü); gövde 2026-07-31 tarihinde repo dışı arşive indi, yürür hüküm kanon TIP bölümündedir" )

Kod( kod: KOD-HIYERARSI, dosya: "urun/cekirdek/src/denetci.ts",
