        // MIM-1.7 birleştirmesi (2026-08-28): aşağıdaki Adımlar "şablon kütüphanesi toparlama" kademesinden taşındı.
        //   Taşınan kademenin beyanı: 🍃 Dağınık şablonların (mcp.ts gömülü string + ornek/) tek 'sablon/' kütüphanesinde toplanması
        Adım( kod: BKM-OLG-A06, durum: tamamlandı, bağımlı: [], üretir: KOD-SABLON,
          ne:    "📐 Şablon kütüphanesi toparlama — dağınık şablonlar (mcp.ts gömülü string + ornek/) tek 'sablon/' kütüphanesine toplanır; başla hem CLI hem MCP oradan okur (açık-iş: SABLON-KUTUPHANE-TOPARLAMA · Founder 2026-07-10)" ) {
          görev: "Founder bulgusu: şablonlar dağınık (ekran/arkayüz/sözleşme bir arada değil). Çözüm: sablon/*.sar kanonik kütüphane (proje·blok·adım·sözleşme·arkayüz·ekran·etmen·mekanizma — eksik olan ARKAYÜZ + SÖZLEŞME dahil); cekirdek/src/sablon.ts tek kaynaktan okur (readFileSync + SABLON_KOK); mcp.ts gömülü SABLONLAR silinir, başla aracı sablon.ts'i çağırır; CLI `sarmal başla <tür>` eklenir (aynı kaynak, YUZ-1.2); sablon/ denetle YOKSAY'a + panel dışlamasına girer (yer-tutuculu şablon kapıyı bozmasın); OKU.md indeksi + ornek/OKU.md çapraz-referans"
          kabul: [
            "sablon/ 8 tip kanonik şablon + OKU.md; başla CLI ve MCP aynı sablon.ts'ten okur (çift-kaynak yok)",
            "arkayüz + sözleşme bağımsız şablonu eklendi (Founder'ın eksik dediği ikisi)",
            "tsc temiz + denetle TAM-yeşil + testler yeşil (sablon/ YOKSAY'da, kapı bozulmaz)"
          ]
          sınır: "yalnız şablon toparlama — ornek/ örnekleri yeniden düzenlenmez (OKU.md küratör haritası korunur); dil sadeleştirme ayrı tur"
        }
        // MIM-1.7 birleştirmesi (2026-08-28): aşağıdaki Adımlar "dil ve eklenti olgunluğu" kademesinden taşındı.
        //   Taşınan kademenin beyanı: hatırlatıcı gözden-geçirmesinden raya inen kalemler (Founder 2026-07-11: uygulanmamışlar planlamaya)
        Adım( kod: BKM-DIL-A01, durum: tamamlandı, üretir: [ KOD-YASA-SOZDIZIMI ], bağımlı: [],
          ne:    "🗣️ Dil analizi kalanları — KAPANIŞ 2026-07-12 (oturum 34, Founder'la canlı): ① çağır↔bağımlı↔kullanir ayrımı DIL-1.4 sayfasına örnekli yazıldı (kullanir=kök beyan-özelliği, KENAR DEĞİL — motor çözmez; bağ=bağımlı/çağır; tek gerçek kullanım sarmal_anadizin:97 envanterle doğrulandı) ② --> çoklu-kenar genişlemesi FOUNDER KARARIYLA GEREKÇELİ REDDEDİLDİ (DIL-1.4 karar notu: ok tek anlam taşır — ajan akıl-yükü sıfır; Founder merceği: 'özellik güzel ama ajan akıl edip kullanabilecek mi' → tek-anlam bu kaygının cevabı) ③ madde 6/7 GEREKSİZ-kapanış (dosya bilerek-hatalı ders vitrini + Proje→Tema sarması kanonda ZATEN izinli) · madde 8 kayit.md'ye kanonlandı (davranış: kardeş-İLAN + parametre-REFERANS deseni). HTR-DIL-ANALIZ pini yaşam-döngüsü gereği silindi (tarihçe git'te)" ) {
          görev: "Üç iş: (1) çağır (kod-tabanlı içe-aktarma, DIL-1.4) ile kullanir: (teknoloji beyanı) ayrımı yasada netleşir + gerekiyorsa denetim; (2) --> şekeri bugün yalnız besler üretir — çoklu kenar tipine (bağımlı vb.) genişletilir mi KARAR + uygulama; (3) 2026-07-05 analizindeki düşük-öncelikli temizlikler gözden geçirilir (analiz notu hatırlatıcıda)"
          kabul: [
            "çağır↔kullanir ayrımı yasada yazılı + örnekli; belirsizlik bitti",
            "--> genişleme kararı verildi (yapıldı YA DA gerekçeli reddedildi — dürüst kapanış)",
            "denetle-temiz + testler yeşil"
          ]
          sınır: "dil ÇEKİRDEĞİ işi — eklenti boyama ayrı Adımlarda (BKM-EKL)"
        }
        Adım( kod: BKM-DIL-A02, durum: tamamlandı, üretir: [ KOD-SNF-KANON ], bağımlı: [],
          ne:    "🪜 Rütbe-atlamalı sarma (rejim istisnası) — ara kademeler isteğe bağlı olur: Blok altına doğrudan Katman/Adım, Faz altına doğrudan Adım düşebilir; TERS sarma (Katman→Faz) yasak kalır. Founder: 'dengeli ve ölçülü olmalı, gelişigüzel yapılmamalı' (2026-07-11)" ) {
          görev: "Tek kaynak kayit.json → izinliSarma matrisi genişletilir: Blok → +Katman +Adım (Faz·Gereksinim·Kapı kalır) · Faz → +Adım (Kapı·Katman kalır) · Katman → Adım (değişmez). taksonomi-uret ile kayit.md yenilenir (elle tablo düzenleme YOK, OGR-3.2). Sarma testleri güncellenir: yeni izinler yeşil + ters sarma hâlâ izinsiz-sarma hatası (Katman içine Faz, Adım içine kapsayıcı). ray1_format.sar'daki eski katı-kural yorumu (MIM-3.1 düzeltmesi notu) rütbe-atlama işaretiyle güncellenir"
          kabul: [
            "Blok içinde doğrudan Adım/Katman, Faz içinde doğrudan Adım denetle-yeşil (fikstürlü test)",
            "ters sarma (Katman→Faz · Adım→kapsayıcı) izinsiz-sarma HATASI üretir (testli — rütbe düzeni korunur)",
            "kayit.md taksonomi-uret'le türedi; çekirdek + eklenti testleri yeşil, tsc ×2"
          ]
          sınır: "yalnız plan-ailesi sarma matrisi — yüzey/arkayüz aileleri ve TIP-1 kullanıcı-tipi kuralları DEĞİŞMEZ; mevcut planların sadeleştirilmesi (kademe söküm turu) AYRI iştir, A03 önerileri ışığında yapılır"
        }
        Adım( kod: BKM-DIL-A03, durum: tamamlandı, üretir: [ KOD-DENETCI ], bağımlı: [ BKM-DIL-A02 ],
          ne:    "🔵 Tek-çocuk önerisi (rütbe-atlama eki) — tek Adım taşıyan Katman'a ve tek Katman taşıyan Faz'a motor 'çocuğu yukarı alabilirsin' bilgi tanısı verir: şişkinlik denetimle geriletilir, zorlanmaz" ) {
          görev: "denetci.ts'e yapı-yalınlığı denetimi: kapsayıcının TEK kapsayıcı-olmayan işi tek çocuksa (Katman{1 Adım} · Faz{1 Katman}) duzey:bilgi tanısı — mesaj sade Türkçe (OGR-2.1): 'Bu Katman tek Adım taşıyor — Adım'ı doğrudan Faz’a alabilirsin (rütbe-atlama)'. Mevcut planlar HATALANMAZ (bilgi düzeyi karneyi/kapıyı etkilemez); tanı kodu kararlı: tek-cocuk-kapsayici"
          kabul: [
