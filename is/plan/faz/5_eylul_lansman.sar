          ne: "🪪 Planda ilan edilmiş her ajanın profil kartı. Bugün Tren ajanları düz bir liste olarak yalnız kodları ve türleriyle göstermektedir; Founder 2026-10-27 tarihinde ajanların görev, yetki, yetenek, beceri ve bellekleriyle görünmesine hükmetmiştir." ) {
          görev: [
            "Ajanları rozetli kutular olarak göster; yöneticiler üstte, uzmanlar altta durur ve yönetir bağları çizilir.",
            "Ajana tıklayınca kartında uzmanlık, yetki, bellek tercihi, ne ve uygular alanlarını; Beceri, Yetenek, Bellek, Kanca ve Tetikleyici alt düğümlerini sayılarıyla göster; her satır tanımına gider."
          ]
          kabul: [
            "Kartın her alanı .sar kaynağından okunur ve tanımına gider; bunu bir nöbet ölçer.",
            "Kartın ekran görüntüsü üçüncü basamağın tesliminde Founder'a sunulmak üzere kayda alınmıştır."
          ]
          sınır: "Şema değişmez; yalnız var olan alanlar ve alt düğümler gösterilir. Canlı oturum bilgisi bu Adımın işi değildir."
        }

        Adım( kod: PNL-A12, ad: "Geliştirmedeki İşin Zinciri", durum: beklemede, öncelik: p1, bağımlı: [ PNL-A16 ],
          ne: "⛓️ Geliştirmedeki her Adım için Adımın, atanan ajanın, Katmanın teknolojisinin ya da takımının ve AltKatmanın departmanının tek satırda gösterilmesi." ) {
          görev: [
            "Geliştirmedeki Adımın kapsayan zincirini çöz: Katmanın teknolojisi ya da takımı ve AltKatmanın departmanı.",
            "Adıma bir Görev ile atanmış ajan varsa onu da göster; yoksa atanmamış diye yaz."
          ]
          kabul: [
            "Her satır dört parçayı da kaynaktan doğru okur; bunu bir nöbet ölçer."
          ]
          sınır: "Atama yapılmaz; yalnız var olan atama gösterilir."
        }

        Adım( kod: PNL-A13, ad: "Kardeş Eklenti Yuvası", durum: beklemede, öncelik: p1, bağımlı: [ PNL-A16 ],
          referans: [ HTR-TREN-CANLI-AJAN-EKRANI, OZK-13 ],
          ne: "🔌 Kapalı kardeş eklentinin Tren sekmesinin içine kendi canlı görünümünü takabileceği belgelenmiş bir yuva. Founder 2026-10-27 tarihinde canlı ajan şemasının ve mesajlaşmanın kapalı kardeş eklentide yaşamasına hükmetmiştir; açık eklenti yalnız yuvayı sunar." ) {
          görev: [
            "Yuvanın sözleşmesini yaz ve belgele: kardeş eklenti kendini kaydeder, Tren sekmesinde Canlı görünümü açılır, kardeş yoksa sekme açık yüzüyle çalışır.",
            "Sözleşmeyi sahte bir kardeş eklentiyle gerçek VS Code süitinde sına."
          ]
          kabul: [
            "Sahte kardeş eklenti kaydolunca Canlı görünümü açılır; kaydolmazsa sekme hatasız çalışır.",
            "Açık depoda kapalı tarafa ait hiçbir kod, ad ya da protokol yoktur."
          ]
          sınır: "Canlı şemanın, mesaj akışının ve geliştirici mesajlaşmasının kendisi bu depoya yazılmaz."
        }
      }
    }

    Katman( kod: KAT-PNL-HIZ, takım: [ TAKIM-EKLENTI, TAKIM-CEKIRDEK ], ad: "Panel Hızı",
      ne: "⚡ Açılışın ve denetim turunun süresi" ) {

      AltKatman( kod: ALT-PNL-HIZ-KODLAMA, ad: "Tur Süresi", departman: kodlama,
        ne: "🔧 Okumanın ve ayrıştırmanın hızlandırıldığı dal" ) {

        Adım( kod: PNL-A14, ad: "Açılış ve Tur Süresinin Düşürülmesi", durum: geliştirmede, öncelik: p0, bağımlı: [ PNL-A02 ],
          referans: [ OZK-12, HTR-EKLENTI-DAR-KAPSAM-BAYAT-PANEL, EKL-F6-A09, BLK-PRF-PANELKIPI, BLK-PRF-ISCI ],
          ne: "🐢 Founder 2026-10-27 tarihinde eklentinin açılışının ve tepkisinin yavaşladığını bildirmiştir. Aynı gün ölçülen başlangıç turu çatıda yirmi iki saniye sürmüş ve 357 dosyayı, yaklaşık 7,5 MB'ı tek tek sırayla diskten okumuştur; her belge ayrıca ikinci kez ayrıştırılmaktadır." ) {
          görev: [
            "Performans kanalında tur süresini okuma, ayrıştırma, denetim ve yayın aşamalarına böl ve tabanı kayda geçir.",
            "Diskteki dosyaları sırayla değil paralel oku.",
            "Tanı için yapılan ikinci ayrıştırmayı kaldır; turun ağacını yeniden kullan.",
            "Ölçümden sonra denetim turu OZK-12 eşiğini hâlâ aşıyorsa sonucu Founder'a sun; ertelenmiş işçi Blokunun mührü yalnız Founder'ın sözüyle kalkar."
          ]
          kabul: [
            "Önce ve sonra ölçümleri aynı çatıda alınmış ve koşu kaydına yazılmıştır.",
            "Denetim turları ve tanılar ölçümden önceki hâliyle birebir aynıdır; bunu bir nöbet ölçer.",
            "Açılış süresinin önce ve sonra değerleri birinci basamağın tesliminde Founder'a sunulmak üzere kayda alınmıştır."
          ]
          sınır: "Denetim kuralları değişmez. İşçi iş parçacığına taşıma bu Adımın işi değildir."
        }

        Adım( kod: PNL-A18, ad: "Sekme Geçişinin Eklentiyi Beklememesi", durum: beklemede, öncelik: p0, bağımlı: [ PNL-A03 ],
          referans: [ OZK-13 ],
          ne: "⏱️ Sekme geçişinin anında ve eklentiden bağımsız olması. Founder 2026-10-28 tarihli ekran kaydında 0.9.195 sürümünde şunu göstermiştir: sekmeye tıklayınca vurgu hemen yeni sekmeye geçmekte, fakat içerik eski sekmede kalmakta ya da başka bir sekmenin içeriği görünmektedir; Makinist seçiliyken Yol Haritası, ardından Mini Grafın satırları görünmüş, Tren ve Ray tıklamaları içeriği değiştirmemiştir. Neden, içeriğin değişmesinin eklentiye gidip gelen bir iletiye bağlı olmasıdır: eklenti denetim turunun bölünmez senkron bloğundayken ileti gecikmekte ya da yanıt yanlış sekmeye düşmektedir. Founder bu durumu donma ve bazen açılmama olarak tarif etmiştir." ) {
          görev: [
            "Beş sekmenin içeriğini panelin webview'inde hazır tut; sekmeye tıklayınca içerik webview'in kendi içinde anında değişsin ve eklentiye gidip gelen bir yanıt beklenmesin.",
            "Eklentiden gelen her parça güncellemesi kendi sekmesinin bölümüne yazılsın; hangi sekme seçili olursa olsun bir sekmenin içeriği başka bir sekmenin yerine çizilmesin.",
            "Webview'deki sekme seçimi ile eklentinin tuttuğu sekme ve bölüm yuvası seçimi tek kaynaktan yürüsün; ikisinin ayrışması olanaksız olsun.",
            "Nöbet kur: eklenti uzun bir senkron iş yaparken sekme geçişi gecikmesiz gerçekleşir ve seçili sekme ile görünen içerik her an aynıdır."
          ]
          kabul: [
            "Eklentinin iş parçacığı yapay olarak birkaç saniye kilitliyken sekme geçişi webview'de anında gerçekleşir ve doğru içerik görünür; bunu görsel kontrol ve gerçek VS Code nöbeti ölçer.",
            "Hiçbir sırada seçili sekme ile görünen içerik ayrışmaz; parça güncellemesi yalnız kendi sekmesine yazılır.",
            "Sekme geçişinin kaydı birinci basamağın tesliminde Founder'a sunulmak üzere alınmıştır."
          ]
          sınır: "Denetim turunun kendisi bu Adımda değişmez; turun ana iş parçacığından çıkarılması işçi Blokunun işidir."
        }
      }
    }

    Katman( kod: KAT-PNL-TESLIM, takım: TAKIM-EKLENTI, ad: "Sürüm ve Teslim",
      ne: "📦 Üç teslim basamağının paketlendiği ve Founder'ın gözünden geçtiği katman" ) {

      AltKatman( kod: ALT-PNL-TESLIM-INCELEME, ad: "Basamak Teslimleri", departman: inceleme,
        ne: "🔍 Her basamağın kapıdan ve Founder'ın gözünden geçtiği dal" ) {

        Adım( kod: PNL-A15, ad: "Birinci Basamağın Teslimi", durum: beklemede, öncelik: p0, onayBekler: founder,
          bağımlı: [ PNL-A03, PNL-A04, PNL-A05, PNL-A06, PNL-A07, PNL-A14, PNL-A18 ],
          ne: "📦 0.9.196 sürümü: zemin, Ray, Onaylar, hız ve anında sekme geçişi." ) {
          görev: [
            "Sürümü, kilit dosyasını ve değişiklik günlüğünü birlikte 0.9.196'ya ilerlet.",
            "Bütün süitleri, görsel kontrolü ve gerçek VS Code süitini koştur; paketi yalnız üret.",
            "Görsel kontrolün ekran görüntülerini Founder'a göster; onayından sonra paketi kur ve Founder'ın kontrol listesini yürümesini bekle."
          ]
          kabul: [
            "Süitler, görsel kontrol ve gerçek VS Code süiti yeşildir; depo denetimi sıfır hata ve sıfır uyarı verir.",
            "Founder birinci basamağı kendi penceresinde onaylamıştır."
          ]
          sınır: "0.9.195 paketi geri dönüş için diskte saklanır; Founder beğenmezse bu basamağın işlemeleri geri alınır."
        }

        Adım( kod: PNL-A16, ad: "İkinci Basamağın Teslimi", durum: beklemede, öncelik: p1, onayBekler: founder,
          bağımlı: [ PNL-A08, PNL-A09, PNL-A10 ],
          ne: "📦 0.9.197 sürümü: Makinist sayıları, Gözlemler ve Ayarlar." ) {
          görev: [
            "Birinci basamağın teslim yolunu 0.9.197 için yinele."
          ]
          kabul: [
            "Süitler, görsel kontrol ve gerçek VS Code süiti yeşildir.",
            "Founder ikinci basamağı kendi penceresinde onaylamıştır."
          ]
          sınır: "Birinci basamağın davranışı değişmez."
        }

        Adım( kod: PNL-A17, ad: "Üçüncü Basamağın Teslimi", durum: beklemede, öncelik: p1, onayBekler: founder,
          bağımlı: [ PNL-A11, PNL-A12, PNL-A13 ],
          ne: "📦 0.9.198 sürümü: Tren sekmesinin açık yüzü ve kardeş eklenti yuvası." ) {
          görev: [
            "Birinci basamağın teslim yolunu 0.9.198 için yinele; dalın ana gövdeye alınması için PR'ı Founder'a sun."
          ]
          kabul: [
            "Süitler, görsel kontrol ve gerçek VS Code süiti yeşildir.",
            "Founder üçüncü basamağı onaylamış ve birleştirme sözünü vermiştir."
          ]
          sınır: "Birleştirme yalnız Founder'ın sözüyle yapılır."
        }
      }
    }
  }
}

// ── BLK-VITRIN gövdesinin Faz dışı ilanları · eski dosyası is/plan/blok/vitrin_ui.sar (KPS-SIR-A04) ──
// 🍎 VIT-POSTA ve VIT-KIMLIK meyveleri — Adım→kod izi
Kod( kod: KOD-POSTA-GOVDE, dosya: "urun/eklenti/src/onay-govde.ts",
  ne: "🍎 Posta Kutusunun panel içi gövdesi — kapı satırının altında açılan gerekçe kutusu ve onun altındaki üç karar seçeneği. Founder'ın hükmü gereği not artık pencerenin tepesindeki giriş kutusunda değil, gözün olduğu yerde yazılır; ölçüldü ki VS Code'un giriş kutusu yüzeylerinde konum alanı YOKTUR ve ağaç satırı metin alanı barındıramaz, dolayısıyla bu tek yoldu" )
Kod( kod: KOD-POSTA-PANEL, dosya: "urun/eklenti/src/onay-paneli.ts",
  ne: "🍎 Posta Kutusu paneli — Founder onayı bekleyen kapıların kalıcı ağaç görünüşü; kayda tıklanınca kapıya gidilir ve karar akışı açılır" )
Kod( kod: KOD-ONAY-TARAYICI, dosya: "urun/eklenti/src/onay-tarayici.ts",
  ne: "🍎 Onay kapılarının TEK tarayıcısı — hem komut hem panel buradan beslenir; iki tüketicinin farklı sayı üretmesi yapısal olarak imkânsızdır" )
Kod( kod: KOD-SNM-POSTA, dosya: "urun/eklenti/sinama/onay-paneli.test.ts",
  ne: "🍎 Posta Kutusu nöbetleri — tek tarayıcı, simge ayrımı, ata/çocuk kademe farkı, boş kuyruk cümlesi" )
Kod( kod: KOD-DURUM-CUBUGU, dosya: "urun/eklenti/src/durum-cubugu.ts",
  ne: "🍎 Dört yüzeyin durum çubuğu sayaçları — sayılar panellerden TÜRETİLİR, ikinci sayaç tutulmaz" )
Kod( kod: KOD-TEKNOLOJI-SIMGESI, dosya: "urun/eklenti/src/teknoloji-simgesi.ts",
  ne: "🍎 Dosya uzantısı → teknoloji simgesi tek kaynağı — eşleme eklentinin kendi dil ilanından türer, ikinci çizelge doğmaz" )
Kod( kod: KOD-SNM-YUZEYLER, dosya: "urun/eklenti/sinama/tani-yuzeyleri.test.ts",
  ne: "🍎 Tanı yüzeyi nöbetleri — üç panelin kademe düzeni, tür rengi, dosya kademesi, kopyalama ve durum çubuğu sayaçlarının tek kaynaklılığı" )
Kod( kod: KOD-SNM-ONAY-YUZEYLERI, dosya: "urun/eklenti/sinama/onay-yuzeyleri.test.ts",
  ne: "🍎 Onay yüzeyi nöbetleri — açılışta sıfır iş parçacığı, aynı anda tek etkin karar yüzeyi, giriş noktalarının ikinci karar arayüzü açmaması" )
Kod( kod: KOD-GEZINME-CEKIRDEK, dosya: "urun/eklenti/src/gezinme-cekirdek.ts",
  ne: "🍎 Gezinme reddinin saf sebep ölçümü — varlık sınırı, ders dünyası ve tanım yokluğu birbirinden ayrılır; modül süzgecin AYNASIDIR ve ret kurallarını ikinci kez yazmaz" )
Kod( kod: KOD-SNM-ISARET-ENVANTERI, dosya: "urun/eklenti/sinama/arayuz-isareti-envanteri.test.ts",
  ne: "🍎 Arayüz işareti envanteri ve circir nöbeti — yüzey metin kataloğunun tamamı taranır, her sahip takdir yüzeyi, dilin emoji yazımı ve açık borç sınıflarından birine yazılır; yeni emoji girerse ya da kapanan borç kayda geçmezse süit kırmızıya döner" )
Kod( kod: KOD-SNM-GEZINME-REDDI, dosya: "urun/eklenti/sinama/gezinme-reddi.test.ts",
  ne: "🍎 Gezinme reddi nöbetleri — üç sebep üç ayrı cümle üretir, tanımlı kodda ve izsiz sözcede yüzey susar, kabuğun saf kararı gerçekten çağırdığı kaynaktan ölçülür" )
Meyve( kod: TSR-GIYDIRME-KARARI, tür: dış-çıktı,
  ne: "🍎 Giydirme yolunun kararı ve ölçümü — temiz profilde kendiliğinden gelen renk/dekor sayısı önce ve sonra; ayar yazmak yerine ilan etmenin gerekçesi. Türü dış-çıktıdır çünkü bu bir teslim edilebilir hüküm ve ölçüm kaydıdır, proje içi bir dosya değil." )
// KÜRASYON (GOC-A08 · 2026-08-25): ikon konsept galerisi açık depoya girmez; mockup dosya beyanı düşürüldü, aslı atölyededir.
Mockup( kod: TSR-IKON-AILESI,
  ne: "🍎 Simge ailesi galerisi — altı tip ve beş panel için dörder konsept, üç boyutta ve iki zeminde; Founder seçim yüzeyi. Galeri 2026-08-08 tarihinde geneldurum/ altından nitelik rafına taşındı, çünkü ilansız bir klasörde yaşayan karar kanıtını motor göremez ve varlık dışına uzanan işaretçi taşıma anında sessizce kırılır" )

// 🍎 VIT-GRAF ek meyveleri — Adım→kod izi
Kod( kod: KOD-MINIGRAF, dosya: "urun/eklenti/src/minigraf.ts",
  ne: "🍎 Mini graf görünümü (vscode kabuğu) — Yol Haritasının altında tek proje WebviewView'ı; seçim/imleç/yenile akar ama seçim grafı daraltmaz; kip/anahtar yok" )
Kod( kod: KOD-MINIGRAF-CEKIRDEK, dosya: "urun/eklenti/src/minigraf-cekirdek.ts",
  ne: "🍎 Mini graf çekirdeği (SAF — vscode importsuz) — saklı Dag'dan GitLens-benzeri tüm-proje rayı; Faz→Blok→Katman→AltKatman→Adım kapsama bağları + gerçek bağımlılık eğrileri + DIL-4 ikonlu YUZ-4.1 durum renkli buzlu-cam mercek" )
Kod( kod: KOD-SNM-MINIGRAF, dosya: "urun/eklenti/sinama/minigraf.test.ts",
  ne: "🍎 Mini graf davranış sınamaları — beş ray (AltKatman dahil) · tüm proje · seçim işareti · gerçek bağımlılık · YUZ-4.1 türetme · DIL-4 ikon · cam/hover · betiksiz/gradyansız HTML" )

// 🍎 Meyve ilanları (dosya-seviye · MIM-2.1 üretim-yeri)
Kod( kod: KOD-ETKI-YUZ, dosya: "urun/cekirdek/src/etki.ts",
  ne: "🍎 Etki-analizi yüzü — sarmal etki <KOD>: DAG ters-türetmesinden ileri-kapanış (bu düğümü bekleyenler), durum rozetli ağaç render (YUZ-3)" )
Kod( kod: KOD-GRAF-YUZ, dosya: "urun/cekirdek/src/graf.ts",
  ne: "🍎 Kanonik graf yüzü — sarmal graf <dizin> [--kok KOD]: Dag → determinist JSON (düğümler+kenarlar+kopuk+karne); IDE·AI·MCP aynı grafı okur (VIT-GRAF-A01)" )Kod( kod: KOD-SIMGE-CIZELGE, dosya: "urun/eklenti/src/simge-cizelgesi.ts",
  ne: "🍎 Tek kaynak simge çizelgesi — altı eksen tipinin emojisi kanondan, geometrik SVG yolu raftan tek modülde; Mini Graf ile Yol Haritası buradan okur ve ayrışma yapısal olarak imkânsızdır (VIT-KIMLIK-A03)" )
Kod( kod: KOD-SNM-SIMGE-CIZELGE, dosya: "urun/eklenti/sinama/simge-cizelgesi.test.ts",
  ne: "🍎 Kapsam eşitliği nöbeti — SVG rafı ile kanon emoji çizelgesi aynı altı tipi kapsar, kaynaklara renk gömülmez, 38 üretilmiş varyant ve dosya ikonu ilanı diskle birebirdir; mutasyonla kanıtlı (VIT-KIMLIK-A03)" )
Kod( kod: KOD-BAGLANTI-CEKIRDEK, dosya: "urun/eklenti/src/baglanti-cekirdek.ts",
  ne: "🍎 Yol çözümü ve link kararının saf çekirdeği — alan katmanına ek anlatı-içi yol sözceleri; çözülmeyen yol link almaz (VIT-GRAF-A14)" )
Kod( kod: KOD-ATIF-BAGLANTI, dosya: "urun/eklenti/src/atif-baglanti.ts",
  ne: "🍎 Çapraz varlık atıf bağlantısı — dekorla aynı kimlik evreninden beslenir, hedef öbür varlıktaysa salt okunur bakış açar; F12 çözümüne dokunmaz (VIT-GRAF-A14)" )
Kod( kod: KOD-SNM-BAGLANTI-ATIF, dosya: "urun/eklenti/sinama/baglanti-atif.test.ts",
  ne: "🍎 Bağlantı ve atıf nöbetleri — on dört sınama: yol dürüstlüğü, F12 bekçisi, AST hover yedeği ve tanımsız kod bekçisi mutasyon kanıtlı (VIT-GRAF-A14)" )
Kod( kod: KOD-YUZEY-METINLERI, dosya: "urun/eklenti/src/yuzey-metinleri.ts",
  ne: "🍎 Yüzey metin kataloğu — panellerin bütün kullanıcı cümleleri (boş durum, açıklama, ipucu, pano) iki dilde tek dosyada yaşar; üslup siz biçimindedir ve boş durum cümleleri kısa tutulur (Founder hükmü 2026-08-16)" )

// 🍎 VIT-KIMLIK-A04 giydirmesiz renk teslimi (2026-08-08)
//    Üretici teklifi kaldırdı ve rengi iki katmanda ilana çevirdi; iki katman da
//    kullanıcının hiçbir dosyasına yazmaz. Birinci katman anlamsal simgeleri
//    kullanıcının KENDİ temasına bağlar, ikinci katman ise tezgâh renklerini
//    isteyene tema olarak sunar. Tema dosyaları elle yazılmaz; kanondan üretilir
//    ve bir palet nöbeti üreticinin tek bir renk uydurmasını yasaklar.
