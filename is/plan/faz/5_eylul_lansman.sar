    Katman( kod: EKL-F11, takım: TAKIM-EKLENTI, ad: "IDE Aşinalığı",
      ne: "🧭 IDE-aşinalık boşlukları kapanır: kimlik-gezinme ailesi (tanıma-git · referans-bul · F2 · Ctrl+T) + imza-yardımı + tıklanır yollar + kaydette-biçimle — envanterin tek sistematik boşluğu 'koddan koda zıplama' kas hafızasıydı, bu Faz onu kapatır" ) {

      AltKatman(
        kod: ALT-EKL-F11-GEZINME, departman: kodlama,
        ad:  "Kod Gezinme Ailesi",
        ne:  "🧭 Kimlik indeksi üstünde tanıma-git · referans-bul · F2 · Ctrl+T · imza-yardımı · tıklanır yollar kurulur",
      ) {
        Adım( kod: EKL-F11-A01, durum: tamamlandı, bağımlı: [], üretir: KOD-KIMLIK,
          ne:    "🗂️ Kimlik indeksi — çalışma-alanı geneli kod→konum indeksi: her .sar'daki kod: beyanı (tanım) + tüm atıfları (bağımlı: · çağır · metin atıfı) tek haritada; dosya-izleyiciyle taze tutulur; A02–A03'ün ortak temeli — KAPANIŞ 2026-07-11: src/indeks.ts (saf: AST katmanı tanım+yapısal atıf, metin katmanı BÜYÜK-HARF kod deseni — kırık dosyada atıflar yaşar) + eklenti.ts izleyici kancası (artımlı); duman: 155 dosya ilk tarama 180ms, tek-dosya 1.6ms; 11 saf test, süit 103/103; CLI-köprü alternatifi GEREKMEDİ (yerel parse yeterince hızlı)" ) {
          görev: "onbellek.ts üstüne indeks modülü (indeks.ts): açılışta tembel tarama (yalnız .sar dosyaları), FileSystemWatcher ile artımlı güncelleme; kod → { tanımKonumu, atıfKonumları[] } haritası; MIM-1.1 aktif-varlık odağına saygı — indeks varlık-sınırında durur (çapraz-varlık atıf zaten YASAK — STR-3 kesimi). Çekirdek graf çıktısından beslenme (CLI köprüsü) alternatifi uygulamada değerlendirilir, karar rapora işlenir"
          kabul: [
            "_Sarmal ölçeğinde (~390 dosya) ilk tarama hissedilir gecikme yaratmaz",
            "dosya değişince yalnız o dosya yeniden indekslenir (artımlı — testli)",
            "saf birim testleri yeşil (tanım + atıf + silme senaryoları)"
          ]
          sınır: "yalnız indeks altyapısı — kullanıcı yüzü A02–A03'te; çapraz-varlık indeksleme YOK (STR-3.1)"
        }
        Adım( kod: EKL-F11-A02, durum: tamamlandı, bağımlı: [ EKL-F11-A01 ], üretir: KOD-GEZINME,
          takdir: "Gördüm, Cmd+Click ile atıflara zıpladım — çok hoş bir şey. Vay, Allah'ın lütfu işte. (Founder gözle-teyit ✅ 2026-07-11)",
          ne:     "🎯 Tanıma-git + referans-bul — F12 atıftan tanım düğümüne zıplar, ⇧F12 bir kod'un tüm atıflarını listeler (beş ekosistemin ortak kas hafızası — envanter A1+A2) — KAPANIŞ 2026-07-11: src/gezinme.ts (Definition+Reference; kirli-tampon tazelenir; MIM-1.1 varlık süzgeci; tip-tanım vurgusu AD'a hizalı); KANIT = GERÇEK VS Code entegrasyon testi (executeDefinition/ReferenceProvider, kasa 7/7 — Founder güveni + otomasyon kanıtı) + Founder canlı gözle-teyit (Cmd+Click); test iki gerçek kusur da yakaladı: kapsam-dışı açık dosyada F12 ölüydü (tazele artık aktif belgeyi HER ZAMAN indeksler, kapanınca düşer) + referans listesi tanımı da içerir (VS Code davranışı). 'n atıf' lensi ERTELENDİ (takdir lensiyle görsel çakışma — A03 sonrası ayrı karar)" ) {
          görev:  "DefinitionProvider + ReferenceProvider kaydı (eklenti.ts); konum tespiti A01 indeksinden; bonus değerlendirme: takdir lensi deseninde 'n atıf' code-lens'i (envanter A12 kısmen kapanır — karar uygulamada)"
          kabul:  [
            "bağımlı:/çağır atıfında F12 tanım satırına gider (gözle teyit)",
            "kod: üzerinde ⇧F12 tüm atıfları panelde listeler (gözle teyit)",
            "eklenti sınaması yeşil"
