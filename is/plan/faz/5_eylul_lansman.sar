        }
        Adım( kod: BKM-BUG-A07, durum: tamamlandı, üretir: [ KOD-DENETCI ], bağımlı: [],
          ne:    "🔠 harf-farkı sessizliği (B5) — KAPANIŞ 2026-07-11: bastırma yerine KONUMLU harf-farkı HATASI (macOS sessiz/Linux kırık çapraz-platform tuzağı kapandı); ad-ayracı yolu regresyonsuz — plan 'kayit.sar' derken diskte 'Kayit.sar' yaşarsa kayıp-yapı VE bildirilmemiş-dosya bastırılıyor (denetci.ts:215/238 “ad-ayracı yakalar” varsayımıyla) ama o kural .sar dosyalarını kapsamıyor (denetci.ts:285) → macOS'ta sessiz, Linux'ta kırık" ) {
          görev: "Bastırma varsayımı gerçeğe bağlanır: harf-farkıyla eşleşen .sar (ve genel: ad-ayracı kapsamına girmeyen her uzantı) için bastırma yerine `ad-ihlali` ailesinden konumlu tanı üretilir ('diskteki ad ilanla yalnız büyük/küçük harf farklı — çapraz-platform kırılması'). ad-ayracı kuralTanilari kapsam notu güncellenir (M4 beyan eşitlemesiyle koordineli)"
          kabul: [
            "harf-farklı .sar fikstürü tanı alır (macOS'ta da); birebir eşleşen ad susar (testli)",
            "md/yaml/json harf-farkı davranışı (ad-ayracı yolu) regresyonsuz",
            "denetle TAM-yeşil + testler yeşil"
          ]
          sınır: "dosya-adı BİÇİM denetimi (DIL-1.2 snake_case tam kuralı) beklemede kalmaya devam eder — bu Adım yalnız bastırma-deliğini kapatır"
        }
        // MIM-1.7 birleştirmesi (2026-08-28): aşağıdaki Adımlar "dayanıklılık ve demet" kademesinden taşındı.
        //   Taşınan kademenin beyanı: kabuk dayanıklılığı + tek başına Adım açmayacak küçük onarımların demeti
        Adım( kod: BKM-BUG-A08, durum: tamamlandı, üretir: [ KOD-DENETCI ], bağımlı: [],
          ne:    "🧯 muafiyet dayanıklılığı (C1+C2) — KAPANIŞ 2026-07-11: kilitle programlariYukle'ye indi (DRY — muaf+bozuk dosya mühürlemeyi kesmez); muaf+bozuk giriş dosyasında denetle çökmek yerine dürüst tanı + çıkış 2; CLI fikstür testli — kilitle bilerek-hatalı pragmasını tanımıyor (sarmal.ts:899 kendi yükleyicisi; muaf+bozuk dosya mühürlemeyi keser) ve giriş dosyası muaf+bozuksa denetle TypeError ile ÇÖKÜYOR (sarmal.ts:693 non-null)" ) {
          görev: "İki onarım: (1) kilitleKomutu programlariYukle'ye iner (DRY — muaf dosyanın sözdizim hatası mühürlemeyi kesmez, EBEDİ envanteri parse-olanlardan kurulur; muaf+parse-olan zaten envantere girer). (2) denetleKomutu: anaEtiket programlar'da yoksa (muaf+bozuk giriş) çökme yerine konumlu hata tanısı ('giriş dosyası bilerek-hatalı ve ayrıştırılamıyor — denetim yapılamaz', çıkış 2)"
          kabul: [
            "muaf+bozuk sıradan dosya: kilitle mühürler, denetle listeler (iki test)",
            "muaf+bozuk GİRİŞ dosyası: denetle çökmez, dürüst tanıyla çıkar (test)",
            "denetle TAM-yeşil + testler yeşil"
          ]
          sınır: "BILEREK_HATALI semantiği (ilk 5 satır pragması) değişmez — yalnız tüketicilerin dayanıklılığı"
        }
        Adım( kod: BKM-BUG-A09, üretir: [ KOD-DENETCI, KOD-KONI, KOD-DOGRULAYICI ], durum: tamamlandı, bağımlı: [],
          ne:    "🧹 küçük onarım demeti (C3+C4+C5+C6+B7+B8+M4) — KAPANIŞ 2026-07-11: yedi kalemin YEDİSİ kapandı: frontmatter çapası dosya-başına (C3) · ölü türetme dalları silindi (C4) · koni bağımlılık→bağımlı hizası tüm tüketicilerle (C5 — üretilen yüzey yasak alana yönlendirmiyor) · negatif sayıya özel Türkçe hata + DIL-1.3 sınır beyanı (C6) · durum-boyutu harita değerlerini sayar (B7) · yinelenen-kod değer-widget'ları gezer (B8) · ad-ayracı geçiş-dönemi beyanı yasaya yazıldı (M4); kayıtsız kapanma yok — tek başına Adım açmayacak yedi kalem: frontmatter çapası · ölü dal · koni-bağımlılık hizası · negatif sayı mesajı · harita boyut sayımı · değer-widget kod çakışması · ayraç beyan eşitlemesi" ) {
          görev: "Yedi kalem: (1) frontmatterKod çapası dosya-başına (denetci.ts:158 — gövde '---'sı frontmatter sanılmasın); (2) koniAlani ölü referans-türetme dalı silinir (koni.ts:50); (3) koni alanı 'bağımlılık' → 'bağımlı' hizası (koni.ts:18 + iskeletci.ts:163 — üretilen yüzey ORK-1.2 hükmünün YASAKLADIĞI alana yönlendirmesin; KONI_ALANLARI/Koni arayüzü tüketicileriyle birlikte); (4) negatif sayı: unary eksi ya desteklenir ya 'Değer bekleniyordu' mesajına özel öneri ('negatif sayı v1 dışı — …'); (5) durumBoyutDenetle harita değerlerini sayar (dogrulayici.ts:167); (6) yinelenenKodTanilari değer-widget'larını da gezer (denetci.ts:540 — kodIndeksle ile tutarlı); (7) ad-ayracı ile DIL-1.2 geçiş-dönemi toleransı yasada beyanlanır (dil.sar/dizin — motor comment'inden yasa yüzüne)"
          kabul: [
            "yedi kalemin her biri fikstürlü testle kapanır ya da gerekçeli ertelenir (STR-2.1 — kayıtsız kapanma yok)",
            "koni/iskelet çıktısı artık 'bağımlılık' başlığı üretmez; mevcut tüketiciler (sef prompt) regresyonsuz",
            "denetle TAM-yeşil + çekirdek+eklenti testleri yeşil"
          ]
          sınır: "her kalem KÜÇÜK kalır — kapsam büyüyen kalem demetten çıkar, kendi Adım'ını açar (Superpowers boyut-normu ruhu)"
        }
        Adım( kod: BKM-BUG-A10, durum: tamamlandı, üretir: [ KOD-BUGAVI-DEFTER ], bağımlı: [],
          ne:    "🔭 kalan-yüzey taraması — KAPANIŞ 2026-07-11: 19 çekirdek + 23 eklenti dosyası iki kademeli derinlikle tarandı (TAM okuma + HIZLI kök-desen grep; üç-durum tablosu defter EK bölümünde); çekirdek artığı 14/19 tam-temiz, 5 E-bulgusu çıktı ve HEPSİ koni-dolu BKM-BUG-A11'e bağlandı — kör nokta sıfır" ) {
          görev: "Kalan ~15 çekirdek modülü + eklenti src (23 dosya) aynı üç kapsamla taranır: beyan↔kod mutabakatı (özellikle mcp araç açıklamaları — sinav2 A7 ailesi), parametre/özellik + skaler/liste ikilik körlükleri (bu turun kök-deseni checklist olarak uygulanır), kabuk dayanıklılığı. Bulgular bu deftere EK bölüm olarak işlenir; iş çıkarsa demet ya da yeni Adım"
          kabul: [
            "kalan modül listesi %100 işaretli (okundu/bulgu-var/temiz üç-durum tablosu deftere ek)",
            "çıkan her bulgu ya kapatıldı ya koni-dolu Adım'a bağlandı (kör nokta sıfır)",
            "denetle TAM-yeşil + testler yeşil"
          ]
          sınır: "tarama turu — büyük refaktör açılmaz; STR-3 çizgisi: kapalı taraf (kapalı varlık) bu taramanın dışında"
        }
        Adım( kod: BKM-BUG-A11, durum: tamamlandı, üretir: [ KOD-EKL-EKLENTI ], bağımlı: [],
          ne: "🩹 A10 bulgu demeti (E1-E5) — KAPANIŞ 2026-07-12 (Founder gözle teyidi 0.9.41'de: panel rozet/renk + tanı-düzey renkleri + takdir satırı doğru — 'A11 tamam'): beş kalemin BEŞİ kodlandı — E1 üç eklenti yüzeyi parametre∪özellik · E2 MCP örtü-farkında (dizin argümanı + uçtan-uca fikstürlü test) · E3 köprü güvenlik-rol kalıbı + denetim-ailesi RBAC ağı · E4 prizma tırnaklı-kod kimliği (testli) · E5 düzey eşlemesi + 3 yeni panel bekçisi + nitelik/kapi_kapsami.sar sözleşmesi; eklenti 0.9.39→0.9.41 zinciri + CHANGELOG" ) {
          görev: """
          Beş kalem: (1-E1) eklenti yolharitasi.parametre()/takdir/anahat alan okumaları parametre∪özellik
          olur (motor alanDeger dersi — gövde-durumlu Adım panelde/geribildirimde doğru görünsün; eklenti
          sürüm + kasa + gözle teyit). (2-E2) MCP denetle örtü-farkındalığı: yol verildiğinde dirname'den
          find-up örtü; kaynak-only için opsiyonel dizin argümanı; kanon-cache kararı (taze-okuma mı
          süreç-cache mi) beyanlanır. (3-E3) nvidia sistemPrompt güvenlik rolüne kendi kalıbını verir
          (bulgular/kategoriRaporu alanları + rol='güvenlik'). (4-E4) prizma düğümYalın tırnaklı kod:
          değerini de kimlik sayar (kodIndeksle ile tutarlı). (5-E5) eklenti cross-file tanılarında düzey
          eşlemesi (Error sabiti kalkar — bilgi/uyarı doğru renkte) + kapı-kapsamı beyanı: hangi bekçi
          hangi yüzeyde (CLI-kapı / eklenti-panel / MCP) tek tabloda; eksikler ya eklenir ya gerekçeli
          beyan edilir (KRR-MUT-2)
          """
          kabul: [
            "gövde-özellikli durum/ne fikstürü: panel rozeti + takdir + anahat doğru (eklenti kasası + gözle teyit)",
            "örtülü çalışma-alanında MCP denetle sahte geçersiz-enum üretmez (fikstürlü test)",
            "cross-file tanılar panelde kendi düzeyiyle görünür; kapı-kapsam tablosu yazıldı — denetle TAM-yeşil + iki süit yeşil"
          ]
          sınır: "beş kalem KÜÇÜK kalır (A09 demet ilkesi); eklenti kapısına yeni bekçi EKLEME kararları tabloda gerekçeli beyanla ertelenebilir — sessiz eksik kalmaz"
        }
        Adım( kod: BKM-BUG-A12, ad: "Adlı Kuralın Dayanak Bağı", durum: tamamlandı, öncelik: p1, üretir: [ KOD-DENETCI ], bağımlı: [],
          ne: "🔗 uygulanmamış-karar bekçisi (YAS-2.1) adlı biçimde yazılmış Kural düğümlerinin dayanak bağını saymıyor; kararları kurala inmiş bir projede bile kilitli ve uygulama: gerekli beyanlı her karar için sahte uyarı düşüyor" ) {
          görev: """
          2026-10-03 (oturum 113) gözlemi: kararlar dosyası ile anayasa dosyası ayrı yaşayan bir projede
          on bir kilitli karar `uygulanmamış-karar` uyarısı aldı. Oysa anayasadaki on altı Kural düğümü
          `dayanak:` alanıyla bu kararların hepsini gösteriyor. Bekçinin kendi yorumu (denetci.ts YAS-2.1,
          kural ②) Karar dışındaki her düğümün dayanak, uygular ve referans alanını ters bağ saymayı
          vaat ediyor; fakat Kural düğümleri `Kural adı( … )` biçiminde adlı yazıldığı için gezinti onları
          büyük ihtimalle görmüyor. Önce başarısız bir fikstür testi yaz: adlı biçimde ve adsız biçimde
          yazılmış birer Kural düğümü aynı kilitli karara dayanak versin; ikisi de kararı inmiş saydırmalı.
          Sonra sebebi doğrula ve bekçinin gezintisini adlı bildirimleri kapsayacak biçimde onar. Bu kusur
          haftalarca bilinen motor kusuru denip plana indirilmemişti; kapanışta aynı desenin başka
          bekçilerde (ters bağ toplayan öteki gezintiler) yinelenip yinelenmediği de taranır
          """
          kabul: [
            "adlı ve adsız biçimde yazılmış Kural düğümlerinin dayanak bağı kararı inmiş saydırıyor (fikstürlü test önce kırmızı, sonra yeşil)",
            "bağı hiçbir düğümde bulunmayan kilitli ve uygulama: gerekli beyanlı karar uyarı almaya devam ediyor (regresyon testi)",
            "aynı adlı-bildirim körlüğünün öteki ters bağ toplayıcılarında olup olmadığı taranmış ve sonucu kapanış özetinde yazılı",
            "kendi deposunda ve kapsanan projelerde denetim uyarı sayısı bu kusurdan doğan uyarılar kadar düşmüş; test süitleri yeşil"
          ]
          sınır: "Bekçinin hükmü değişmez: yalnız kilitli ve uygulama: gerekli beyanlı karar konuşur; tanının düzeyi ve metni değiştirilmez, yalnız ters bağ toplama onarılır"
          koşu:  Koşum( kod: KSM-BKM-BUG-A12, tarih: 2026-10-10, mühür: COMPLETED,
            kanıt: "işleme 268b7fd · çekirdek 1666/1666, eklenti 865 geçti 6 atlandı 0 başarısız · depo denetimi 0 hata · bağımsız inceleme: onarımsız motorda yeni test kırmızı (2 uyarı, beklenen 1), onarımlı motorda yeşil; kapsanan projenin kopyasına eklenen bağsız gerekli karar hâlâ uyarı aldı · kapsanan kapalı projede uygulanmamış-karar uyarısı 11'den 0'a indi ve on bir gerekli kararın her biri en az bir adlı Kuralın dayanağıyla bağlı ölçüldü; öteki kapsanan projelerde sayılar değişmedi. KÖK NEDEN: `Kural ad( … )` biçimi ayrıştırıcıda kuralTanım türüne düşer, toplayıcı ise yalnız widget türünü geziyordu. ADSIZ BİÇİM: dil `Kural( … )` biçimini kabul etmez; adsız karşılık widget biçimli GenelKural'dır ve zaten sayılıyordu. TARAMA SONUCU: dayanaksizKararlar, dayanak haritası nöbeti, dag.ts dayanak kenarı, kimlik.ts giden kenar toplayıcısı, dogrulayici ve kanon-tutarlilik kuralTanım türünü zaten kapsar; referansTanilari adlı Kuralı yorumla gerekçelendirerek dışlar. Aynı körlük stratejiTanilari içindeki ölü-iz toplayıcısında bulunmuştur (emekli karara adlı Kuralla bağlanan dayanak uyarı üretmez); bu kaçan uyarı HST-MTR-A09 Adımına indirilmiştir.",
            ne:    "uygulanmamış-karar bekçisinin ters bağ toplayıcısı Karar dışındaki her düğüm türünü ve parametre değerine gömülü widget'ları gezer hâle geldi; adlı Kuralın dayanağı artık kararı inmiş saydırır, bekçinin hükmü, düzeyi ve metni değişmedi. Aynı körlük ölü-iz toplayıcısında ayrı bir Adıma bağlandı." )
        }
      }


    }

    // ══ KATMAN · EKLENTİ DENETİM TURU (2026-08-28): dört salt-okur ölçüm, yirmi bulgu ═
    // Founder kapsamlı bir eklenti denetimi istedi ve bulguların önce plana inmesine,
    // sonra ayrı bir oturumda tek tek ele alınmasına hükmetti. Dört ölçüm koştu: kanon
    // uyumu (kontrolcü, ajansız), süit dürüstlüğü, vaat ile gerçeğin farkı ve kapı
    // kapsamı ilanı (üçü salt-okur ajan). Bu Katman o turun bulgu rayıdır; hiçbir bulgu
    // bu turda onarılmamıştır (gözlem turu kuralı). Bulgular üç kabul kapısına ayrılır:
    // Founder kararı isteyenler planlama, kod onarımları kodlama, nöbet onarımları
    // sınama kademesindedir. Tur boyunca ölçülüp TEMİZ çıkan alanlar ayrıca kayda
    // geçmiştir, çünkü sessizlik kanıt değildir: on dokuz komutun on dokuzu kayıtlı,
    // altı panelin altısı canlı, elli altı kaynak dosyasının tamamı ilanlı, doksan
    // yerelleştirme anahtarının tamamı iki dilde karşılıklı, eklentide düzeyi yeniden
    // yazan ya da kimlikle süzen tek bir yol yok, otuz beş kullanıcı bildiriminin otuz
    // beşi katalogdan, kapsama ve yüzey ayırma işlevleri mutasyona dayanıklı.
    Katman( kod: BKM-DNT, takım: [ TAKIM-CEKIRDEK, TAKIM-EKLENTI ], ad: "Eklenti Denetim Turu",
      ne: "🔍 Eklentinin dört eksende ölçülen bulguları: kanon ile ilanın ayrışması, vaat edilip görünmeyen yüzeyler, davranışı korunmayan kaynak yarısı ve kendi kanıtını yok eden nöbet" ) {

      AltKatman( kod: BKM-DNT-K1, departman: planlama, ad: "Kapsam Kararları",
        ne: "⚖️ Motorun değil Founder'ın verebileceği kararlar: hangi tanının hangi yüzeyde görüneceği ve kaydın gerçeği nasıl söyleyeceği" ) {

        Adım( kod: BKM-DNT-A01, ad: "Tanının Panele Ulaşması", durum: tamamlandı, öncelik: p1, bağımlı: [], referans: [ YUZ-3.3, YUZ-3.1, HTR-PANEL-KOR-NOKTASI-COK-KOKLU-PENCERE, HTR-README-ORNEK-TANILARI-PANELDE-YOK ],
          onay: "yön kanonda zaten kararlaştırılmıştır — 2026-09-09 · Founder, bir tanıyı hem ajanın hem insanın aynı anda görmesi gerektiğini hatırlatmış ve bunun yeni bir karar değil Sarmal'ın değişmez ilkelerinden biri olduğunu, kararın çok önceden verildiğini bildirmiştir. Kaynaktan doğrulanmıştır ve ilke kanonda iki maddede yaşamaktadır. YUZ-3.1 her görünür ihlalin Problems, hover, komut satırı ve satır yüzlerinden uygulanabilenlerin TÜMÜNDE aynı kod, düzey ve yönlendirmeyle sunulmasını, hiçbir yüzün tanıyı yeniden derecelendirememesini ya da GİZLEYEMEMESİNİ hükme bağlamaktadır. YUZ-3.3 ise hata ve uyarı düzeyli driftin Problems yüzeyine, yalnız bilgi düzeyli ölçüm ile durum işaretlerinin Bildirimler yüzeyine gitmesini hükme bağlamaktadır. Bu iki madde birlikte okunduğunda bu Adımın yönü tektir ve iki yönlü bir seçim yoktur: kapı kapsamı ilanı kanona uydurulur, kanon ilana uydurulmaz. Ölçülen ihlalin büyüklüğü şudur: altmış bir üreticinin otuz dokuzu yalnız komut satırındadır ve bunların altısı hata düzeyinde tanı basmaktadır; hata basan altı üreticinin panelden düşmesi YUZ-3.1'in gizleme yasağının doğrudan ihlalidir. Uyarı düzeyi de aynı hükme girmektedir, çünkü YUZ-3.3 uyarıyı hata ile aynı yüzeye yollamaktadır; dolayısıyla ilanda yalnız bilgi düzeyinde konuşan üreticiler komut satırında kalabilir ve bu ayrım ölçülerek çıkarılır. Adımın gövde metni kanon ile ilan arasında iki yönlü bir müzakere varmış gibi yazılmıştır; bu çerçeve yanlıştır ve aynı turda düzeltilir.",
          // ── 2026-09-10 · KADEME ÖLÇÜMÜ VE PANEL BEDELİ (üretici ölçümü) ──
          //   Ölçüm üreticilerin KENDİ gövdelerinden yapıldı: her üreticinin bastığı
          //   tanı kimlikleri kaynaktan çıkarıldı, `yeniTani` kimlikleri sicilin terfi
          //   kademesinden, `eskiTani` çağrıları ise düzey argümanından okundu.
          //   Yardımcıya devreden dört üretici (beyansizYapiTanilari · metinAtifTanilari ·
          //   dosyalararasiCatismaTanilari · ilansizGovdeDenetle) tek tek kaynaktan
          //   doğrulandı, çünkü geçişli tarama paylaşılan yardımcılar üstünden kirlenip
          //   yalnız bilgi basan üreticileri hata gibi gösteriyordu.
          //
          //   ÖNCEKİ HÂL: 61 ilan girdisi · 22 panelli · 39 yalnız komut satırında.
          //   Yalnız komut satırındaki 39 girdinin 30'u hata ya da uyarı düzeyinde
          //   konuşuyordu (18 hata · 12 uyarı) ve YUZ-3.1'in gizleme yasağını çiğniyordu.
          //   Adımın gövdesindeki ön ölçüm hata basan üretici sayısını altı olarak
          //   yazmıştı; bağımsız sayım bu rakamın üç katından fazlasını göstermiştir.
          //
          //   BUGÜNKÜ HÂL: 61 girdi · 52 panelli · 9 yalnız komut satırında; dokuzunun
          //   dokuzu da YALNIZ bilgi düzeyinde konuşur ve dokuzu da gerekçe cümlesi
          //   taşır. Hata ya da uyarı basıp panele ulaşamayan üretici sayısı SIFIRDIR.
          //
          //   PANEL BEDELİ: panel turu `denetimKos` TAM akışını zaten koşmaktadır ve
          //   ilan yalnız hangi tanının Problems yüzeyine geçeceğini süzmektedir.
          //   Ölçüm bunu doğrulamıştır: eski ilanla tur 469 ms, yeni ilanla 428 ms
          //   sürmüştür ve aradaki fark ölçüm gürültüsüdür, çünkü motor iki hâlde de
          //   aynı üreticileri koşturur. Değişen tek şey panele GEÇEN tanı sayısıdır:
          //   bu depoda 1 iken 52 olmuştur. Kararın motor maliyeti sıfırdır; artan şey
          //   yalnız gösterimdir ve gösterim maliyeti panel kipiyle çözülür.
          //
          // ── 2026-09-09 · CANLI KANIT (kontrolcü ölçümü, oturum içinde üretildi) ──
          //   Founder plan dosyasına bir düğüm yazdı, komut satırı denetimi bir uyarı
          //   verdi ve editörün Sorunlar paneli aynı anda "Çalışma alanında sorun
          //   algılanmadı" dedi; Founder bunu kendi penceresinde görüp bildirdi.
          //   Uyarı `kırık-referans` idi ve onu üreten `referansTanilari` bu ilanda
          //   yalnız komut satırına ayrılmıştır. Aynı turda `geçersiz-enum` tanısı
          //   panele ULAŞTI, dolayısıyla körlük tanı ailesine göre değişmektedir ve
          //   kullanıcı hangi ailenin görüneceğini hiçbir yüzeyden okuyamaz.
          //   Kapsam ölçümü aynı gün yenilendi: ilanda altmış bir üretici vardır,
          //   otuz dokuzu YALNIZ komut satırındadır ve yirmi ikisi panele ulaşır.
          //   Otuz dokuzun içinde bugün iki ayrı olayın sebebi olan iki üretici
          //   birden durmaktadır: `anadizinSekliTanilari` (yeni bir ağaç yanlış
          //   kurulduğunda hata düzeyinde konuşan bekçi) ve `referansTanilari`.
          //   Yani Founder'ın yanlış ağacın üstüne inşa etmesinin ve plandaki
          //   hatayı anlık yakalayamamasının kaynağı bu ilanın kendisidir.
          //
          //   KONTROLCÜNÜN ÖN ÖLÇÜMÜ YANLIŞ ÇIKTI — düzeltme kayda geçer. Kontrolcü
          //   otuz dokuz üreticinin yalnız ALTISININ hata bastığını yazmış ve bunu
          //   kaynak taramasıyla çıkarılmış bir ön ölçüm olarak, bağımsız doğrulama
          //   şartıyla beyan etmişti. Doğrulama üretici tarafından yapılmış ve sayı
          //   üç kattan fazla çıkmıştır: yalnız komut satırındaki otuz dokuz girdinin
          //   OTUZU hata ya da uyarı basmaktadır, yani on sekizi hata ve on ikisi
          //   uyarıdır. Kontrolcünün taraması üretici işlevlerinin gövdesini kaba bir
          //   düzenli ifadeyle bölmüş ve dolaylı çağrıyla üretilen tanıları saymamıştı.
          //   Ders tek cümledir: ön ölçüm karar hazırlar, hüküm vermez; bu ayrımı
          //   yazmak ölçümü yanlış olmaktan kurtarmaz, yalnız yanlışı yakalanabilir
          //   kılar. YUZ-3.3 uyarıyı hata ile aynı yüzeye yolladığı için otuzun
          //   tamamı panele taşınmıştır.
          üretir: [ KOD-KAPI-KAPSAMI ],
          ne: "⚖️ Kırk üreticinin yüzey kararının Founder hükmüyle verilmesi. Kapı kapsamı ilanı altmış bir üreticinin kırkını yalnız komut satırına ayırmaktadır ve bu kırk satırın otuz yedisi hiçbir gerekçe taşımaz; blok yorumu kararı açıklamak yerine kararın o Adımda ele alınmadığını yazar. Kaydın kendisi (`is/nitelik/kapi_kapsami.sar`) ve KYN-MTR-A05 Adımının sınır alanı yüzey kararının Founder hükmü olduğunu söyler, fakat o hüküm hiç verilmemiş ve hiçbir halef Adıma bağlanmamıştır; kırk satır bilinçli bir kararın kaydı değil, verilmemiş bir kararın bugünkü fotoğrafıdır. Ölçüm ağırdır: on beş üreticinin ürettiği elli dokuz tanı kimliği için kanon maddesinin zorlama satırı Problems ya da Bildirimler yüzeyi isterken ilan yalnız komut satırı der; aralarında hata düzeyinde olanlar (kimlik omurgası, mühür kırılması, ebedî kural silinmesi) ve panel yüzeyi hükmünün bekçisi olan YUZ maddelerinin kendi tanıları da vardır. Sicildeki yüz yetmiş beş kimliğin seksen dördü bugün panele yapısal olarak ulaşamamaktadır. Bu Adım kırk satırın her biri için karar verir: ya ilan kanona çekilir ya da kanon maddesinin yüzey cümlesi Founder kapısından değiştirilir; üçüncü bir yol yoktur, çünkü kanon ile motorun ayrışması aracın sattığı güvencenin merkezindedir." ) {
          görev: [
            "İlanı kanona uydur: hata ya da uyarı düzeyinde tanı basan her üretici panel yüzeyine de yazılır, çünkü YUZ-3.3 iki kademeyi de Problems yüzeyine yollamakta ve YUZ-3.1 hiçbir yüzün tanıyı gizlemesine izin vermemektedir. Yön tektir ve kanon maddesi bu Adımda değiştirilmez.",
            "Hangi üreticinin hangi kademede konuştuğunu üreticinin kendi gövdesinden ölç ve listeyi kayda yaz: yalnız bilgi düzeyinde konuşan üreticiler komut satırında kalabilir ve kalma gerekçesi ilan satırının üstüne yazılır. Ön ölçüm altmış bir üreticinin otuz dokuzunun yalnız komut satırında olduğunu ve bunlardan altısının hata bastığını göstermiştir; kesin sayım bu Adımda bağımsız olarak yenilenir.",
            "Kanonun yüzey beyanı taşımadığı üreticiler için beyanı kanondan türet: tanının kademesi hangi yüzeyi gerektiriyorsa o yazılır; beyansız üretici için Founder'a soru taşınmaz, çünkü kural kademeyi zaten yüzeye bağlamaktadır.",
            "Panelin performans bedelini ölç ve kayda yaz: taşınan üreticilerin panel turuna eklediği süre, panel kipi ölçümünün taban sayılarıyla karşılaştırmalı olarak verilir. Bedel ölçülür fakat hükmü değiştirmez; hüküm kanondadır ve maliyet panel kipiyle çözülür.",
            "Kanon ile ilanın uyumunu ölçen genel nöbet kurulur (BKM-DNT-A11) ve bu kez ayrışmanın gerçek hâlini görecek biçimde kurulur: bir üreticinin bir yüzeyde farklı görünmesi kadar, o yüzeyde HİÇ görünmemesi de ayrışmadır. Bugün ilan edilmiş iki nöbetin neden ateşlemediği 2026-09-09 tarihinde kaynaktan ölçülmüştür ve sebep üç katmanlıdır. BİRİNCİSİ, iki nöbet de yalnız o koşuda FİİLEN ÜRETİLMİŞ tanıların üzerinde dönmektedir; birincisi üretilen tanının düzeyini sicildeki kademeyle ve aynı koşudaki öteki düzeylerle karşılaştırmakta, ikincisi üretilen tanının yönlendirildiği yüzeyi beklenen yüzeyle karşılaştırmaktadır. Panelde hiç koşmayan bir üretici hiçbir tanı üretmez, dolayısıyla iki kümeye de hiç girmez; nöbetler yapısal olarak yalnız FARKLI GÖRÜNME hâlini görür ve HİÇ GÖRÜNMEME hâlini göremez. İKİNCİSİ, ikinci nöbet yönlendirme tablosu verilmediğinde tümüyle susmaktadır ve kodun kendi gerekçesi bunu yapılmamış bir yönlendirmenin bozulmuş sayılamayacağı biçiminde yazmaktadır; gerekçe makuldür fakat sonucu sessizliktir. ÜÇÜNCÜSÜ, nöbetin kendisi panel yüzeyine çıkmamaktadır ve bunu kapı kapsamı ilanının kendi yorum satırı yazmaktadır; yani bir tanının bir yüzeye ulaşmadığını bildirecek bekçi tam da o yüzeye kendisi ulaşamamaktadır. Onarım bu üç katmanı birden kapatır: nöbet ÜRETİLEN tanılar kümesini değil İLAN EDİLEN üretici kümesini taban alır ve bir üreticinin kanonun gerektirdiği yüzeyde ilan edilmemiş olmasını başlı başına ayrışma sayar; yönlendirme tablosu verilmediğinde susmak yerine tablonun yokluğunu bildirir; ve nöbet kendi hükmü gereği panel yüzeyine çıkar."
          ]
          kabul: [
            "Yalnız komut satırında kalan her ilan girdisi bir gerekçe cümlesi taşır ve gerekçesiz girdi sayısı sıfırdır.",
            "Hata ya da uyarı düzeyinde tanı basıp panele ulaşamayan üretici sayısı SIFIRDIR; bu sayı üreticilerin kendi gövdelerinden bağımsız olarak ölçülmüş ve kayda yazılmıştır.",
            "Komut satırında kalan üreticilerin tamamı yalnız bilgi düzeyinde konuşmaktadır ve bu da aynı ölçümle gösterilmiştir.",
            "Kanon maddesi bu Adımda değiştirilmemiştir; ayrışma yalnız ilan tarafında kapanmıştır.",
            "Panelin ölçülen performans bedeli kayıttadır ve panel kipi taban sayılarıyla karşılaştırılmıştır.",
            "Bir üreticinin bir yüzeyde hiç görünmemesi hâlini gören nöbet canlıdır; bu, bir üreticiyi geçici olarak ilandan düşürüp nöbetin kırmızıya döndüğü gösterilerek kanıtlanmıştır."
          ]
          sınır: "Bu Adım hiçbir kanon maddesini değiştirmez; ayrışma yalnız ilan tarafında kapatılır. Bu cümlenin önceki hâli Adımın kendi onay alanıyla çelişiyordu ve 2026-09-10 tarihinde düzeltilmiştir: eski metin Adımın hiçbir üreticiye panel yüzeyi eklemeyeceğini, yalnız kararları toplayacağını yazıyordu, oysa onay alanı yönün Founder hükmüyle kapandığını ve ilanın kanona uydurulacağını bildirmektedir. İki yönlü müzakere çerçevesi yanlıştı ve onay alanı onun aynı turda düzeltileceğini zaten yazmıştır. Kapsam dışı kalan tek kalem şudur: kanon uyum nöbetinin kendi tanısını panel yüzeyine basması bir tanı kimliği ile ona karşılık gelen kanon maddesini gerektirir, dolayısıyla kanona dokunmayı yasaklayan bu sınırın dışındadır ve ayrı bir Adımın işidir. Ateşlemiş hatırlatıcı (2026-08-28) ve önceliksiz Adım (BKM-DNT-A04) kararları bu Adımdan önce verilmiştir, çünkü kanon o ikisi için Bildirimler yüzeyini açıkça yazmaktadır."
          koşu: "2026-09-10 · KAPANDI. İlan kanona uyduruldu ve ayrışma tek yönde kapandı: altmış bir girdinin panele ulaşanı yirmi ikiden elli ikiye çıktı, yalnız komut satırında kalan dokuz girdinin dokuzu da yalnız bilgi düzeyinde konuşmakta ve her biri gerekçe cümlesi taşımaktadır; hata ya da uyarı basıp panele ulaşamayan üretici sayısı sıfırdır. Bu deponun kendi koşusunda panele geçen tanı sayısı birden elli ikiye çıkmıştır ve motorun maliyeti değişmemiştir, çünkü denetim aynı üreticileri iki hâlde de koşturmaktadır. Bağımsız kabul denetimi kontrolcü tarafından koşuldu: iki tür denetimi sıfır hata, proje denetimi sıfır hata ile sıfır uyarı, çekirdek süiti bin iki yüz altmış ikide bin iki yüz altmış iki, eklenti süiti altı yüz doksan yedide altı yüz doksan yedi; kontrolcü ayrıca kendi mutasyonunu koşturdu ve atıf üreticisini panelden düşürdüğünde on beş nöbetin altısı kırmızıya döndü, kaynak birebir geri konduğunda on beşi de yeşile döndü. Kontrolcünün ön ölçümü yanlış çıkmış ve düzeltilmiştir: hata basan üretici sayısı altı değil, hata ile uyarı basan girdi sayısı otuzdur. Kapsam dışı kalan tek kalem kanon uyum nöbetinin kendi tanısını panele basmasıdır ve o iş kanon maddesi gerektirdiği için ayrı bir Adımı bekler."
          dokunulmaz: [ "Kapsam nöbetinin ad kümesi eşitliği sözleşmesi", "Panel süzgecinin üretici damgasıyla süzme mekanizması" ]
        }

        Adım( kod: BKM-DNT-A02, durum: tamamlandı, öncelik: p2, bağımlı: [ BKM-DNT-A01 ], referans: [ YUZ-3.3, YUZ-7 ],
          üretir: [ VR-GOC-YUZEY-YONLENDIRME, KOD-YUZEY-ULASMA, KOD-SNM-YUZEY-ULASMA ],
          ne: "📋 Yönlendirme matrisi kaydının yönlendirme ile ulaşmayı ayırması. Kayıt bugün sicilin tamamını üç yüzeye dağıtır ve her kaydın tam olarak bir yüzeye ulaştığını yazar; oysa ölçüm yüz yetmiş beş kimliğin seksen dördünün hiçbir yüzeye ulaşmadığını göstermiştir. Kaydın cümlesi yönlendirme için doğru, ulaşma için yanlıştır ve aradaki farkı hiçbir yerde konuşmaz. Ayrıca kaydın makine-okur Çıkarım düğümü yüz yetmiş bir kimlik ve yirmi dört Bildirimler derken çizelgesi yüz yetmiş beş ve yirmi sekiz der; düzyazısı önceki gövdeyi yüz iki sayarken çizelge yüz bir sayar. Aynı dosyada iki toplam yaşamaktadır ve kaydın kendi uyarısında önceden ilan ettiği sessiz bayatlama gerçekleşmiştir. Bu Adım, kaydın yönlendirme ile ulaşma sütunlarını ayırır, sayılarını canlı sicilden üretir ve iki sütunun eşitsizliğini nöbete bağlar." ) {
          görev: [
            "Kayda 'ulaşır' sütunu ekle: her kimlik için yönlendirildiği yüzey ile üreticisinin ilanındaki yüzeylerin kesişimi yazılır; boş kesişim 'ulaşmaz' olarak görünür.",
            "Çıkarım düğümünün ve düzyazının sayılarını çizelgeyle eşitle ve üçünü de tek üreticiden türet; elle yazılan sayı kalmaz.",
            "Nöbeti kaydın toplamını değil, yönlendirme ile ulaşma arasındaki farkı ölçecek biçimde genişlet; fark BKM-DNT-A01 sonrası sıfıra inmelidir ve inmezse kalanlar gerekçeli olarak listelenir."
          ]
          kabul: [
            "Kayıtta yönlendirilen ve ulaşan yüzey ayrı sütunlarda okunur ve ikisi de canlı sicilden üretilmiştir.",
            "Kaydın üç sayı kaynağı (Çıkarım düğümü, düzyazı, çizelge) aynı toplamı söyler ve bir nöbet bunu ölçer."
          ]
          sınır: "KYN-YUZ-A02 Adımı bu kaydın bayat sayılarını zaten gerçeğe çekmektedir; bu Adım o düzeltmeyi yinelemez, yalnız ulaşma sütununu ve fark nöbetini ekler. Sıra bağımlılığı gerçektir: ulaşma sütunu BKM-DNT-A01 kararlarından önce doldurulursa seksen dört satır 'ulaşmaz' der ve karar verilince yeniden yazılır."
          koşu: "2026-09-10 · KAPANDI. Kaydın üç sayı kaynağı gerçekten ayrışmıştı ve üçü de farklı şey söylüyordu: bir yer yüz yetmiş bir kimlik derken çizelge yüz yetmiş beş diyordu, düzyazı ise önceki gövdeyi iki yerde yüz iki sayıyordu, oysa gerçeği yüz birdi. Üçü de tek üretece bağlandı ve toplamın sicil boyutunu vermesi yapısal olarak zorunlu hâle geldi. Yönlendirme ile ULAŞMA ayrı çizelgeye çıkarıldı, çünkü bir tanının bir yüzeye yönlendirilmiş olması o yüzeye ulaştığı anlamına gelmiyordu. Kayıttaki kademe dağılımı da elle doğrulanmaktan çıkıp motor kaynağından ölçülür oldu ve eski dağılımın hem bayat hem yanlış taban üzerinden yazıldığı görüldü."
        }

        Adım( kod: BKM-DNT-A03, durum: geliştirmede, onay: "onaylandı — 2026-10-10 · ŞERH 2026-10-10 · FOUNDER (karar sayfası): Founder, bir dosyanın planda kaç Kod ilanı taşıyabileceğine hükmetmiştir: her dosyanın tek canlı Kod düğümü olur; kapanmış Adımların üretir listesindeki satır içi ilanlar tarih kaydı sayılır ve nöbet onları canlı çiftlere katmadan ayrıca bilgi olarak gösterir. Gerekçe, gezinme ve etki araçlarının bir dosya için tek düğüm göstermesi, tarih kaydının yeniden yazılmadan korunması ve yüzey metinleri dosyasındaki 16 Ağustos üslup hükmünün aranabilir bir alana dönmesidir. Bu Adım yüzey metinleri dosyasının canlı kimliğini geri getirir; kalan on yedi çiftin canlı kimliğe taşınması ve nöbetin kapıya bağlanması BKM-DNT-A17'de, MIM-2 cümlesinin bu modele göre netleşmesi HST-MTR-A18'dedir.", öncelik: p3, bağımlı: [], referans: [ MIM-2, MIM-3 ],
          üretir: [ KOD-DENETCI ],
          // ── 2026-09-10 · GÖZLEM: geçici fikstür ortak kapıyı kırmızıya çeviriyor ──
          //   Kontrolcü bu tarihte kapının kırmızı yandığını ve yazımının engellendiğini
          //   bildirmiştir; sebep `ogreti/ornek/altin_yol/_ta04-nobet.sar` dosyasıdır.
          //   Ölçüm dosyanın sahibini bulmuştur: gerçek kabuk süitindeki tek-ağaç nöbeti
          //   (urun/eklenti/sinama_vscode/suite/tek-agac.test.ts, `geciciSar`) fikstürü
          //   koşum boyunca DEPO AĞACININ İÇİNE yazar ve süit bitince siler. Dosya
          //   yalnız o bir dakika boyunca yaşar, fakat o pencerede aynı ağaçta çalışan
          //   herkesin denetimi yedi hata bildirir (fazsız-blok · proje-köksüz-üretim),
          //   çünkü kanca o klasörü ayrı bir varlık kökü sayar.
          //   ÖNEMLİ AYRIM: fikstürü depo dışına taşımak ÇÖZÜM DEĞİLDİR ve nöbeti
          //   bozar. Nöbetin kendi yorumu sebebini yazmaktadır: tur daraltması ancak
          //   odaktaki varlık çalışma alanı kökünün ALTINDA bir kökse yapılır,
          //   dolayısıyla fikstür tanımı gereği ağacın içinde olmak zorundadır.
          //   Kapının bu dosyayı ayırt edememesi asıl kusurdur: alt çizgiyle başlayan
          //   ya da bilinen geçici desenleri taşıyan bir dosyayı üretim gövdesinden
          //   ayıran bir kural yoktur. Çözüm adayları şunlardır ve karar Founder'ındır:
          //   motorun ders dünyası dışlama desenine (INDEKS_DISI) geçici önek eklemek,
          //   ya da nöbetin fikstürü çalışma alanının altında fakat denetim evreninin
          //   dışında kalan bir rafa yazması. Kanca Founder'ın makinesinde yaşadığı için
          //   bu turda davranışı DEĞİŞTİRİLMEMİŞTİR; gözlem kayda geçirilmiştir.
          ne: "🧹 Plan hijyeni: kenarsız geliştirme, çift ilanlı dosya ve yapışık düğüm. Üç küçük borç tek turda kapanır. Birincisi, VIT-GRAF-A20 ile VIT-POSTA-A05 Adımları geliştirmede olduğu hâlde ne üretir ne referans kenarı taşır ve motor bunu zaten iki bilgi tanısıyla söylemektedir; bitince ürettikleri dosyanın izi plandan okunamayacaktır. İkincisi, üç kaynak dosyası birden fazla Kod kimliğiyle ilanlıdır: eklenti gövdesi meyve haritasında ve göç planında, yüzey metin kataloğu vitrin planında ve göç planında, yol haritası ise üç kimlik altında yaşar; etki ve graf sorguları aynı dosyayı ayrı düğümler sayar ve hiçbir nöbet çift ilanı ölçmez, çünkü yetim-meyve kapısı ilansız kalmayı ölçer, iki kez ilan edilmeyi ölçmez. Üçüncüsü, vitrin planının meyve bloğunda iki Kod düğümü satır başı olmadan tek satıra yapışmıştır; ayrıştırıcı kabul eder, insan gözü görmez." ) {
          görev: [
            "İki geliştirmedeki Adıma üretir ve referans kenarlarını yaz; hedef dosyalar ilanlıdır, yalnız kenar eksiktir.",
            "Üç dosyanın çift ilanını tekle: göç planındaki KD-GOC ilanları tarihsel olarak kalır ve sonraki Adımlar onları hedefler ya da meyve haritasındakiler düşürülür; karar dosya başına verilir ve gerekçesi yazılır.",
            "Aynı dosyayı ikinci kez ilan eden Kod düğümünü yakalayan bir nöbet kur; nöbet çift ilanı uyarı düzeyinde bildirir ve bugünkü üç çift onun ilk fikstürüdür.",
            "Yapışık düğümü kendi satırına al."
          ]
          kabul: [
            "Motor bu iki Adım için meyvesiz-geliştirme ve referanssız-geliştirme tanısı üretmez.",
            "Bir kaynak dosyasının Kod ilanı tektir ve çift ilan nöbeti fikstürle kanıtlanmıştır.",
            "Vitrin planının meyve bloğunda her Kod düğümü kendi satırında başlar."
          ]
          sınır: "Göç planındaki ilanlar tarihtir ve silinmez; tekleme tarihsel olanı korur, canlı olanı seçer. KYN-YUZ-A02 ile A03 Adımlarının göç kimliklerine bağlanması 2026-08-28 tarihinde yapılmıştır ve bu Adımın konusu değildir."
        }

        Adım( kod: BKM-DNT-A17, ad: "Çift Kod İlanlarının Canlı Kimliğe Taşınması", durum: beklemede, öncelik: p3, üretir: [ KOD-DENETCI ], bağımlı: [ BKM-DNT-A03, HST-MTR-A12 ],
          referans: [ MIM-2 ],
          ne: "🪪 Her dosyanın planda tek canlı Kod kimliği olsun ve çift ilan nöbeti kapıda koşsun" ) {
          görev: "Founder'ın 2026-10-10 hükmüyle her dosyanın tek canlı Kod düğümü olur ve kapanmış Adımların satır içi ilanları tarih kaydı sayılır. BKM-DNT-A03 sonrasında canlı tarafta on yedi dosya bir Adımın kendi değişikliği için açtığı ikinci Kod düğümünü taşımaktadır. Her dosya için kanonik canlı kimlik seçilir, ikinci düğümlere yönelen üretir kenarları ona taşınır ve düşen düğümlerin ne alanında hüküm taşıyan bir cümle varsa aranabilir bir alana aktarılır. Ardından çift ilan nöbeti tanı kümesinin tek kaydındaki artırma adımıyla uyarı düzeyinde kapıya bağlanır; bağlanmadan önce bu depoda ve çatıdaki projelerde kaç uyarı doğacağı ölçülür."
          kabul: [
            "canlı tarafta birden çok Kod ilanı taşıyan dosya sayısı sıfırdır; tarih kayıtları ayrıca bilgi olarak raporlanır",
            "her Adımın üretir kenarlarının vardığı dosya kümesi önce ve sonra aynıdır",
            "çift ilan nöbeti kapıya bağlıdır ve canlı ağaca geri eklenen bir çift ilanı uyarıyla yakalar (önce kırmızı, sonra yeşil)",
            "denetim 0 hata, süitler yeşil"
          ]
          sınır: "Tarih kayıtları silinmez ve ne alanları yeniden yazılmaz; Founder hükmü taşıyan hiçbir cümle kaybolmaz"
        }
      }

      AltKatman( kod: BKM-DNT-K2, departman: kodlama, ad: "Yüzey Onarımları",
        ne: "🔧 Kanonun açıkça istediği ya da manifestin vadettiği hâlde görünmeyen dört yüzey parçası" ) {

        Adım( kod: BKM-DNT-A04, durum: tamamlandı, öncelik: p1, bağımlı: [], referans: [ ORK-3.4, YUZ-3.3 ],
          üretir: [ KOD-KAPI-KAPSAMI, KOD-SNM-KAPI-KAPSAMI ],
          koşu: Koşum( kod: KSM-BKM-DNT-A04, tarih: 2026-09-02, mühür: VERIFIED, karar: kabul,
            kanıt: "urun/cekirdek/sinama/kapi-kapsami.test.ts · küme nöbeti ve ORK-3.4 uçtan uca nöbeti · 8/8 · ilan geri alınınca 2 kırmızı",
            ne: "İlanda önceliksiz Adım üreticisine panel yüzeyi eklendi ve gerekçe satırın üstüne yazıldı; küme nöbeti üreticiyi panel süzgecinde arar ve beyansız tek açık Adımlık fikstürle uçtan uca nöbet kuruldu. İlan geri alındığında iki nöbet birden kırmızıya döndü, geri konunca sekiz sınama yeşile döndü; eklentinin yüzey nöbeti yüz sınamayla yeşildir. Açık kalem yoktur." ),
          ne: "🔔 Önceliksiz Adım bildiriminin panele ulaşması. Bu, 2026-08-28 tarihinde onarılan ateşlemiş hatırlatıcı kusurunun birebir ikizidir ve aynı kanon turunda doğmuş üçlünün üçüncü üyesidir: ORK-3.4 maddesinin zorlama satırı `önceliksiz-adım` tanısı için kelimesi kelimesine 'proje CLI ve Bildirimler' der, yönlendirme matrisi onu Bildirimler hanesinde sayar, buna karşılık üreticisi ilanda yalnız komut satırı taşır ve panel süzgeci onu yapısal olarak eler. KYN-MTR-A05 Adımının kendi problem metni bu iki tanıyı adıyla birlikte anmaktadır; kardeşi onarıldı, bu onarılmadı. Üçlünün üçüncüsü olan mevsim vadesi zaten panel yüzeyi taşımaktadır. Karar Founder'a sorulmaz, çünkü kanon yüzeyi açıkça yazmıştır; Adım ateşlemiş hatırlatıcı onarımının deseniyle tek satır ve iki nöbetten ibarettir." ) {
          görev: [
            "İlanda üreticiye panel yüzeyini ekle ve gerekçeyi satırın üstüne yaz.",
            "Küme nöbetini genişlet: üretici panel süzgeci kümesinde bulunmalıdır.",
            "Uçtan uca nöbet kur: öncelik alanı olmayan bir Adım taşıyan fikstürde tanı doğar, köken damgası üreticiyi gösterir ve panel süzgecinden geçer; ilan geri alınırsa iki nöbet birden kırmızıya döner."
          ]
          kabul: [ "Önceliksiz Adım tanısı Gözlemler hanesine ulaşır; bu fikstürle kanıtlanmış ve mutasyonla doğrulanmıştır." ]
          sınır: "Yalnız bu üretici; öteki otuz dokuz komut satırı girdisi BKM-DNT-A01 kararını bekler."
        }

        Adım( kod: BKM-DNT-A05, durum: tamamlandı, öncelik: p2, bağımlı: [], referans: [ MIM-3, YUZ-3.3 ],
          üretir: [ Kod( kod: KOD-EKL-MANIFEST, dosya: "urun/eklenti/package.json", ne: "🍎 Eklenti manifesti — komutlar, paneller, menüler, temalar ve yerelleştirme anahtarlarının ilanı" ), KOD-YOLHARITA-GENISLETME, KOD-SNM-MANIFEST-MENULERI ],
          koşu: Koşum( kod: KSM-BKM-DNT-A05, tarih: 2026-09-02, mühür: VERIFIED, karar: kabul,
            kanıt: "urun/eklenti/sinama/manifest-menuleri.test.ts · 3/3 · eski koşul geri konunca 1 kırmızı · eklenti süiti 692/692",
            ne: "İskeleti Kur düğmesinin koşulu *_anadizin.sar desenine çevrildi ve eski ad geçiş yedeği olarak kaldı; Yol Haritası varlıksız alanda katalogdan gelen iki dilli boş durum cümlesini gösteriyor. Yeni manifest nöbeti beş menü grubunu birden kapsıyor, dosya adı koşulu taşıyan her girdiyi kanonik ad, eski ad ve sıradan dosya üstünde ölçüyor ve eski koşul geri konduğunda kırmızıya dönüyor. Canlı pencerede düğmenin görünmesi Founder'ın bakışına bırakılmıştır." ),
          ne: "🪟 Manifestin göç artıkları: görünmeyen düğme ve boş kalan panel. Birincisi, editör başlığındaki 'İskeleti Kur' düğmesi yalnız `ana.sar` adlı dosyada görünecek biçimde koşullanmıştır; oysa canlı adlandırma `*_anadizin.sar` desenidir ve bunu doğuş komutu, yol haritasının tarama deseni ve eklentinin kendi sürüm günlüğü üç ayrı yerden doğrular. Komut paletten çalışır, düğme kanonik adı kullanan hiçbir projede belirmez; bu, göç sırasında manifestin kaynakla birlikte taşınmamasından doğan bir artıktır ve manifest nöbetleri editör başlığı ile görünüm başlığı menü gruplarını hiç ölçmediği için bugüne dek yaşamıştır. İkincisi, altı panelin beşi boş durumda bir cümle söylerken Yol Haritası hiçbir şey söylemez: ağaç görünümü mesaj almaz ve manifestte karşılama katkısı yoktur, dolayısıyla varlıksız bir çalışma alanında panel açıklamasız bomboş kalır." ) {
          görev: [
            "Düğmenin koşulunu `*_anadizin.sar` desenine çevir ve eski adı yalnız geçiş yedeği olarak koru.",
            "Yol Haritası'na katalogdan beslenen bir boş durum cümlesi ver; cümle öteki panellerin boş durum desenini izler ve siz üslubundadır.",
            "Manifest nöbetini editör başlığı ile görünüm başlığı menü gruplarına genişlet; her menü girdisinin koşulundaki dosya adı deseni canlı adlandırmayla eşleşmelidir."
          ]
          kabul: [
            "Kanonik adlı bir anadizin açıkken düğme editör başlığında görünür ve bu bir nöbetle ölçülür.",
            "Varlıksız bir çalışma alanında Yol Haritası boş durum cümlesini gösterir; cümle katalogdadır ve iki dilde karşılığı vardır.",
            "Beş menü grubunun beşi de manifest nöbetinin kapsamındadır."
          ]
          sınır: "Düğmenin işlevi değişmez; yalnız görünürlük koşulu gerçeğe çekilir. Canlı pencere doğrulaması Founder'ındır."
        }

        Adım( kod: BKM-DNT-A06, durum: tamamlandı, öncelik: p2, bağımlı: [], referans: [ MIM-3 ],
          üretir: [ KOD-KAPI-KAPSAMI, KOD-SNM-KAPI-KAPSAMI, KOD-CLI-KAPISI ],
          ne: "📜 Kapı kapsamı ilanının fiilî davranışın ölçümü hâline gelmesi. İlanın başlık yorumu kapsamı 'bugünkü fiilî davranışın ölçümü' diye tanımlar, fakat üç yerde gerçekten ayrışır. Birincisi, `dogusEksikTanilari` üreticisi yalnız MCP yüzeyinde koşar ve ilanda hiç yoktur; kapsam nöbeti bunu göremez, çünkü yalnız denetim hattının kaynağını okur ve MCP çağrı kümesini taramaz. İkincisi, AltKatman tekilliği üreticisi tek-dosya yüzeyini ilan eder, oysa tek-dosya yolu yalnız doğrulayıcıyı çağırır ve bu üreticiye hiç uğramaz; beyan ölçüm değildir. Üçüncüsü, MCP'nin proje denetimi aracı komut satırını alt süreç olarak koşturur, dolayısıyla altmış bir üreticinin tamamı fiilen MCP yüzeyinde çalışır ve çıktısı ajana ulaşır, oysa ilan yalnız doğrulayıcıya MCP yazar. Üçü de nöbetsizdir ve nöbetsiz oldukları için sessizdir." ) {
          görev: [
            "Kapsam nöbetini MCP ve tek-dosya yollarını da tarayacak biçimde genişlet; her yüzey için gerçek çağrı kümesi kaynaktan çıkarılır ve ilanla karşılaştırılır.",
            "Doğuş eksiği üreticisini ilana MCP yüzeyiyle ekle; AltKatman tekilliğinin tek-dosya beyanını ya gerçeğe çek ya da tek-dosya yoluna bağla.",
            "Alt süreç köprüsüyle MCP'ye ulaşan üreticiler için ilanda tek bir kural cümlesi yaz: komut satırı yüzeyi taşıyan her üretici proje denetimi aracı üstünden MCP'ye de ulaşır; tek tek MCP yazılmaz, kural yazılır."
          ]
          kabul: [
            "Kapsam nöbeti dört yüzeyin dördünde ilan ile gerçek çağrı kümesini eşitler ve bugünkü üç ayrışma onun ilk fikstürüdür.",
            "İlanda beyan edilip çağrılmayan ya da çağrılıp beyan edilmeyen üretici sayısı her yüzeyde sıfırdır."
          ]
          sınır: "Hangi üreticinin hangi yüzeyde koşacağı kararı bu Adımın değil BKM-DNT-A01'in konusudur; bu Adım yalnız ilanın gerçeği söylemesini sağlar."
          koşu: "2026-09-10 · KAPANDI. Kapı kapsamı ilanı artık dört yüzeyi birden tarıyor ve Adımın saydığı üç ayrışmanın üçü de kapandı; ikisi nöbetin ilk fikstürü oldu. Doğuş eksikliğini bildiren üretici ilanda HİÇ yoktu ve yalnız sunucu yolundan çağrılıyordu, ilana girdi; alt katman tekilliği üreticisinin tek-dosya beyanı ölçümle yanlış çıktı ve düştü; alt süreç köprüsü üretici başına değil kural olarak yazıldı. Bir tasarım kararı gerekçesiyle beyana çevrildi: panele ulaşmayan bir uyarı üreticisine yüzey vermek bir YÜZEY kararıdır ve bu Adımın sınırı onu başka bir Adıma bırakır, bu yüzden var olan düzen panel ikizi beyanıyla ölçülür hâle getirildi ve ikizin gerçekten panelde yaşadığı mutasyonla kanıtlandı. Her yüzeyde ilan fazlası ve kayıt fazlası sıfırdır."
        }

        Adım( kod: BKM-DNT-A07, durum: tamamlandı, öncelik: p3, bağımlı: [], referans: [ YUZ-1.2, YUZ-4.1 ],
          üretir: [ KOD-EKL-ONIZLEME, KOD-SNM-ONIZLEME-PALET ],
          koşu: Koşum( kod: KSM-BKM-DNT-A07, tarih: 2026-09-02, mühür: VERIFIED, karar: kabul,
            kanıt: "urun/eklenti/sinama/onizleme-palet.test.ts · 2/2 · harita geri konup yedek koparılınca 2 kırmızı · palet drift nöbeti değişmedi",
            ne: "Önizlemedeki iki elle yedek harita kaldırıldı ve çözücü tanımsız döndüğünde tek yedek olarak paketle gelen gömülü kanon bırakıldı. Yeni nöbet mantık bölgesinde kanondan bağımsız renk değeri kalmadığını, yedeğin gömülü kanona düştüğünü ve gömülü paletin yedi ağaç tipi ile bütün aileleri boyadığını ölçüyor. CSS bloğundaki renkler bilinçle dışarıda bırakıldı, çünkü onların kanona bağlanması EKL-F6-A05 Adımının işidir." ),
          ne: "🎨 Önizlemenin yedek paletinin elle ikiz olmaktan çıkması. Önizleme dosyası ağaç ve aile renklerini 'kanon yokken devreye girer' notuyla elle yazılmış iki haritada taşır. Ölçüm iki şey gösterdi. Birincisi, harita kanondan sapmıştır: öz ailesinin rengi yedekte başka, kanonda başkadır. İkincisi, dal ulaşılmazdır: sınıflama çözücüsü kanon bulamadığında gömülü kanona düşer ve gömülü kanon paleti zaten taşır, dolayısıyla yedek haritaya düşen `??` dalı fiilen hiç çalışmaz. Sapmış ve ölü bir kopya, YUZ-1.2'nin yasakladığı elle ikizin ta kendisidir; hiçbir nöbet iki haritayı kanona karşı ölçmez. Renk dosyasındaki kardeş haritalar (aile ve önek simgeleri) ise palet drift nöbetiyle korunmaktadır ve bu Adımın dışındadır." ) {
          görev: [ "Yedek haritaları kaldır ve gömülü kanona düşen yolu tek yedek olarak bırak; kaldırılamıyorsa iki haritayı palet drift nöbetine bağla ve sapmayı düzelt." ]
          kabul: [ "Önizleme kaynağında kanondan bağımsız yazılmış renk değeri kalmaz ya da kalanlar palet drift nöbetiyle kanona eşitlenir; nöbet mutasyonla kanıtlanmıştır." ]
          sınır: "Gömülü kanon üreteci ve palet drift nöbeti değişmez."
        }

        Adım( kod: BKM-DNT-A15, ad: "Doğan Kökün Kapısı", durum: tamamlandı, öncelik: p1, bağımlı: [],
          referans: [ HTR-ILK-DIS-KULLANICI-TANIGI, HTR-DOGUS-PAKETI-KANCA-VE-OGRETI-KARTI ],
          üretir: [ KOD-DOGUS, KOD-SNM-DOGUS ],
          ne: "🛡️ Doğuş paketinin doğurduğu kökü kapısız bırakmaması. Kontrolcü 2026-09-09 tarihinde paketin ürettiği dosya listesini kaynaktan bağımsız olarak ölçmüştür ve paket bugün yalnız altı dosya yazmaktadır: giriş ilanı, durum devir kaydı, iki öğrenme dosyası, ilk plan ve ajan dil bağlamı. Ölçüm beş dosyanın hiç doğmadığını göstermiştir ve beşinin de tek bir sonucu vardır: doğan kök tek başına açıldığında ürünün kendi kapıları orada çalışmaz. Birincisi yok sayma dosyası doğmaz, dolayısıyla küresel yok sayma kuralı `*.sar` deseni taşıyan bir makinede doğan projenin hafızası depoya hiç girmez; 2026-09-05 ölçümünde on yedi kaynak dosyasının sıfırı izleniyordu ve ilk dış kullanıcı bunu proje hafızasının tek diskte kalması olarak bildirmiştir. İkincisi yürütücü ayar dosyası doğmaz, dolayısıyla doğan kök Sarmal sunucusunu bulamaz ve ajan ürünün araçlarına hiç erişemez. Üçüncüsü yönerge ikizinin yalnız bir kanadı yazılır; paket ajan dil bağlamını üretmekte, ikizin öteki kanadını üretmemektedir ve bu yüzden doğan projede ikiz nöbeti kendi konusunu bulamaz. Dördüncüsü kanca yazılmaz, dolayısıyla ilk kaynak yazımından sonra denetim kendiliğinden koşmaz ve ajanın kapıyı atlaması hiçbir mekanizmayla engellenmez. Beşincisi kanon işaretçisi yazılmaz, dolayısıyla eklenti tip sistemi kaydını bulamaz ve panel o kökte kör kalır." ) {
          görev: [
            "Doğuş paketine yok sayma dosyası üretimini ekle: dosya yoksa `!*.sar` istisnasıyla yazılır, varsa istisna eksikse eklenir ve hiçbir mevcut satır silinmez.",
            "Doğuş paketine yürütücü ayar dosyası üretimini ekle: doğan kök Sarmal sunucusunu kardeş kurulumdan ya da paket adından çözer ve ajan ilk turdan itibaren ürünün araçlarını kullanır.",
            "Doğuş paketine yönerge ikizinin eksik kanadını ekle: iki dosya bayt özdeş doğar ve ikiz nöbeti doğan projede kendi konusunu bulur.",
            "Doğuş paketine kapı kancasını ekle: her kaynak yazımından sonra denetim kendiliğinden koşar ve hata ajana geri döner; kancanın kurulumu doğan kökün kendi sınırında kalır ve kullanıcının makinesindeki küresel ayarlara dokunulmaz.",
            "Doğuş paketine kanon işaretçisini ekle: doğan kök tek başına açıldığında eklenti tip sistemi kaydını çözer ve panel kör kalmaz.",
            "Kancanın yanlış pozitifini onar: kanca bugün komut metninde giriş ilanı desenini gördüğü an reddetmekte, o desenin gerçekten bir yazım hedefi olup olmadığını ölçmemektedir; kontrolcü 2026-09-09 tarihinde proje dışındaki bir çalışma notuna yazarken bu retle karşılaşmıştır. Kanca yalnız gerçek yazım hedefini ölçer ve deseni yalnızca anan komutu geçirir.",
            "Yönerge ikizi nöbetinin kurulum tuzağı notunu ve ölçümünü `.sar` desenini kapsayacak biçimde genişlet.",
            "Nöbet kur: küresel yok sayma kuralı `*.sar` içeren bir fikstür deposunda doğan proje `git check-ignore` ile ölçüldüğünde hiçbir `.sar` yok sayılmaz.",
            "Nöbet kur: doğan kök tek başına açıldığında beş dosyanın beşi de yerindedir ve kanca gerçek bir yazımda ateşleyip deseni yalnızca anan bir komutta ateşlemez."
          ]
          kabul: [
            "Doğuş paketiyle doğan projede `.sar` dosyaları küresel yok sayma kuralına rağmen izlenir; bu fikstürle kanıtlanmıştır.",
            "Var olan yok sayma dosyasının satırları korunur ve istisna tek kez yazılır.",
            "Doğan kök tek başına açıldığında yürütücü ayar dosyası, yönerge ikizinin iki kanadı, kanca ve kanon işaretçisi yerindedir; bu, doğan bir fikstür kökünde dosya dosya ölçülmüştür.",
            "Kanca gerçek bir giriş ilanı yazımını reddeder ve deseni yalnızca anan bir komutu geçirir; ikisi de nöbetle kanıtlanmıştır.",
            "Çekirdek süiti yeşildir; depo denetimi sıfır hata ve sıfır uyarı verir."
          ]
          sınır: "Kullanıcının küresel yok sayma dosyasına ve makinesindeki küresel kanca kurulumuna dokunulmaz; doğan kökün kapıları yalnız o kökün kendi dosyalarında yaşar. Bu Adım öğretim kartı yazmaz ve karşılama kartına dokunmaz; doğuşun öğretisi BKM-DNT-A16 Adımının işidir."
          koşu: "2026-09-10 · KAPANDI. Doğan ağaç altı dosyadan on üçe, çalışma alanı sekizden yirmi ikiye çıktı; beş eksik kapının beşi de yerine kondu ve Kitaplık hükmü şablonlara indi. Bağımsız kabul denetimi kontrolcü tarafından koşuldu: tür denetimi sıfır hata, proje denetimi sıfır hata ile sıfır uyarı, çekirdek süiti bin iki yüz otuz yedide bin iki yüz otuz yedi, eklenti süiti altı yüz doksan yedide altı yüz doksan yedi; gerçek bir çalışma alanı doğurulup denetlendiğinde sıfır hata verdi, altı kaynak dosyasının altısı da küresel yok sayma kuralına rağmen izlendi ve var olan bir yok sayma dosyasının dört satırı korunarak istisna tam bir kez yazıldı. Açık kalan tek kalem Adımın sınırı gereğidir ve dürüstçe beyan edilir: onarılmış kanca mantığı üründedir, Founder'ın makinesindeki küresel kanca kurulumu hâlâ eski gövdeyi taşımaktadır ve tazelenmesi Founder kararıdır."
        }

        Adım( kod: BKM-DNT-A16, ad: "Doğuşun Öğretisi", durum: tamamlandı, öncelik: p1, bağımlı: [ BKM-DNT-A15 ],
          referans: [ HTR-AJAN-KAPI-ATLAMA-DESENI-METINLE-KAPANMAZ, HTR-DOGUS-PAKETI-KANCA-VE-OGRETI-KARTI ],
          üretir: [
            Kod( kod: KOD-BECERI-KARTI, dosya: "urun/cekirdek/src/beceri-karti.ts", ne: "🍎 Konu kartı araması — ogret { konu } çağrısının tek gövdesi; anahtar sıkıştırması Türkçe yazımı ASCII dosya adına denk düşürür ve raf adresi kurulumdan çözüldüğü için kart boş dizinde de yanıt verir" ),
            Kod( kod: KOD-SNM-DOGUS-OGRETISI, dosya: "urun/cekirdek/sinama/dogus-ogretisi.test.ts", ne: "🍎 Doğuş anının öğretisi nöbeti — boş fikstür dizininde konu kartları, anlatının üç bölümü, beş anti-desen, rehber ile kartın tek üreticiden doğduğu, bayat plan adresinin kalmadığı ve sunucu talimatının doğuş araçlarını andığı ölçülür" )
          ],
          // ── 2026-09-10 · ÖLÇÜM (kontrolcü · BKM-DNT-A15 kapandıktan hemen sonra) ──
          //   Doğuş paketi ile rehber şablonları Kitaplık hükmüne göre tazelendi,
          //   fakat ÜÇÜNCÜ bir öğretim yüzeyi eski mimaride kaldı ve ölçüldü.
          //   Karşılama kartının kaynağında (ogret.ts) "Kitaplık" sözcüğü SIFIR kez
          //   geçmektedir; kartın örneği Rafı doğrudan kökün altına yazmakta
          //   (`Raf( kod: RAF-PLAN, yol: "plan/" )`) ve plan dosyasının adresini
          //   `plan/ilk_plan.sar` olarak göstermektedir. Oysa doğan ağaçta o dosya
          //   artık `is/plan/ilk_plan.sar` adresindedir; kart var olmayan bir yol
          //   öğretmektedir. Aynı bayat adres belge yüzleri üretecinde de durmaktadır.
          //   Bu yüzeyin ağırlığı ötekilerden fazladır: boş bir dizinde ajanın
          //   GÖRDÜĞÜ İLK ŞEY karşılama kartıdır ve oturum açılışında kendiliğinden
          //   basılır. Doğuş paketi ne kadar doğru üretirse üretsin, kart yanlış
          //   öğrettiği sürece ajan yanlış ağacı elle yazmayı sürdürür. Ders tek
          //   cümledir: bir mimari kararı üç öğretim yüzeyinin üçüne birden inmedikçe
          //   uygulanmış sayılmaz.
          //
          // ── 2026-09-10 · ÖĞRETİNİN ULAŞMA TABLOSU (üretici ölçümü · taze süreçten) ──
          //   Sütunlar: KANAL · hangi araçtan · hangi anda ateşler · BOŞ dizinde koşar mı.
          //   Ölçüt tek cümledir: ateşlemeyen kart öğreti sayılmaz.
          //
          //   ① Sunucu talimatı .......... MCP initialize · oturum açılışında, hiçbir araç
          //      çağrılmadan · BOŞ DİZİNDE ÇALIŞIR. Doğuş araçlarını (dogus · iskelet ·
          //      ogret) adıyla anar ve boş dizinde elle yazma yasağını yazar.
          //   ② Karşılama kartı .......... `ogret` (konusuz) · ilk temasta ve oturum
          //      açılışında kendiliğinden · BOŞ DİZİNDE ÇALIŞIR. Doğuş anlatısının üç
          //      bölümünü (hedef · kademeli onay · diyalog disiplini) taşır.
          //   ③ Doğuş rehberi ............ `basla` (türlü ve türsüz) · yazmadan ÖNCE ·
          //      BOŞ DİZİNDE ÇALIŞIR. Kartla AYNI anlatı gövdesini basar (tek üretici).
          //   ④ Konu kartları ............ `ogret { konu }` · ajan bir kavramı sorduğunda ·
          //      BOŞ DİZİNDE ÇALIŞIR, çünkü raf adresi çağıranın çalışma dizininden değil
          //      kurulumun kendi konumundan çözülür. ÇalışmaAlanı ve Teknoloji kartları
          //      bu turda doğdu; rafın on dört kartının on dördü de kendi konusundan
          //      çağrılabilir ve bu nöbetle ölçülür.
          //   ⑤ Beceri kartı enjeksiyonu . `sef` · YALNIZ bir Adım geliştirmede iken ·
          //      BOŞ DİZİNDE ATEŞLEMEZ. Kök sebep budur ve bu turda DEĞİŞMEDİ; Adımın
          //      sınırı mekanizmaya dokunmayı yasaklar. Boş dizinin öğretisi bu yüzden
          //      ①–④ kanallarına yaslanır.
          //   ⑥ Yönerge ikizi (AGENTS.md · CLAUDE.md) · doğan ağacın kökünde · BOŞ
          //      DİZİNDE YOKTUR, ancak doğuş paketi koştuktan SONRA vardır (BKM-DNT-A15).
          //
          //   Boş dizin hâli özetle şudur: ajanın ağacı elle yazmaya başladığı anda
          //   dört kanal (①②③④) açıktır ve beşincisi yapısal olarak kapalıdır.
          ne: "📚 Yeni bir ağaç kurarken ajanın önüne çıkan öğretinin, ürünün ne için var olduğunu ve planın nasıl kurulduğunu fiilen öğretecek kadar kapsamlı hâle gelmesi. Founder 2026-09-09 tarihinde şu hükmü vermiştir: Sarmal'ın eğitimi o kadar kapsamlı olmalıdır ki ajan işletim sistemi hedefini, Founder'ın anlatmak istediğini ve planlamanın belli sorular sorularak yavaşça yapılması gerektiğini iyice anlasın. Gerekçe aynı gün iki kez ölçülmüştür. Birincisi yapısaldır: beceri kartları yalnız bir Adım geliştirmede durumundayken ateşlemektedir, dolayısıyla henüz hiçbir Adımı bulunmayan boş bir ağaçta hiçbir kart ateşleyemez ve doğuş anı öğretinin ulaşamadığı tek andır; oysa yanlış ağacın kurulduğu an tam olarak o andır. İkincisi kapsamdır: öğretim aracı çalışma alanı ile teknoloji konuları için kart bulunamadı hatası döndürmektedir ve yeni ağaç kurarken en çok gereken iki kavramın kartı yoktur. Üçüncü bir ölçüm de bu Adımı doğurmuştur: aynı desen 2026-07-27 tarihinden bu yana en az yedi kez kaydedilmiş ve her seferinde çözüm yeni bir metin olmuştur, oysa metnin kendisi davranışı değiştirmemiştir; bu yüzden öğreti bu kez ajanın hiç atlayamayacağı kanaldan, yani boş dizinde de koşan rehber ile karşılama kartından verilir ve mekanik kapıya BKM-DNT-A15 Adımıyla yaslanır." ) {
          görev: [
            "Öğretim aracına çalışma alanı ve teknoloji kartlarını yaz; iki kart da boş bir dizinde çağrılabilir olmalı ve kart bulunamadı hatası kalkmalıdır.",
            "Rehber ile karşılama kartına doğuş anlatısını ekle: ürünün niyet ürettiği ve kod üretmediği, hedefin uzun ömürlü ve karar yoğun işi ajanla birlikte yürütmek olduğu, bir ağacın tek hamlede değil kademe kademe kurulduğu ve her kademenin insan onayından geçtiği açık cümlelerle yazılır.",
            "Planlamanın diyalog disiplinini karta indir: ajan bir ağaç kurmadan önce mimariyi konuşur, önce giriş ilanını çıkarır ve onaylatır, sonra plan dosyasını açar; her kademede somut seçenekler sunar ve seçimi kullanıcıya bırakır, kendi başına tahmin etmez.",
            "Kartlara ölçülmüş anti-desenleri yaz: boş dizinde ağacı elle yazmak, doğuş araçlarını hiç çağırmamak, şema aracını rehber yerine kullanmak, bir kademeyi atlayıp doğrudan alt kademeyi açmak ve zaman eksenini giriş ilanına yazmak.",
            "Öğretinin ulaşma kanalını ölç ve kayda yaz: hangi kartın hangi anda hangi araçtan ateşlediği, boş dizin hâli dâhil, tek tabloda gösterilir; ateşlemeyen kart öğreti sayılmaz.",
            "Nöbet kur: boş bir dizinde öğretim aracı çalışma alanı ile teknoloji konularını cevaplar ve rehber çıktısı doğuş sırasını, kademeli onay hükmünü ve diyalog disiplinini taşır."
          ]
          kabul: [
            "Öğretim aracı çalışma alanı ve teknoloji konuları için kart döndürür; kart bulunamadı hatası hiçbir konuda kalmamıştır ve bu boş bir fikstür dizininde ölçülmüştür.",
            "Rehber ile karşılama kartı doğuş sırasını, kademeli onay hükmünü ve diyalog disiplinini açık cümlelerle taşır; metinler kanondan üretilir ve elle ikizlenmez.",
            "Öğretinin ulaşma tablosu kayıttadır ve ateşlemeyen kart kalmamıştır; boş dizin hâli tabloda ayrıca gösterilmiştir.",
            "Çekirdek süiti yeşildir; depo denetimi sıfır hata ve sıfır uyarı verir."
          ]
          sınır: "Bu Adım kanon maddesi yazmaz ve hüküm üretmez; öğretim metni kanonun bugünkü hükümlerinden türer. Beceri kartlarının ateşleme mekanizmasının kendisi değişmez; bu Adım yalnız doğuş anında ulaşan kanalı doldurur. Doğan köke dosya yazmak BKM-DNT-A15 Adımının işidir ve burada yinelenmez."
          koşu: "2026-09-10 · KAPANDI. Doğuş anlatısı üç bölüm ve iki dil olarak üretildi; karşılama kartı, doğuş rehberi ve sunucu talimatı aynı gövdeden beslenir oldu, kartın örneği Kitaplık kademesini ve doğru plan adresini öğretir hâle geldi ve iki eksik konu kartı doğdu. Üretici, kontrolcünün görmediği üç kusuru daha ölçüp kapattı: konu anahtarı Türkçe harfi koruduğu için ASCII dosya adlarıyla hiçbir zaman eşleşemiyordu, yani kart yazılsa bile bulunamazdı; komut satırı ikizi konu sorulduğunda kartları henüz yolda deyip karşılama kartı basıyordu ve bu YUZ-1.2 çift kaynak yasağının ihlaliydi; sunucu talimatı doğuş araçlarının adını hiç anmıyordu. Bağımsız kabul denetimi kontrolcü tarafından koşuldu: iki tür denetimi sıfır hata, proje denetimi sıfır hata ile sıfır uyarı, çekirdek süiti bin iki yüz elli beşte bin iki yüz elli beş, eklenti süiti altı yüz doksan yedide altı yüz doksan yedi; dokuz ayrı mutasyon nöbetleri kırmızıya düşürdü ve boş bir fikstür dizininde beş ayrı yazımın beşi de kart döndürdü. Kök sebep bilinçle yerinde bırakıldı ve dürüstçe beyan edilir: beceri kartları hâlâ yalnız geliştirmede bir Adım varken ateşlemektedir, dolayısıyla boş dizinin öğretisi mekanik zorlamaya değil dört açık kanala yaslanmaktadır."
        }
        Adım( kod: BKM-DNT-A18, ad: "Panelin Dışarıdan Değişen Dosyada Bayat Kalmaması", durum: tamamlandı, öncelik: p1, bağımlı: [],
          referans: [ HTR-EKLENTI-DAR-KAPSAM-BAYAT-PANEL, PRF-A06 ],
          üretir: [ KOD-SNM-DIS-DEGISIKLIK ],
          ne: "🩹 Panelin, editör dışında değişen bir dosyada eski bilgiyi göstermeyi sürdürmemesi. 2026-10-24 tarihinde 0.9.194 kurulu bir makinede yol haritası paneli bir projenin Adım sayısını eski değerinde göstermiş, doğru değer ancak pencere yeniden yüklenince gelmiştir; dosyalar o sırada başka bir pencerede çalışan bir ajan tarafından değiştiriliyordu. Kontrolcü kaynakta iki aday neden ölçmüştür. Birincisi, tur açık belgeyi her zaman diskten önce okur (tur-belgesi.ts, açık belge önceliği). Dosya editörün dışında değiştiğinde, VS Code modeli diskten tazelemeden önce koşan bir tur eski metni okur; ardından yeni bir olay gelmezse panel o eski sayıda kalır. İkincisi, olay tetikli tur değişen dosyanın kökünü değil odaktaki varlığı seçer (izleyici-cekirdek.ts, turKapsami). O makinenin günlüğünde bir pencerenin olay turlarının, değişikliğin yapıldığı projeye değil odaktaki başka bir projeye daraldığı görülmüştür; bu, değişen projenin çapraz tanılarının yeniden hesaplanmaması demektir. Panelin kendisi her turda turun yayınından bütünüyle yeniden kurulmaktadır; dolayısıyla onarımın yeri panel değil, turun girdisidir." ) {
          görev: [
            "Önce bayatlığı bir fikstürde yeniden üret: iki kardeş kökü olan bir çalışma alanında odak birinci kökteki bir dosyadayken ikinci kökteki bir .sar dosyası editörün dışından değiştirilir ve ilk turdan sonraki tur görüntüsünün ikinci kökün yeni sayılarını taşıyıp taşımadığı ölçülür. İki aday nedeni ayrı ayrı sına ve hangisinin ya da ikisinin birlikte bayatlığı ürettiğini koşu kaydına yaz.",
            "Açık belge önceliğini yalnız kaydedilmemiş değişiklik taşıyan belgeyle sınırla: kaydedilmemiş değişiklik taşımayan açık belge diskten okunur, çünkü o durumda gerçek disktir; kaydedilmemiş düzenlemenin önceliği korunur. Karar saf modülde yaşar ve editör kabuğu olmadan sınanır.",
            "Olay tetikli turun dar kökünü olaylardan türet: turu tetikleyen olayların değiştirdiği .sar dosyaları odaktaki varlığın dışındaysa o dosyaların kökleri de denetlenir ya da tur tam koşar. turKapsami saf kalır ve değişen yolları argüman olarak alır; olay hattı değişen yolları tura taşır.",
            "Mercek satırı dar turun kapsamını gerçekten denetlenen köklerle birlikte basar.",
            "Nöbet kur: kaydedilmemiş değişiklik taşımayan açık belgenin diskteki yeni metinle, kaydedilmemiş belgenin bellekteki metinle okunduğu; odak dışı bir kökteki değişiklikte o kökün çapraz tanılarının yeniden hesaplandığı; odak içindeki tek dosyalık değişiklikte turun yine yalnız odağa daraldığı."
          ]
          kabul: [
            "Fikstürde odak birinci kökteyken ikinci kökteki bir .sar dosyası editörün dışından değiştirildiğinde, pencere yeniden yüklenmeden ilk turdan sonra tur görüntüsü ikinci kökün yeni sayılarını taşır; bu davranış nöbetle kanıtlanmıştır.",
            "Kaydedilmemiş değişiklik taşımayan açık belge diskten, kaydedilmemiş belge bellekten okunur; iki durum da saf modül nöbetiyle kanıtlanmıştır.",
            "Odak dışı kökteki değişiklik o kökün çapraz tanılarını tazeler; odak içindeki tek dosyalık değişiklikte dar tur korunur ve mercek satırı denetlenen kökleri doğru adlarıyla basar.",
            "Eklenti ve çekirdek süitleri yeşildir; depo denetimi sıfır hata verir."
          ]
          sınır: "Denetim motorunun senkron yapısı ve işçi iş parçacığına taşınması bu Adımın dışındadır; eklenti sunucusunun yanıt vermez bildirimleri ayrı bir ölçüm Adımının konusudur. Panelin görsel tasarımına, sürüm numarasına ve değişiklik günlüğüne dokunulmaz; paketleme ve yayın ayrı bir Founder kararıdır."
          koşu: Koşum( kod: KSM-BKM-DNT-A18, tarih: 2026-10-24, mühür: COMPLETED, model: "claude-opus-5-5", kanıt: "urun/eklenti/sinama/dis-degisiklik.test.ts onarımsız ağaçta 3/10, onarımdan sonra 10/10 · on dokuz mutasyonun on dokuzu kırmızı · eklenti tip denetimi temiz · eklenti süiti 1082/1082 (taban 1059) · çekirdek süiti 1802/1802 · depo denetimi 0 hata 18 uyarı (taban 17; artış yeni sınama dosyasının yetim-meyve uyarısı)", ne: "Fikstürde Adım sayısının bayatlığını yalnız açık belge önceliği üretti; odaktan seçilen dar kök ise değişen kardeş kökün çapraz tanılarını bayat bıraktı ve sahada ikisi birlikte görüldü. Kaydedilmemiş değişiklik taşımayan açık belge artık diskten okunur ve dar tur, odağın yanında olaylarla değişen dosyaların köklerini de denetler. Gerçek VS Code entegrasyon süiti koşturulmadı, yeni sınama dosyasının meyve kenarı kapanışa kaldı ve kabul kontrolcünündür." )
        }

        Adım( kod: BKM-DNT-A19, ad: "Klasik Görünümün Düğüm Başına Ağırlığı", durum: beklemede, öncelik: p2, bağımlı: [],
          referans: [ BKM-DNT-A18 ],
          ne: "🪶 Mini Grafın klasik görünümü gerçek planda düğüm başına yaklaşık 1 KB HTML üretmektedir. 2026-10-25 tarihinde 36 düğümlük yeni bir Faz klasik görünümü 292 KB'tan 332 KB'a çıkarmış ve 300 KB'lık ölçek nöbetini kırmıştır; Founder nöbetin sınırını gerekçesiyle 400 KB'a çıkarmış ve görünümün hafifletilmesini bu Adıma bağlamıştır. Varsayılan ağaç görünümü aynı planda 167 KB'tır." ) {
          görev: [
            "Klasik görünümün HTML'inde düğüm başına hangi parçanın ne kadar yer tuttuğunu ölç ve en ağır üç parçayı kayda geçir.",
            "Görünümün görsel sonucunu değiştirmeden düğüm başına ağırlığı azalt; tekrar eden biçim bilgisi ortak sınıfa ya da tek tanıma taşınır.",
            "Ölçek nöbetinin sınırını yeniden 300 KB'a indir ve gerçek planda üç görünümün de bu sınırın altında kaldığını göster."
          ]
          kabul: [
            "Gerçek planda klasik görünüm 300 KB'ın altındadır ve ölçek nöbetinin sınırı yeniden 300 KB'tır.",
            "Görünümün görsel sonucu değişmemiştir; bu, önce ve sonra alınan ekran görüntüleriyle karşılaştırılmıştır.",
            "Eklenti süiti yeşildir."
          ]
          sınır: "Görünümün tasarımı ve bilgi içeriği değişmez; yalnız üretilen HTML hafifler."
        }

        Adım( kod: BKM-DNT-A20, ad: "Tek Panelin ve Görsel Kontrolün Kayda Alınması", durum: tamamlandı, öncelik: p1, bağımlı: [],
          referans: [ OZK-03, OZK-09, BKM-DNT-A18 ],
          üretir: [ KOD-PANEL, KOD-PANEL-CEKIRDEK, KOD-PANEL-BETIK, KOD-MAKINIST, KOD-TREN, KOD-TREN-CEKIRDEK,
                    KOD-MINIGRAF-GORUNUM, KOD-MINIGRAF-ILERLEME, KOD-MINIGRAF-KLASIK,
                    KOD-SNM-PANEL, KOD-SNM-PANEL-CEKIRDEK, KOD-SNM-TREN-CEKIRDEK, KOD-SNM-MINIGRAF-GORUNUM, KOD-SNM-MINIGRAF-KLASIK,
                    KOD-GORSEL-KONTROL, KOD-GORSEL-KONTROL-URET ],
          ne: "🗂️ Plana inmeden yapılmış iki işin geriye dönük olarak kayda alınması. Founder'ın 2026-10-21 tarihli çizimiyle Sarmal kabı, Ray, Tren ve Makinist sekmelerini taşıyan tek bir webview görünümüne indirilmiştir (72d9f56); Founder'ın 2026-10-22 tarihli hükmüyle de panelin kurulumdan önce tarayıcıda görsel olarak denetlenmesini sağlayan araç yazılmıştır (414b96a). İki işleme de hiçbir Adıma bağlanmamış ve 'Adım: yok' satırıyla girmiştir; doğan on altı dosya bu yüzden yetim meyve uyarısı vermiş ve deponun kendi denetimi 2026-10-25'ten beri kırmızı kalmıştır. 2026-10-27 tarihli kayıt incelemesi ayrıca şunu göstermiştir: tek panelde onay kartının dosyanın bulunduğu sütunda açılması Founder'ın açık isteği değildir, uygulayıcının türetmesidir ve kilitli OZK-09 hükmüyle çelişmektedir. Bu Adım yapılmış işi değiştirmez; yalnız onu plana bağlar ve çelişkiyi kayda geçirir. Panelin Founder'ın 2026-10-27 tarihli hükümlerine göre yeniden kurulması ayrı bir Blokun işidir." ) {
          görev: [
            "72d9f56 ve 414b96a işlemelerinin doğurduğu on altı dosyayı Kod meyvesi olarak Faz dosyasının sonunda ilan et ve bu Adımın üretir kenarına bağla.",
            "Tek panelin hangi hükümle ve hangi gerekçeyle yapıldığını, hangi parçasının Founder'ın isteği hangi parçasının uygulayıcının türetmesi olduğunu koşu kaydına yaz."
          ]
          kabul: [
            "On altı dosyanın her biri tam olarak bir Kod düğümüyle ilan edilmiştir ve bu Adımın üretir kenarına bağlıdır.",
            "Deponun kendi denetimi bu on altı dosya için yetim meyve uyarısı vermez."
          ]
          sınır: "Bu Adım hiçbir kaynak dosyaya dokunmaz ve panelin davranışını değiştirmez; onay kartının yeri, sekmelerin sayısı ve panelin hızı yeniden kurulum Blokunun konusudur. OZK-03 ile OZK-09 bu Adımda revize edilmez."
          koşu: Koşum( kod: KSM-BKM-DNT-A20, tarih: 2026-10-27, mühür: COMPLETED, model: "claude-opus-5-5", kanıt: "72d9f56 (tek panel, on dört dosya) · 414b96a (görsel kontrol, iki dosya) · deponun kendi denetiminde yetim meyve uyarısı on yediden bire indi; kalan bir uyarı BKM-DNT-A21 ile kapanır", ne: "İki işleme geriye dönük olarak plana bağlandı. Kayıt incelemesi tek panel düzeninin Founder'ın 2026-10-21 hükmünden geldiğini, onay kartının dosyanın sütununda açılmasının ise uygulayıcının türetmesi olduğunu gösterdi; gerçek VS Code entegrasyon süiti o işlemelerde koşulmamıştı. Kaynak dosyalara dokunulmadı." )
        }

        Adım( kod: BKM-DNT-A21, ad: "Doğuş Kancalarının İşletim Sisteminden Bağımsız Yazılmasının Kayda Alınması", durum: tamamlandı, öncelik: p1, bağımlı: [],
          referans: [ HTR-DOGUS-WINDOWS-KANCALARI, HTR-DOGUS-KILIDI-BELGE-METNI ],
          üretir: [ KOD-SNM-DOGUS-KANCALARI ],
          ne: "🗂️ 2026-10-23 tarihinde doğuş kilidi ile denetim kapısının yalnız Node'un yerleşik modüllerini kullanan karşılıkları yazılmış, doğuş paketi yeni köklere yalnız bu sürümleri kurar olmuş ve kilidin metin olarak geçen anadizin adını reddetme kusuru giderilmiştir (2d61536). İşleme bir Adıma değil iki hatırlatıcıya atıf vermiş, bu yüzden işin nöbet dosyası plana bağlanmamış ve yetim meyve uyarısı vermiştir. Bu Adım yapılmış işi değiştirmez; yalnız nöbet dosyasını plana bağlar." ) {
          görev: [
            "2d61536 işlemesinin doğurduğu nöbet dosyasını Kod meyvesi olarak ilan et ve bu Adımın üretir kenarına bağla."
          ]
          kabul: [
            "Nöbet dosyası tam olarak bir Kod düğümüyle ilan edilmiştir ve deponun kendi denetimi onun için yetim meyve uyarısı vermez."
          ]
          sınır: "Bu Adım hiçbir kaynak dosyaya dokunmaz."
          koşu: Koşum( kod: KSM-BKM-DNT-A21, tarih: 2026-10-27, mühür: COMPLETED, model: "claude-opus-5-5", kanıt: "2d61536 · doğuş sınamaları o işlemede 31/31 · deponun kendi denetiminde son yetim meyve uyarısı kapandı", ne: "Nöbet dosyası geriye dönük olarak plana bağlandı. Kancaların iki Windows kurulumunda çalıştığı 2026-10-25 tarihinde durum kaydına yazılmıştı (306f423); iki hatırlatıcı bu kanıtla kapandı." )
        }
      }

      AltKatman( kod: BKM-DNT-K3, departman: sınama, ad: "Nöbet Onarımları",
        ne: "🧪 Süit dürüstlüğü ölçümünün bulguları: kendi kanıtını yok eden nöbet, davranışı korunmayan kaynak yarısı ve boş kümeye karşı korumasız iddialar" ) {

        Adım( kod: BKM-DNT-A08, durum: tamamlandı, öncelik: p1, bağımlı: [], referans: [ YAS-4.1, YUZ-7 ],
          üretir: [ KOD-SNM-PAKET-TAZELIGI ],
          koşu: Koşum( kod: KSM-BKM-DNT-A08, tarih: 2026-09-02, mühür: VERIFIED, karar: kabul,
            kanıt: "urun/eklenti/sinama/paket-tazeligi.test.ts · üç ardışık koşu · 4/4 · 4/4 · 4/4",
            ne: "Duman sınamasındaki derleme çağrısı 2026-08-29 tarihinde kaldırıldı ve derleme süitin ön koşulu oldu; tazelik nöbeti bayat gövdede her koşumda kırmızı yanacak biçimde kuruldu ve üçüncü fikstür kararı iki yönde, üç ardışık çağrıda diske dokunmadan kanıtlıyor. Nöbet 2026-09-02 tarihinde salt okur olarak üç kez koşturuldu ve üçü de dört sınamayla yeşildir. Açık kalem yoktur." ),
          ne: "🕰️ Paket tazeliği nöbetinin kendi kanıtını yok etmekten vazgeçmesi. Süitin kararsız görünen tek nöbeti bulundu ve birebir üretildi: tazelik nöbeti derlenmiş gövdenin değişiklik zamanını tanı sicilinin kaynağıyla karşılaştırır, fakat süit betiği gövdeyi üretmez; buna karşılık paket girişi duman sınaması bir sınamanın içinde derleyiciyi çağırıp gövdeyi yeniden yazar. Dolayısıyla sicil düzenlendikten sonraki ilk koşum bayat gövdeyi görüp kırmızı yanar, aynı koşum yan etkiyle gövdeyi tazeler ve sonraki koşumlar yeşile döner. Nöbet ölçtüğü kusuru bir kez bildirir ve kanıtını kendi eliyle siler; adının yakalanamamasının sebebi budur. Bu bir zamanlama yarışı değil durum bağımlılığıdır ve altı kez aynı sonucu vermiştir. Süitin kendisi değiştirilmemiş ağaçta on iki koşumda on iki kez yeşildir; kararsızlık yalnız ilk koşumun ölçtüğü durumu onarmasından doğar." ) {
          görev: [
            "Süit betiğine derlemeyi ekle ya da duman sınamasındaki derleme çağrısını kaldırıp derlemeyi süitin ön koşulu yap; iki yol da nöbetin bir kez kırmızı yanıp sonra susmasını imkânsız kılar.",
            "Tazelik nöbetini, gövde bayatsa her koşumda kırmızı yanacak ve gövde tazelenmeden yeşile dönmeyecek biçimde kur; aynı nöbetin ikinci sınaması gövde içeriğini derleme sırasında okuyabildiği için yırtık okuma ihtimalini de kapat."
          ]
          kabul: [ "Sicil düzenlendikten sonra süit arka arkaya üç kez koşulduğunda üçü de aynı sonucu verir; bayat gövdeyle üçü de kırmızı, taze gövdeyle üçü de yeşildir ve bu fikstürle kanıtlanmıştır." ]
          sınır: "Nöbetin ölçtüğü şey (gövdenin sicilden eski olmaması) değişmez; yalnız ölçümün yan etkisi kaldırılır."
        }

        Adım( kod: BKM-DNT-A09, durum: tamamlandı, öncelik: p1, bağımlı: [], referans: [ YAS-4.1, ORK-6.1 ],
          üretir: [ KOD-SNM-ONAY-YUZEYLERI, KOD-SNM-POSTA, KOD-SNM-KABUK-DAVRANIS, KOD-SNM-KABUK-KUR, KOD-SNM-VSCODE-SAHTESI, KOD-SNM-DAVRANIS-NOBETI-VSCODE ],
          ne: "🛡️ Eklentinin editöre bakan yarısının davranış nöbeti kazanması. Elli altı kaynak dosyasının otuz dördü hiçbir sınama tarafından modül olarak yüklenmez ve ayrım keskindir: yüklenmeyen her dosya editör kabuğunu ithal eder ve süitte bir kabuk sahtesi yoktur; bu yarı yaklaşık yedi bin dört yüz satırdır ve en büyük üç yüzey dosyasını (yol haritası, onay kuyruğu, onaylar paneli) kapsar. Bedeli ölçülmüştür ve kuramsal değildir: onaylar panelinde boş gerekçeli kararı durduran dal kaldırıldığında süit yeşil kalmıştır, kapıya gitme satır çözümü sıfıra indirildiğinde yeşil kalmıştır, rozet koşulu tersine çevrildiğinde yeşil kalmıştır; hatırlatıcı sayacı iki katına çıkarıldığında ise tek koruma olan bayt özeti güncellenince süit yine yeşil kalmıştır. Bayt özeti bir davranış nöbeti değil değişiklik dedektörüdür ve deponun kendi yorumu özetin on iki kez 'bilerek güncellendiğini' yazar; tören hâline gelmiş bir dedektör hiçbir şeyi korumaz. Sınama kütlesinin beşte biri (bin beş yüz elli beş iddianın üç yüz elli dördü) kaynak metnini düzenli ifadeyle okur ve bu sınır dürüstçe yazılmıştır, fakat gerçek davranış hataları o sınırdan geçmektedir. Gerçek editör süiti bu boşluğu kapatabilecek tek yerdir ve bugün otuz dört dosyanın yalnız ikisine uğrar." ) {
          görev: [
            "Onaylar paneli, onay kuyruğu ve hatırlatıcılar için editör kabuğundan bağımsız bir davranış katmanı ayır ya da kabuk sahtesi kur; boş gerekçe dalı, kapıya gitme satırı, rozet koşulu ve hatırlatıcı sayacı ilk dört fikstürdür ve dördü de mutasyonla kanıtlanır.",
            "Bayt özeti nöbetini davranış nöbetine çevir ya da kaldır; özet güncelleme töreni sona erer.",
            "Gerçek editör süitini en büyük üç yüzey dosyasına genişlet; her dosya için en az bir davranış senaryosu editör kabuğunda koşar."
          ]
          kabul: [
            "Bugün hayatta kalan dört mutasyonun dördü de kırmızı verir ve bu, her biri için ayrı nöbetle kanıtlanmıştır.",
            "Bayt özeti nöbeti kalkmıştır ya da yalnız davranış nöbeti bulunmayan dosyalar için geçici olarak durur ve gerekçesi yazılıdır.",
            "Hiçbir sınama tarafından yüklenmeyen dosya sayısı ölçülmüş ve kayda yazılmıştır; sayı otuz dörtten düşmüştür ve düşüş dosya adıyla listelenmiştir."
          ]
          sınır: "Kaynak metnini okuyan iddialar kaldırılmaz; onlar bilinçli bir sınırdır ve davranış nöbeti gelene kadar yerinde kalır. Yol haritası dosyasının bin iki yüz satırı bu Adımın kapsamında değildir; o dosya kendi turunu ister."
          dokunulmaz: [ "Süit betiğinin sıfır bağımlılık sözleşmesi (STR-3.1)", "Kaynak metnini okuyan iddiaların dürüstlük notu" ]
          koşu:  Koşum( kod: KSM-BKM-DNT-A09, tarih: 2026-10-10, mühür: COMPLETED,
            kanıt: "işlemeler 98ce3f0, ea23947 ve 8f1378f · eklenti birim süiti 887 sınama, 0 düşen; çekirdek 1676/1676; iki pakette tür denetimi temiz · depo denetimi 0 hata · CI sürümü Node 24.21 ile birim süiti yeşil, deneysel API uyarısı yalnız standart hataya basılır · bağımsız inceleme dört mutasyonu tabanda ve dalda uyguladı: boş gerekçe dalı, kapıya git satırının sıfıra inmesi, rozet koşulunun terslenmesi ve hatırlatıcı sayacının iki katı tabanda birim süitinden sağ çıkıyordu, dalda her biri en az bir davranış sınamasını kırmızıya çevirir; sayaç mutasyonu bayt özeti kaldırıldıktan sonra davranış nöbetince tek başına yakalanır. BAYT ÖZETİ emekliye ayrıldı; yerine sayaç, rozet, boş durum cümlesi, yinelenen çizim güvencesi ve görünüş kimliği iki panel için ölçülür. Ağaç satırlarının etiketi ve simgesi, tür özeti, Fikir hanesi ve kopyalama menüsü artık hiçbir nöbetle korunmuyor; bu bilinçli bir açıktır. YÜKLENMEYEN DOSYA: bugünkü ağaçta 64 kaynak dosyanın 35'i hiçbir sınamada modül olarak yüklenmiyordu (plan metnindeki elli altıda otuz dört sayısı bayattır), dalda 23'e indi; düşen on iki dosya bicimlendir, bildirimler, hatirlaticilar, minigraf, nabiz, onay-kuyrugu, onay-paneli, onay-tarayici, ortak, taban-kanon, teknoloji-simgesi ve yolharitasi'dır; bunların dördü davranışla ölçülür, sekizi dolaylı yüklenir. GERÇEK EDİTÖR SÜİTİ: on altı kronik kırmızı bu işten önce de aynı adlarla vardı (karar komutu imzası değişmiş eski sınamalar); yeni üç senaryo yeşildir. Diskten gelen kapının panele inmemesi ürün kusuru değil, tek-agac süitinin odağı alt varlığa daraltıp bırakmasından doğan süitler arası sızıntıdır; sağlam çözüm o süitin sonunda odağı sıfırlamaktır.",
            ne:    "Eklentinin onay paneli, onay kuyruğu, Hatırlatıcılar ve Bildirimler yüzü bir kabuk sahtesiyle modül olarak yüklenip davranışla ölçülür hâle geldi; dört mutasyon artık kırmızı verir, bayt özeti töreni bitti ve gerçek editör süitine üç yüzey senaryosu eklendi." )
        }

        Adım( kod: BKM-DNT-A10, durum: tamamlandı, öncelik: p3, bağımlı: [], referans: [ YAS-4.1 ],
          üretir: [ KOD-SNM-ONAY-YUZEYLERI, KOD-SNM-POSTA ],
          koşu: Koşum( kod: KSM-BKM-DNT-A10, tarih: 2026-09-02, mühür: VERIFIED, karar: kabul,
            kanıt: "urun/eklenti/sinama/bicimle.test.ts · onay-yuzeyleri.test.ts · posta-kutusu.test.ts · 277/277 · üç mutasyonun her biri 1 kırmızı",
            ne: "Biçimleme süitine örnek rafı için kırk yedi dosyalık alt sınır iddiası, onay yüzeyleri süitindeki derin eşitliğin önüne üç kapılık doluluk iddiası kondu ve onaylar panelindeki totolojik iddia üç rolün karar kimliklerinin ayrıştığını ve taslak kimliğinin hiçbirine eşit olmadığını ölçen gerçek bir iddiayla değiştirildi. Üç mutasyon ayrı ayrı koşturuldu: raf beşe indirilince, kapı kümesi boşaltılınca ve rol ayrımı sökülünce ilgili nöbet kırmızı yandı; geri alınınca üç süit yeşile döndü." ),
          ne: "🔬 Üç küçük nöbet hijyeni. Birincisi, biçimleme süiti fikstür listesini örnek rafından diske bakarak doldurur ve her örnek için iki sınama üretir; listenin alt sınırını ölçen iddia olmadığı için raf boşalırsa süit sessizce onlarca sınama eksik koşar ve yine yeşil raporlar; beş yüz seksen bir sayısı bir sözleşme değil dosya sisteminin türevidir. İkincisi, onay yüzeyleri süitinde iki kod yolunun ürettiği kapı listeleri derin eşitlikle karşılaştırılır fakat dolu oldukları ölçülmez; iki yol da boş dizi döndürürse iddia geçer ve nöbet hiçbir şey ölçmemiş olur; aynı dosyanın başka yerlerinde bu tuzağa karşı açık doluluk iddiaları vardır, burada unutulmuştur. Üçüncüsü, onaylar paneli süitinde saf bir işlev aynı argümanlarla iki kez çağrılıp sonuçları karşılaştırılır; bu tanım gereği doğru bir totolojidir ve taranan bin beş yüz elli beş iddia içinde bulunan tek örnektir." ) {
          görev: [
            "Biçimleme süitine örnek sayısı için alt sınır iddiası ekle; sayı bugünkü kırk yedinin altına düşerse süit kırmızı yanar.",
            "Onay yüzeyleri süitindeki derin eşitlik iddiasının önüne doluluk iddiası koy.",
            "Totolojik iddiayı gerçek bir ölçümle değiştir ya da kaldır."
          ]
          kabul: [ "Üç nöbetin üçü de boş küme ya da eksik fikstür üstünde kırmızı yanar ve bu mutasyonla kanıtlanmıştır." ]
          sınır: "Yalnız bu üç iddia; süitin geri kalanı ölçülmüş ve klasik boş nöbet desenlerinden temiz çıkmıştır."
        }

        Adım( kod: BKM-DNT-A11, durum: tamamlandı, öncelik: p2, bağımlı: [ BKM-DNT-A01 ], referans: [ YUZ-3.1, YUZ-3.3 ],
          üretir: [ KOD-SNM-KAPI-KAPSAMI ],
          ne: "⚖️ Kanon ile ilanın uyumunu ölçen genel nöbet. Kapsam nöbeti bugün yalnız iki ad kümesinin eşitliğini ölçer: ilandaki üretici adları ile denetim hattının gerçekten çağırdığı üretici adları. Girdisinde ne tanı kimliği ne kanon maddesi ne yüzey adı vardır ve yüzey listesine hiç dokunmaz; bir girdinin yüzey listesi tümüyle silinmedikçe nöbet hiçbir yüzey değişikliğini görmez. Kanon ekseninde bugün var olan tek koruma, ateşlemiş hatırlatıcı için 2026-08-28 tarihinde yazılan iki iddiadır; genel bir kanon-ilan uyum nöbeti yoktur ve bugünkü sınıftan bir ayrışma onun altında sessizce yaşayabilir, nitekim on beş üreticide yaşamaktadır. Nöbet kurulabilir, çünkü kanonun zorlama satırındaki yüzey beyanı ile sicilin madde ve üretici eşlemesi makine-okurdur." ) {
          görev: [
            "Sicildeki her kimlik için kanon maddesinin zorlama satırındaki yüzey cümlesini oku, üreticisini bul, ilanın yüzey listesiyle karşılaştır; kanon Problems ya da Bildirimler diyorsa üretici panel yüzeyi taşımak zorundadır.",
            "Kanon 'Zorlanmaz' diyen ya da yüzey beyanı taşımayan maddeleri nöbetin dışında bırak ve dışarıda kalanları raporda say.",
            "Nöbeti BKM-DNT-A01 kararlarından sonra kur; kararlardan önce kurulursa on beş ayrışma yüzünden kırmızı doğar."
          ]
          kabul: [ "Nöbet kanon ile ilan arasındaki her yüzey ayrışmasını kimlik, madde ve üretici adıyla bildirir; bir üreticinin panel yüzeyi ilandan düşürüldüğünde ve kanon o yüzeyi istiyorsa süit kırmızıya döner, bu mutasyonla kanıtlanmıştır." ]
          sınır: "Nöbet karar vermez; ayrışmayı bildirir. Hangi tarafın değişeceği BKM-DNT-A01'in hükmüdür."
          koşu:  Koşum( kod: KSM-BKM-DNT-A11, tarih: 2026-10-10, mühür: COMPLETED,
            kanıt: "işleme 4b6b94e · çekirdek 1672/1672, tür denetimi temiz · depo denetimi 0 hata · bağımsız inceleme: bilgi kademeli projesizFazTanilari panelden düşürülünce 26 kapı kapsamı sınamasından yalnız bu nöbet kırmızıya döndü, A01 kademe nöbetleri yeşil kaldı; bilinen istisna silinince ve gerçekte ayrışmayan bir istisna eklenince iki yönde kırmızı ölçüldü; ad temelli çözüm 101 sahte ayrışma, modül ve içe aktarma çözümü 1 ayrışma verdi. Dışarıda kalan sayımlar: Zorlanmaz madde 62, yüzey beyansız çift 9, zorlama satırında anılmayan sicil kimliği 41, ilan modülü dışında basılan kimlik 15. BUGÜNKÜ AYRIŞMA: terfi-kanıtı-eksik · YAS-4.2 · terfiKanitiTanilari; kanon Problems ister, üretici terfi borcu yüzünden bilgi kademesinde ve yalnız komut satırında basar. Bilinen istisna olarak yazıldı ve HTR-TERFI-KANITI-YUZEY-AYRISMASI ile Founder kararına bağlandı. Bilinen kör nokta: Zorlanmaz ile başlayıp tanı ilan eden satırlar atlanır; bugün o açığı BKM-DNT-A02'nin ulaşma nöbeti kapatır.",
            ne:    "Kanonun Zorlama satırlarındaki yüzey beyanını ilanın panel yüzeyiyle karşılaştıran nöbet kuruldu; ayrışma kimlik, madde, üretici ve yüzeyle bildirilir ve bilinen istisna listesi iki yönde ölçülür. Tek gerçek ayrışma Founder kararına bağlandı." )
        }

        Adım( kod: BKM-DNT-A12, ad: "Paketleme Hijyeni", durum: tamamlandı, öncelik: p1, bağımlı: [],
          referans: [ YAS-4.1, HTR-SURUM-DAMGASI-TUZAGI, HTR-PAKETLEME-ATIF-NOBETINI-KIRIYOR ],
          üretir: [
            Kod( kod: KOD-SURUM-TAZELIGI, dosya: "urun/eklenti/src/surum-tazeligi.ts", ne: "🍎 Kurulu paket ile depo sürümünün karşılaştırılması — saf karar gövdesi; sayısal sürüm sıralaması sözlük tuzağını kapatır, mağaza kurulumunda susar ve yarım ölçümde hüküm vermez" ),
            Kod( kod: KOD-SNM-SURUM-TAZELIGI, dosya: "urun/eklenti/sinama/surum-tazeligi.test.ts", ne: "🍎 Sürüm damgası nöbeti — bayat kurulu paketin bildirildiği, mağaza kurulumunda susulduğu, depo geride ya da ölçülemez olduğunda hüküm verilmediği ve karşılaştırmanın sayısal olduğu ölçülür" )
          ],
          // ── 2026-09-10 · ÖLÇÜM (üretici · taze süreç) ──
          //   ATIF NÖBETİ: mekanizma kaynaktan değil CANLI olarak yeniden üretildi.
          //   Küçültülmüş bir üretim gövdesi geçici yola derlendi ve yedi kitaplığın
          //   YEDİSİNİN de yol izinin o gövdede BULUNMADIĞI ölçüldü; aynı izler
          //   geliştirme gövdesinde duruyor. Yani nöbet bugüne kadar kullanıcıya
          //   giden yapıyı hiç ölçmemiş, yalnız geliştirme gövdesini ölçmüştür.
          //   Onarım: her kitaplık küçültmeye dayanıklı bir imza listesi taşır ve
          //   imzaların üretim gövdesinde YAŞADIĞI tek tek doğrulandı. Yeni nöbet
          //   üretim gövdesini de ölçer ve nöbetin zeminini kendisi sınar: yol izi
          //   küçültülmüş gövdede DURUYORSA nöbet kırmızı yanar, çünkü o hâlde
          //   kusurun tarifi çürümüş demektir.
          //   SÜRÜM DAMGASI: karar gövdesi saf olarak yazıldı ve nöbetlendi.
          //   Sözlük sırası tuzağı özellikle kapatıldı, çünkü tuzağın doğduğu ölçek
          //   tam olarak budur: sözlükte "0.9.90" değeri "0.9.137" değerinden ileri
          //   sayılır ve nöbet sessizce yanlış tarafa düşerdi.
          //   AÇIK KALAN KALEM (dürüst beyan): ayrışmanın Bildirimler yüzeyine tek
          //   satır olarak BASILMASI bu turda yapılmadı. Sebep yapısaldır: o yüzeye
          //   basılan her kayıt kanonik bir tanı kimliği taşır (YuzeyKaydi bir Tani
          //   ister) ve yeni bir tanı kimliği sicil, üretici ve kanon maddesinden
          //   oluşan üçlü senkronu gerektirir; kanon maddesi yazmak ise hüküm
          //   niteliğinde bir değişikliktir ve Founder onayı ister. Karar gövdesi
          //   hazır ve nöbetlidir; yüzeye bağlanması bir kanon maddesiyle açılır.
          ne: "📦 Paketlemenin iki tuzağının tek turda kapatılması. Birincisi kurulu paketin bayatlığıdır: depoda taze paket üretilse bile editörde eski gövde koşmayı sürdürür ve panel bunu söylemez; Founder 2026-08-28 tarihinde sahte bir tanı uyarısını gerçek sanıp tur harcamıştır. İkincisi paketlemenin lisans atfı nöbetini kırmasıdır: küçültme kaynak yol izlerini sildiği için paketlemenin ardından koşan süit kırmızıya döner ve nöbet kullanıcıya giden gövdeyi hiç ölçmez; kusur 2026-08-31 tarihinde işleme kapısını fiilen bloke etmiştir. Mekanizmalar iki hatırlatıcıda kaynak satırıyla ölçülmüştür." ) {
          görev: [
            "Geliştirme çalışma alanında eklenti açılışında kurulu paketin sürümünü depodaki paket bildiriminin sürümüyle karşılaştıran bir duman nöbeti kur; ayrışma Bildirimler yüzeyinde tek satırla bildirilir ve mağazadan kurulan paketlerde nöbet susar.",
            "Atıf nöbetini iz sürmekten çıkarıp kitaplığın gövdedeki varlığını küçültmeye dayanıklı bir imzayla ölçer hâle getir; nöbet üretim gövdesini de ölçer ve paketlemenin hemen ardından yeşil kalır.",
            "İki davranışı mutasyonla kanıtla: bayat sürüm fikstürü uyarı üretir, kitaplığı düşürülmüş üretim gövdesi nöbeti kırmızıya çevirir."
          ]
          kabul: [
            "Depodaki sürüm kurulu paketten ileri olduğunda panel bunu söyler; mağaza kurulumunda hiçbir uyarı doğmaz.",
            "Paketlemenin hemen ardından koşan eklenti süiti yeşildir ve atıf nöbeti üretim gövdesini ölçer; bu mutasyonla kanıtlanmıştır.",
            "Eklenti süiti yeşildir; depo denetimi sıfır hata ve sıfır uyarı verir."
          ]
          sınır: "Sürüm numarasını ilerletme kuralı ve CHANGELOG nöbeti değişmez; paketleme akışının kendisi yeniden yazılmaz."
          koşu: "2026-09-10 · KAPANDI. Kabul ölçütü CANLI kanıtlandı: eklenti üretim kipinde paketlendi ve hemen ardından süit koşuldu, yedi yüz beşte yedi yüz beş yeşil çıktı; ardından geliştirme gövdesi geri derlendi ve orada da yedi yüz beşte yedi yüz beş yeşil kaldı, yani nöbet iki kipte de doğru çalışıyor. Bu, hatırlatıcının doğduğu tuzağın kapandığı andır, çünkü daha önce paketlemenin ardından koşan süit kırmızı yanıyordu. Birinci tuzak için ölçüm şudur: küçültülmüş bir üretim gövdesi derlenip bakıldığında yedi kitaplığın YEDİSİNİN de yol izi o gövdede yoktur, aynı izler geliştirme gövdesinde vardır; yani atıf nöbeti bugüne kadar kullanıcıya giden yapıyı hiç ölçmemiştir. Her kitaplık için küçültmeye dayanıklı imza türetildi ve yeni nöbet kendi zeminini de sınıyor, çünkü yol izi küçültülmüş gövdede durursa kırmızı yanıyor ve bu, kusurun tarifinin çürüdüğü anlamına geliyor. İkinci tuzak için sürüm karşılaştırması saf bir gövde olarak yazıldı ve sözlük sırası tuzağı özellikle kapatıldı, çünkü tuzağın doğduğu ölçek tam olarak orasıdır ve sözlükte dokuzuncu alt sürüm yüz otuz yedinciden ileri sayılmaktadır. YOLDA ÜÇÜNCÜ BİR KUSUR bulundu ve aynı sınıftandır: paket girişi duman sınaması sahte düzenleyici nesnesinin anahtarlarını gövde metninden sabit bir ad arayarak çıkarıyordu, küçültme ad alanını yeniden adlandırdığı için desen hiçbir ada denk gelmiyor ve paketleme sonrası ilk koşum kurucu bulunamadı hatasıyla düşüyordu; ad alanı değişkeninin adı artık gövdeden çıkarılıyor ve bu, süitin paketleme sonrası yeşil kalmasının ikinci şartıydı. Bağımsız kabul denetimi kontrolcü tarafından koşuldu: iki tür denetimi sıfır hata, proje denetimi sıfır hata, çekirdek süiti bin iki yüz seksen beşte bin iki yüz seksen beş, eklenti süiti yedi yüz beşte yedi yüz beş; üç mutasyonun üçü de kırmızıya düştü. AÇIK KALAN TEK KALEM dürüstçe beyan edilir: ayrışmanın Bildirimler yüzeyine tek satır olarak basılması yapılmadı, çünkü o yüzeye basılan her kayıt kanonik bir tanı kimliği taşımakta ve yeni bir tanı kimliği sicil, üretici ve kanon maddesinden oluşan üçlü senkronu gerektirmektedir; kanon maddesi yazmak hüküm niteliğinde bir değişikliktir ve Founder onayı ister. Karar gövdesi hazırdır ve nöbetlidir; yüzeye bağlanması tek bir kanon maddesiyle açılır."
        }

        Adım( kod: BKM-DNT-A13, ad: "Kap İddiası Kalıbının Öteki Yüzeylerden Sökülmesi", durum: tamamlandı, öncelik: p1, bağımlı: [],
          referans: [ HTR-OLCMEDEN-KAP-IDDIASI-BASKA-YUZEYDE ],
          üretir: [
            Kod( kod: KOD-SNM-KAP-IDDIASI, dosya: "urun/cekirdek/sinama/olcmeden-kap-iddiasi.test.ts", ne: "🍎 Ölçmeden kap iddiası nöbeti — iskelet aracının olmayan yol ile dosya yolunda iddia kurmadığı, gerçek girişsiz dizinde kurmaya devam ettiği ve dış giriş bayrağının dizin alınca çökmeyip dürüst tanı döndürdüğü ölçülür" )
          ],
          // ── 2026-09-10 · ÖLÇÜM (üretici · taze süreç) ──
          //   Üç kalemin üçü de canlı olarak yeniden üretildi. ① İskelet aracı hem
          //   `/tmp/kesinlikle-yok-boyle-dizin-12345` yolunda hem de bir DOSYA
          //   yolunda "içinde giriş dosyası yok" cümlesini basıyordu; ölçüm artık
          //   önce yapılıyor ve üç durum kendi cümlesini alıyor. ② Dış giriş
          //   bayrağı `--ana` ile var olmayan bir yol verildiğinde cümle doğruydu
          //   fakat öneri "var olan bir proje DİZİNİ ver" diyordu ve bayrağın adını
          //   hiç anmıyordu; kullanıcı kendi komutunu önerinin içinde bulamıyordu.
          //   Aynı bayrağa bir DİZİN verildiğinde ise motor ham bir okuma hatasıyla
          //   çöküyor ve yığın izini kullanıcının yüzüne döküyordu; bu, hatırlatıcının
          //   tarif ettiğinden daha ağır bir kusurdu ve ölçüm sırasında bulundu.
          //   ③ İngilizce cümleyi eski kap iddiasına döndüren mutasyon artık
          //   kapıdan geçemiyor: çeviri nöbeti anahtar eşliğinden iddia düzeyine
          //   yükseltildi ve cümlenin NE İDDİA ETTİĞİNİ ölçüyor. Nöbetin körlük
          //   sınavı da yazıldı: gerçekten girişsiz bir dizinde iddia KURULMAK
          //   zorundadır, yoksa bütün cümleleri boşaltmak da nöbeti yeşil bırakırdı.
          ne: "🧰 Ölçmeden kap iddiası kuran kalıbın denetim komutu dışındaki üç yüzeyden sökülmesi: iskelet aracı verilen yolun bir kap olup olmadığını ölçmeden içinde giriş dosyası yok cümlesini basar; dış şema bayrağıyla var olmayan yol verildiğinde hiçbir nöbet yolu ölçmez ve öneri kullanıcının kullandığı bayrağı anmaz; İngilizce tanı cümlesini eski kap iddiasına döndüren mutasyon kapıdan yeşil geçer. Üç kalem aynı kusur sınıfının yüzleridir ve 2026-08-09 tarihinde bağımsız denetçi tarafından ölçülmüştür." ) {
          görev: [
            "İskelet aracına yolun varlığı ile kap olup olmadığı ölçümünü koy; olmayan yol ile dosya yolu için ayrı ve doğru cümle bas.",
            "Dış şema bayrağının yol ölçümünü nöbete bağla ve öneriyi kullanıcının fiilen kullandığı bayrağı anacak biçimde yaz.",
            "Çeviri nöbetini yalnız anahtar ile alan eşliğinden çıkarıp iddia düzeyine yükselt: İngilizce cümle kap iddiasına dönerse süit kırmızı yanar; mutasyonla kanıtla."
          ]
          kabul: [
            "İskelet aracı olmayan yolda ve dosya yolunda kap iddiası kurmaz; iki fikstürle kanıtlanmıştır.",
            "Dış şema bayrağı olmayan yolda dürüst hata döner ve öneri doğru bayrağı anar.",
            "İngilizce kap iddiası mutasyonu kapıdan geçemez; çekirdek süiti yeşildir."
          ]
          sınır: "Denetim komutunun V1B-TANI-A01 ile kapanmış onarımına dokunulmaz."
          koşu: "2026-09-10 · KAPANDI. Üç kalemin üçü de ölçülüp kapandı. İskelet aracı hem var olmayan bir yolda hem de bir dosya yolunda içinde giriş dosyası yok diyordu; ölçüm artık iddiadan ÖNCE yapılmakta ve üç durum kendi doğru cümlesini almaktadır. Ölçüm yeniden yazılmadı, denetim komutundaki yol türü ölçücüsü dışa açıldı ve iki yüz aynı kaynaktan okuyor. Dış şema bayrağının önerisi bayrağın adını hiç anmıyordu ve artık iki dilde de anıyor. Çeviri nöbeti anahtar eşliğinden iddia düzeyine yükseltildi; bu, hatırlatıcının en önemli kalemiydi, çünkü İngilizce cümleyi eski kap iddiasına döndüren mutasyon eskiden kapıdan yeşil geçiyordu. KAYITTA OLMAYAN DAHA AĞIR BİR KUSUR ölçülüp onarıldı: dış şema bayrağına bir DİZİN verildiğinde motor ham bir okuma hatasıyla çöküyor ve çalışma ortamının yığın izini kullanıcının yüzüne döküyordu; sebep kapının yalnız varlığı ölçüp cinsi ölçmemesiydi, çünkü bir dizin de var olduğu için kapıdan geçiyor ve birkaç satır sonra dosya gibi okunmaya çalışılıyordu. Kontrolcü bunu bağımsız olarak sınadı ve artık dizin verildiğinde de var olmayan yol verildiğinde de dürüst bir tanı dönüyor, yığın izi yok. Nöbetlere körlük sınavı da kondu: gerçekten girişsiz bir dizinde cümlenin iddiayı KURMASI şart, yoksa nöbet bütün cümleleri boşaltmakla da yeşil kalırdı. Bağımsız kabul denetimi kontrolcü tarafından koşuldu: iki tür denetimi sıfır hata, proje denetimi sıfır hata, çekirdek süiti bin iki yüz seksen beşte bin iki yüz seksen beş, eklenti süiti altı yüz doksan yedide altı yüz doksan yedi; üç mutasyonun üçü de kırmızıya düştü."
        }

        Adım( kod: BKM-DNT-A14, ad: "Sınama Sonucunun Yüzeye İnmesi", durum: beklemede, onay: "onaylandı — 2026-09-10 · ŞERH 2026-10-10 · FOUNDER (karar sayfası): Founder beş karar vermiştir: sınama sonucu Bildirimler yüzeyinde ayrı bir grup olarak görünür; birim süiti her işlemede, gerçek kabuk süiti sürekli tümleştirmede koşar; yüzey son raporu tarihiyle gösterir ve rapor bayatsa bunu söyler; sonuç süitin ürettiği makine okunur rapor dosyasından okunur; gerçek kabuk süiti her birleştirme isteğinde sürekli tümleştirmede koşar. Gerekçe, yeni panel açmadan görünürlük sağlanması, rapor dosyasının koşum aracının çıktı biçiminden dayanıklı olması ve iki dakikalık süitin her işlemeyi yavaşlatmamasıdır.", öncelik: p1, bağımlı: [],
          referans: [ YUZ-3.3, HTR-SINAMA-SONUCU-YUZEYSIZ ],
          ne: "🧪 Kırmızı yanan bir nöbetin yalnız uçbirimde yaşaması kusurunun kapatılması. Founder 2026-08-31 tarihinde sorduğunda ölçülmüştür: paneller denetim turundan beslenir, süit ayrı bir dünyadır ve sonucunu hiçbir yüzeye taşıyan gövde yoktur; gerçek kabuk süiti on beş kırmızı taşımakta ve hiçbir kapıda koşmamaktadır, çünkü 2026-09-03 tarihinde kurulan sürekli tümleştirme akışı yalnız birim süitlerini koşturur. Beş karar kalemi HTR-SINAMA-SONUCU-YUZEYSIZ kaydındadır ve Founder ayrıntılı değerlendirme istemiştir." ) {
          görev: [
            "Beş kalemi Founder ile kararlaştır: sonucun yüzeyi, hangi süitin besleneceği, tazeleme anı, sonucun nereden okunacağı ve gerçek kabuk süitinin hangi kapıda koşacağı.",
            "Gerçek kabuk süitinin on beş kırmızısını dört aile hâlinde kapat ve süiti kararlaştırılan kapıya bağla; hiçbir kapıda koşmayan süit kalmaz.",
            "Kararlaştırılan yüzeyi kur: süit makine okunur bir rapor üretir, yüzey o raporu okur ve bayat raporu tarihini söyleyerek gösterir."
          ]
          kabul: [
            "Gerçek kabuk süiti yeşildir ve bir kapıda koşar; bu kapı sürekli tümleştirme akışında ya da işleme kancasında görünür.",
            "Kırmızı bir nöbet kararlaştırılan yüzeyde görünür ve Founder canlı pencerede gözle doğrular.",
            "Depo denetimi sıfır hata ve sıfır uyarı verir."
          ]
          sınır: "Kaydetme anında süit koşturulmaz; performans mevsiminin kazanımı geri verilmez."
        }
      }
    }


    // ══ KATMAN · FOUNDER: kod-dışı operasyonel kalemler (insan eylemi/kararı) ═══════
