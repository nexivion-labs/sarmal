  # 🎨 Vitrin Yüzleri + UI Hükümleri — YUZ-3 · YUZ-3.1

  ## Amaç
  🎯 Sarmal'ın dışa görünen yüzünü karar-kilitli kalemlerle parlatmak: plan durumu tek
  bakışta okunur (renk rozetleri · build karnesi), değişikliğin etkisi motordan sorulur
  (`sarmal etki <KOD>`), editör hissiyatı Founder hükümleriyle hizalanır (nabız · ünlem ·
  gövde-tonu tiki).

  ## Kapsam
  📦 YUZ-3 maddesinin 4 vitrin kalemi ile YUZ-3.1 maddesinin 3 UI hükmü. Dokunulan yüzeyler: eklenti/src
  (yolharitasi · satirici · bicimle · renk) + cekirdek/src (sarmal CLI · yazdir · yeni
  etki.ts). Kapsam dışı: ŞEF orkestrasyon motoru (sef_halka.sar) ve eklenti performans
  kalemleri (eklenti/plan.sar EKL-F9).

  ## Sonuç
  ✅ Panel/satır rozetleri dört durumu renkle konuşur, denetle sonu karne basar,
  `sarmal etki <KOD>` bir düğümün besleme zincirini gösterir, hata lensi nabız atar,
  Hatırlatıcı ünlemle yaşar ve karara bağlanınca zincire girer, Blok tiki gövde tonuyla
  ayrışır. Kabul: denetle-temiz + eklenti sınamaları yeşil + gerçek-VSCode gözle teyit.
|<--

Blok( kod: BLK-VITRIN, ad: "vitrin arayüzü", uygular: ORK-7,
  ne: "YUZ-3 vitrin yüzleri + YUZ-3.1 Founder UI hükümleri — dışa görünen yüz ve editör hissiyatı" ) {

  // ══ KATMAN · YUZ-3 VİTRİN: dış gözden geçirmenin vitrin kalemleri ═══════════════
  Katman( kod: VIT-K77, kullanır: TAKIM-EKLENTI, ad: "vitrin yüzleri",
    ne: "🪟 YUZ-3 vitrin kalemleri — durum rozetleri · build karnesi · etki-analizi yüzü · hizalama standardı" ) {
    // Katı rejim yerleşimi (proje-kod turu 2026-07-31): dört tamamlanmış Adım
    // departman taşıyan AltKatman'a alındı; iş ve kapanış kayıtları AYNEN korunur.
    AltKatman( kod: VIT-K77-AK1, departman: kodlama, ad: "vitrin kodlaması",
      ne: "vitrin kalemlerinin eklenti kod işleri" ) {

    Adım( kod: VIT-K77-A01, durum: tamamlandı, üretir: [ KOD-YOLHARITA ], bağımlı: [],
      ne:    "🟢 Durum renk rozetleri — dört durum (tamamlandı🟢 · geliştirmede🟡 · beklemede🔵 · bloklu⛔) panelde ve satırda TEK renk diliyle konuşur (YUZ-4.1)" ) {
      görev: "eklenti yolharitasi.ts + satır dekorasyonlarında Adım durumunu dört-renk rozet standardına bağla: tamamlandı=yeşil🟢, geliştirmede=sarı🟡, beklemede=mavi🔵, bloklu=kırmızı⛔. Renkler kanondan (kayit.json rozet renkleri — YUZ-4.1 tek-kaynak, elle hex yasak); mevcut bloklu-kırmızı (HALKA-SENK-A01) bu standarda katılır"
      kabul: [
        "dört durum panelde ve satır rozetinde ayrı renkle görünür; renk kaynağı kanon (elle hex yok)",
        "durum değişince rozet canlı güncellenir (mevcut watch)",
        "eklenti sınaması yeşil + gerçek-VSCode gözle teyit"
      ]
      referans: [ SNF-0 ]
      sınır:    "yalnız rozet/renk standardı — durum YAZIMI SENK-A05/IZLE-A02 işi; Blok tiki VIT-K78-A03'te"
    }
    Adım( kod: VIT-K77-A02, durum: tamamlandı, üretir: [ KOD-YAZDIR ], bağımlı: [],
      ne:    "📋 Build-sonu karnesi — denetle koşusu sonunda tek-bakış karne: hata/uyarı sayısı · ağaç sağlığı · tamamlanma oranı · en riskli dosyalar (YUZ-3)" ) {
      görev: "cekirdek denetle çıkışına karne bölümü ekle (sarmal.ts denetleKomutu + yazdir.ts): toplam düğüm/Adım sayısı, durum dağılımı (🟢🟡🔵⛔ adetleri), hata/uyarı özeti, en çok tanı üreten ilk 3 dosya. Karne SAF veri üzerinden render edilir (mevcut tanı toplama yeniden kullanılır, yeni tarama yok)"
      kabul: [
        "denetle sonunda karne basılır: durum dağılımı + tanı özeti + riskli dosyalar",
        "TAM-yeşil koşuda karne sade tek-satır kutlama verir (gürültü yok)",
        "denetle-temiz + çekirdek testleri yeşil"
      ]
      sınır: "yalnız çıktı-sonu özeti — tanı ÜRETİMİ değişmez; JSON/makine yüzü Prizma işi, karne insan yüzü"
    }
    Adım( kod: VIT-K77-A03, durum: tamamlandı, üretir: KOD-ETKI-YUZ,
      ne:    "💥 Etki-analizi yüzü — `sarmal etki <KOD>`: bu düğüme dokunursam ne etkilenir? DAG ters-türetmesinden besleme zinciri (YUZ-3)" ) {
      görev: "yeni cekirdek/src/etki.ts (agac.ts yüz-deseni: SAF üretici + CLI kabuğu): verilen KOD'un DAG üzerindeki İLERİ kapanışını (bu düğümü bekleyen tüm ardıllar — dag.ts ters-türetme A02 + topolojik sıra A03 yeniden kullanılır) ağaç görünümünde bas: doğrudan ardıllar → geçişli ardıllar, durum rozetleriyle. sarmal.ts'e `sarmal etki <KOD> <dizin>` komutu"
      kabul: [
        "sarmal etki <KOD> doğrudan+geçişli ardılları topolojik sırada, durum rozetli basar",
        "kenarsız düğümde dürüst mesaj: 'bu düğümü bekleyen yok' (boş ≠ hata)",
        "etki üretici SAF + birim-testli; denetle-temiz"
      ]
      bağımlı: []
      sınır:   "yalnız DETERMİNİSTİK etki listesi (STR-3 AÇIK: I/O-şekli) — 'riskli mi' skorlaması GİZLİ politika, burada yok; tamamlanmış öncülleri zincir halkasıydı, o tur kapandı ve arşivdedir"
    }
    Adım( kod: VIT-K77-A04, durum: tamamlandı, üretir: [ KOD-EKL-BICIMLENDIR ], bağımlı: [],
      ne:    "📐 İki-nokta hizalama standardı — biçimlendirici `kod:` / `ne:` / `durum:` anahtarlarının iki-noktasını blok içinde hizalar (YUZ-3 okunabilirlik standardı)" ) {
      görev: "eklenti bicimle.ts'e iki-nokta hizalama geçişi ekle: aynı çok-satırlı bildirimin parametre satırlarında anahtar adları sola dayalı, değerler iki-nokta sonrası TEK hizada başlar (kanondaki iki-nokta hizalama standardı). basKapaticiSay dedent düzeltmesi (oturum 27) korunur; hizalama opsiyonel değil, biçimlendiricinin varsayılanı"
      kabul: [
        "çok-satırlı bildirim parametreleri iki-nokta sonrası tek hizada; 84+ biçimlendirici testi yeşil (regresyon yok)",
        "tek-satır bildirimler dokunulmaz (kısa liste toplanmaz kuralı korunur)",
        "idempotent: iki kez biçimle = aynı çıktı (testli)"
      ]
      sınır: "yalnız biçimlendirici hizalaması — sözdizimi/gramer değişmez; word-wrap sınırı (oturum 27 hükmü) aynen kalır"
    }
    }
  }

  // ══ KATMAN · YUZ-3.1 UI HÜKÜMLERİ: Founder'ın üç editör hissiyat hükmü ════════════
  Katman( kod: VIT-K78, kullanır: TAKIM-EKLENTI, ad: "arayüz hükümleri",
    ne: "🖋️ YUZ-3.1 Founder hükümleri — hata lensi NABIZ · Hatırlatıcı ÜNLEM + yaşam döngüsü · Blok tamamlanma tiki gövde-tonu" ) {
