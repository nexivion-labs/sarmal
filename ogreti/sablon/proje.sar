// REJİM — zorunlu beyandır, sessiz varsayılan yoktur (YAS-1). `katı` normdur:
// her Katman ile Adım arasında departman taşıyan bir AltKatman yaşar ve kademe
// atlanmaz. `esnek` bilinçli istisnadır (tek kişilik deneme, küçük öğretim
// örneği); esnek seçersen gerekçesini bu satırın yanına yaz.
Proje( kod: PRJ-Ornek, ad: "ornek-uygulama", rejim: katı, ne: "<tek cümle: bu proje ne yapar>" ) {

  // ① TEKNOLOJİ — her şeyin abisi (ORK-2.4: Katman teknolojiye bağlanmadan iş
  //    dalı doğmaz). AŞAĞIDAKİ YIĞIN YALNIZCA ÖRNEKTİR ve hiçbir projenin
  //    varsayılanı değildir; kendi projende kendi teknolojilerini ilan edersin.
  //    İlansız KOD kırık-referanstır (DIL-1.4; A3 tuzağı): Takım'ın bağımlı listesindeki
  //    her üye çözülen bir Teknoloji ilanına işaret etmeli.
  Teknoloji( kod: FLUTTER, ne: "önyüz çerçevesi — tek kod-tabanı, çok platform" )
  Teknoloji( kod: BLOC, ne: "önyüz durum yönetimi" )
  Teknoloji( kod: GOROUTER, ne: "önyüz yönlendirme (route)" )
  Teknoloji( kod: FASTAPI, ne: "arkayüz web çerçevesi" )
  Teknoloji( kod: POSTGRES, ne: "ilişkisel veritabanı" )
  Takım( kod: TAKIM-ONYUZ, ne: "önyüz yığını", bağımlı: [ FLUTTER, BLOC, GOROUTER ] )
  Takım( kod: TAKIM-ARKAYUZ, ne: "arkayüz yığını", bağımlı: [ FASTAPI, POSTGRES ] )

  // ② MİMARİ — klasör ağacı (Kitaplık/Raf + yol: · MIM-3 Yapı-Önce). İlan edilen her
  //    yol diske iner (sarmal <ana.sar> --iskelet <hedef>); makine sonra TAKİP eder.
  Kitaplık( kod: KTP-TABAN, yol: "taban/", ne: "ortak zemin — tüm ağaçların paylaştığı" ) {
    Raf( kod: RAF-SOZLESME, yol: "sozlesmeler/", ne: "Sözleşme — FE↔BE ORTAK DİLİ (contract-first · rayın kökü)" )
    Raf( kod: RAF-KIMLIK, yol: "kimlik/", ne: "tek giriş/auth zemini (çok-uygulama tek-auth · varsa)" )
  }
  Kitaplık( kod: KTP-ONYUZ, yol: "onyuz/", ne: "önyüz ağacı — TAKIM-ONYUZ üretir (Ekran→Yığın→...)" )
  Kitaplık( kod: KTP-ARKAYUZ, yol: "arkayuz/", ne: "arkayüz ağacı — TAKIM-ARKAYUZ üretir (Servis→Uç→Sözleşme)" )
  Raf( kod: RAF-PLAN, yol: "plan/", ne: "plan ağacı — Faz→Blok→Katman→AltKatman→Adım AYRI .sar'da (MIM-1)" )
}

// ③ PLAN — anadizinde DEĞİL, plan/ altında AYRI .sar'da (ör. plan/mvp_plani.sar).
//    Blok = DİKEY DİLİM: önyüz + arkayüz + güvenlik BİRLİKTE (silo değil · MIM-1.3 · TIP-1.4);
//    Blok bunları KAVUŞTURUR (Ekran →çağırır→ Uç →sözleşme→ Sözleşme · ORK-2.3):
//
//    Faz( kod: FAZ-MVP, ad: "İlk Sürüm Mevsimi", hedefTarih: "2027-06-30" ) {
//      Blok( kod: BLK-Ornek, ad: "<Blokun Adı>", ne: "<bir özelliği baştan sona kesen dikey dilim>" ) {
//        Katman( kod: KAT-Onyuz, ad: "Ön Yüz", kullanır: TAKIM-ONYUZ ) {
//          AltKatman( kod: ALT-Onyuz, ad: "<Departman Modülü>", departman: kodlama ) {
//            Adım( kod: ADM-01, ad: "<kısa-ad>", görev: "<DETAYLI niyet>", kabul: [ "<ölçüt>" ], durum: beklemede )
//          }
//        }
//        Katman( kod: KAT-Arkayuz, ad: "Arka Yüz", kullanır: TAKIM-ARKAYUZ ) {
//          AltKatman( kod: ALT-Arkayuz, ad: "<Departman Modülü>", departman: kodlama ) {
//            Adım( kod: ADM-02, ad: "<kısa-ad>", görev: "<niyet>", durum: beklemede )
//          }
//        }
//        // KAVUŞUM: Adım üretir Ekran/Uç; Ekran çağırır Uç; Uç bağlanır Sözleşme (SZL-…)
//      }
//    }
//    Sonraki fazlarda AYNI Blok sürer (MIM-1.3 süreklilik): Faz( FAZ-V1 ) { çağır BLK-Ornek }
