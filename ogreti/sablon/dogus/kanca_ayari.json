{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/kanca/dogus-kilidi.mjs"],
            "timeout": 15,
            "statusMessage": "Doğuş kilidi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/kanca/denetim-kapisi.mjs"],
            "timeout": 90,
            "statusMessage": "Sarmal denetim kapısı"
          }
        ]
      }
    ]
  }
}
