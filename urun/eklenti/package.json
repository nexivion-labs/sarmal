{
  "name": "sarmal",
  "displayName": "%sarmal.displayName%",
  "description": "%sarmal.description%",
  "version": "0.9.173",
  "publisher": "nexivion-labs",
  "license": "Apache-2.0",
  "icon": "ikonlar/sarmal-ikon.png",
  "keywords": [
    "sarmal",
    "sar",
    "türkçe",
    "declarative",
    "widget tree",
    "drift",
    "orkestrasyon",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nexivion-labs/sarmal"
  },
  "bugs": {
    "url": "https://github.com/nexivion-labs/sarmal/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/eklenti.js",
  "contributes": {
    "languages": [
      {
        "id": "sarmal",
        "aliases": [
          "Sarmal",
          "sar"
        ],
        "extensions": [
          ".sar"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./ikonlar/sarmal.svg",
          "dark": "./ikonlar/sarmal.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sarmal",
        "scopeName": "source.sar",
        "path": "./syntaxes/sarmal.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.python": "python",
          "meta.embedded.block.dart": "dart",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "sarmal",
        "path": "./snippets/sarmal.code-snippets"
      }
    ],
    "semanticTokenTypes": [
      {
