{
  "manifest_version": "0.3",
  "name": "@sarmal/cekirdek",
  "display_name": "Sarmal",
  "version": "0.16.0",
  "description": "Sarmal's MCP server: eighteen tools that read a project's plan, canon, type system and drift audit straight from its .sar source, so an agent asks the graph instead of grepping files.",
  "author": {
    "name": "Nexivion Labs",
    "url": "https://github.com/nexivion-labs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nexivion-labs/sarmal"
  },
  "homepage": "https://github.com/nexivion-labs/sarmal",
  "documentation": "https://github.com/nexivion-labs/sarmal/blob/main/README.en.md",
  "license": "Apache-2.0",
  "icon": "sarmal-ikon.png",
  "privacy_policies": [
    "https://github.com/nexivion-labs/sarmal/blob/main/PRIVACY.md"
  ],
  "keywords": [
    "sarmal",
    "sar",
    "türkçe",
    "declarative",
    "widget tree",
    "drift",
    "ai"
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=23.6"
    }
  },
  "server": {
    "type": "node",
    "entry_point": "src/mcp.ts",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/src/mcp.ts"
      ],
      "env": {}
    }
  }
}
