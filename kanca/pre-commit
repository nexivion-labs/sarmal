#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# kanca/pre-commit — 🚪 SARMAL COMMIT-KAPISI (HTR-COMMIT-KAPISI)
#
#   ÇEKİRDEK (evrensel · şimdi): `sarmal denetle` = drift-gate. Hata → BLOK,
#   uyarı → GEÇ (denetle exit: hata>0 ise 4, yoksa 0 — satır 383). Drift TARİHE GİRMEZ.
#   ARIZA-GÜVENLİ: node/motor yoksa ATLAR (commit'i kilitlemez).
#   Bilinçli atlamak için:  git commit --no-verify
#
#   PROJE-ÖZEL KURALLAR (branch·commit-msg·gizli-tarama·iki-kademe) İLERİDE:
#   kapı, varsa `kanca/proje-kurallari.sh`'i çalıştırır — içi sonra dolar
#   (Founder: "git kuralları proje-özel tanımlanabilir olmalı"). Kapı ince kalır.
# ═══════════════════════════════════════════════════════════════════════════

# — ⓪ DEPO KÖKÜ VE VARLIK: yol tahmin edilmez, ÖLÇÜLÜR (GOC-A03) —
#   Bu kanca eskiden hem `core.hooksPath` ayarında hem kendi gövdesinde mutlak ve
#   ada gömülü yollar taşıyordu. Kırılganlığı sessizliğindeydi: klasörün adı ya da
#   yeri değiştiği an git kancayı hiç bulamaz, hiçbir hata basmaz ve bütün kapılar
#   sessizce açık kalır. Artık depo kökü git'in kendisine sorulur ve açık aracın
#   gövdesi motoru taşıyan dizin aranarak bulunur; dolayısıyla varlık klasörünün
#   adı değişse de, gövde kendi deposunun köküne çıksa da kapı yerini bulur.
KOK=$(git rev-parse --show-toplevel 2>/dev/null) \
  || { echo "🚪 sarmal-kapı: depo kökü okunamadı → atlandı"; exit 0; }
cd "$KOK" || { echo "🚪 sarmal-kapı: depo köküne inilemedi → atlandı"; exit 0; }

VARLIK=""
for aday in . */; do
  aday="${aday%/}"
  [ -f "$aday/urun/cekirdek/src/sarmal.ts" ] && { VARLIK="$aday"; break; }
done
[ -n "$VARLIK" ] || { echo "🚪 sarmal-kapı: motor bulunamadı → atlandı"; exit 0; }
MOTOR="$VARLIK/urun/cekirdek/src/sarmal.ts"
# Sahnelenen yollar depo köküne göredir; gövde kökte yaşıyorsa önek boş kalır.
[ "$VARLIK" = "." ] && ONEK="" || ONEK="$VARLIK/"

# — arıza-güvenli: önkoşul yoksa sessizce atla (geliştiriciyi kilitleme) —
command -v node >/dev/null 2>&1 || { echo "🚪 sarmal-kapı: node yok → atlandı"; exit 0; }

# — ① ÇEKİRDEK drift-gate: açık araç temiz mi? (aktif varlık; kapalı ürün ileride) —
if ! node "$MOTOR" denetle "$VARLIK" >/tmp/sarmal-kapi.log 2>&1; then
  echo "✖ sarmal-kapı: DRİFT — commit bloklandı (hata var):"
  echo "─────────────────────────────────────────────"
  tail -15 /tmp/sarmal-kapi.log
  echo "─────────────────────────────────────────────"
  echo "  → düzelt, ya da bilinçliyse:  git commit --no-verify"
  exit 1
fi

# — ①·a DOSYA MÜHRÜ OLAYI (KPS-MHR-A01 · MIM-3.4 · Founder hükmü 2026-09-11) —
#   Bir dosyanın mühürlenmesi işleme kapısında GÖRÜNÜR bir olaydır. Bu işleme bir
#   `.sar` dosyasını adının başına yazılan arşiv, eğitim ya da sonra mührüyle
#   canlı kaynaktan ayırıyorsa kapı onu adıyla basar. Kapı işlemeyi DURDURMAZ,
#   çünkü mühür dosya sahibinin meşru beyanıdır; yalnız sessiz kalmasını engeller.
#   Mührün tanınması motorun tek çözücüsündedir; buradaki desen yalnız sahnelenen
#   yeni adları süzer ve hüküm vermez: geçersiz etiketi motorun denetimi bildirir.
MUHURLER=$(git diff --cached --name-status -M --diff-filter=AR 2>/dev/null \
  | awk -F'\t' '{print $NF}' | grep -E '(^|/)@[A-Z]+@_[^/]*\.sar$')
if [ -n "$MUHURLER" ]; then
  echo "📛 sarmal-kapı: bu işleme şu dosyaları mühürlüyor (MIM-3.4):"
  printf '%s\n' "$MUHURLER" | sed 's/^/   • /'
fi

# — ①·b YÖNERGE İKİZİ NÖBETİ (KYN-MTR-A02 · YUZ-1.2) —
#   Kökteki CLAUDE.md ile AGENTS.md aynı yönergenin iki adıdır. Biri değişip öteki
#   kalırsa tek yönerge ikiye bölünür ve iki ajan iki ayrı kurala uyar; nöbet bu
#   ayrışmayı işleme anında yakalar. Nöbet dosyaları EŞİTLEMEZ, çünkü hangi yüzün
#   doğru olduğunu yalnız insan bilir; kapı ayrışan satırları adresiyle basar ve durur.
#
#   ⚠️ KURULUM TUZAĞI: CLAUDE.md ile AGENTS.md kullanıcının ~/.gitignore_global
#   dosyasında yok sayılmıştır; depoya ancak `git add -f CLAUDE.md AGENTS.md` ile
#   girerler. Sıradan `git add` sessizce hiçbir şey yapar görünür ve dosya izlenmeden
#   kalır. İkiz listesine üçüncü bir dosya eklenirse aynı zorlama gerekecektir.
#
#   NEDEN `--sahnelenmiş` (kapının en kritik ayrıntısı · denetçi bulgusu 2026-08-08):
#   Kapı çalışma ağacını değil, deponun SAHNELENMİŞ yüzünü ölçer. Gerekçe yaşanmış
#   bir kaçaktır: iki ikize de aynı satır eklenir, fakat zorlama her dosya için ayrı
#   gerektiğinden yalnız biri sahnelenir. Çalışma ağacı ölçülseydi iki dosya ÖZDEŞ
#   görünürdü, kapı yeşil verirdi ve depoya ayrışmış bir ikiz girerdi; üstelik çalışma
#   ağacı özdeş kaldığı sürece nöbet bir daha hiç uyanmazdı. Kapının koruduğu şey
#   deponun tarihidir, bu yüzden sorması gereken soru "bu işleme depoya ne yazacak?"
#   sorusudur. Çalışma ağacı yüzü ölçüsüz kalmaz: `npm test` içindeki canlı nöbet ile
#   bayraksız `sarmal yonerge-ikizi` komutu o yüzü ölçmeyi sürdürür. İki kip iki ayrı
#   sorudur ve biri ötekinin yerine geçmez.
#
#   İkiz listesi TEK YERDE yaşar: cekirdek/src/yonerge-ikizi.ts → YONERGE_IKIZLERI.
#   Bu kanca ikinci bir liste tutmaz; yeni dosya eklemek o dizide tek satırlık iştir.
if ! node "$MOTOR" yonerge-ikizi . --sahnelenmiş >/tmp/sarmal-kapi-ikiz.log 2>&1; then
  echo "✖ sarmal-kapı: YÖNERGE İKİZİ AYRIŞTI (sahnelenmiş yüz) — commit bloklandı:"
  echo "─────────────────────────────────────────────"
  cat /tmp/sarmal-kapi-ikiz.log
  echo "─────────────────────────────────────────────"
  echo "  → ayrışma DEPOYA yazılacak yüzdedir; diskteki iki dosya özdeş görünebilir"
  echo "  → iki dosyayı ELLE eşitle (motor hangisinin doğru olduğunu bilemez, kopyalamaz)"
  echo "  → sonra İKİSİNİ BİRDEN sahnele:  git add -f CLAUDE.md AGENTS.md"
  echo "  → ya da bilinçliyse:  git commit --no-verify"
  exit 1
fi

# — ①·c KÖK YÜZEYİ NÖBETİ (KYN-MTR-A04 · MIM-3 · STR-3) —
#   Deponun dünyaya bakan yüzü (tanıtım, katkı rehberi, güvenlik, davranış kuralı,
#   yürütücü yönergesi) çalışma alanının kökünde, iki varlığın da ÜSTÜNDE yaşar ve
#   bu yüzden varlık denetiminin görüş alanına hiç girmez. Nöbet o dosyaların
#   metnindeki kod atıflarını açık aracın kimlik evrenine vurur ve karşılıksız
#   kalanları adresiyle bildirir. Ölçüm ayrı kapıda durur, çünkü kök bulgusunu bir
#   varlığın karnesine yazmak iki varlığın sonucunu birbirine karıştırırdı.
#
#   NEDEN BLOKLAMIYOR. Kapı yalnız HATA düzeyinde durur: ilan edilmiş bir yüzeyin
#   diskte bulunamaması ya da atıf evreninin okunamaması. Karşılıksız atıf UYARI
#   konuşur ve işlemeyi kesmez, çünkü bulgunun onarımı metni yazan insanın
#   kararıdır; motor kök yüzeyinin içeriğini kendiliğinden tazelemez. Uyarılar
#   yine de basılır, dolayısıyla bayat atıf her işlemede göz önündedir.
if ! node "$MOTOR" kok-yuzeyi . >/tmp/sarmal-kapi-kok.log 2>&1; then
  echo "✖ sarmal-kapı: KÖK YÜZEYİ NÖBETİ HATA VERDİ — commit bloklandı:"
  echo "─────────────────────────────────────────────"
  cat /tmp/sarmal-kapi-kok.log
  echo "─────────────────────────────────────────────"
  echo "  → ilan ile disk ayrışmış: eksik yüzeyi yerine koy ya da kaydını listeden düşür"
  echo "  → liste TEK YERDE yaşar: cekirdek/src/kok-yuzeyi.ts → KOK_YUZEYLERI"
  echo "  → ya da bilinçliyse:  git commit --no-verify"
  exit 1
fi
grep -q "⚠️" /tmp/sarmal-kapi-kok.log && {
  echo "⚠️ sarmal-kapı: kök yüzeyinde karşılıksız atıf var (commit ENGELLENMEDİ):"
  cat /tmp/sarmal-kapi-kok.log
}

# — ①ʹ DİL-KAPISI (BKM-KBK-A02): sahnelenen .ts varsa ESLint koşar; kırmızı = commit BLOK —
#   Kapsam bilinçle dardır: yalnız hata sınıfı kurallar ve kullanılmayan kod; biçim
#   Sarmal'ın kendi biçimlendiricisinindir (urun/eslint.ortak.mjs). Süit kapısından
#   önce koşar, çünkü saniyeler sürer ve kırmızıysa dakikalarca süiti beklemeye gerek yoktur.
#   ARIZA-GÜVENLİ: npm ya da kurulu eslint yoksa atlar (geliştiriciyi kilitlemez).
for PAKET in cekirdek eklenti; do
  if git diff --cached --name-only | grep -qE "^${ONEK}urun/${PAKET}/(src|sinama|sinama_vscode)/.*\.ts$"; then
    if command -v npm >/dev/null 2>&1 && [ -x "$VARLIK/urun/$PAKET/node_modules/.bin/eslint" ]; then
      if ! (cd "$VARLIK/urun/$PAKET" && npm run --silent dil-denetle >/tmp/sarmal-kapi-dil-$PAKET.log 2>&1); then
        echo "✖ sarmal-kapı: DİL DENETİMİ KIRMIZI ($PAKET) — commit bloklandı:"
        grep -E "error|✖" /tmp/sarmal-kapi-dil-$PAKET.log | head -12
        echo "  → düzelt (susturma yalnız gerekçesiyle), ya da bilinçliyse:  git commit --no-verify"
        exit 1
      fi
      echo "🚪✅ sarmal-kapı: dil denetimi temiz ($PAKET)"
    fi
  fi
done

# — ② TEST-KAPISI (EKL-F9-A11 · HST-YUZ-A01): sahnelenen yol süitin DERİNLİĞİNİ seçer —
#   Çekirdek kodu ya da mühürlenen kaynak değiştiyse çekirdeğin TAM süiti koşar; değişmediyse
#   çekirdeğin deponun ağacını okuyan nöbet kümesi (`npm run test:agac`) koşar. Eklenti süiti
#   her işlemede koşar. ARIZA-GÜVENLİ: npm yoksa atlar ve bunu söyler. Kırmızı test = commit
#   BLOK (sahte-yeşil tarihe girmez).
#
#   MÜHÜRLENEN KAYNAK NEDEN BURADA (2026-08-06 · yaşanmış kusur): Türetilmiş yüz nöbetleri
#   kanon dosyalarının, tanı sicilinin ve sınıflama kayıtlarının sha256 özetini tutar. O gün
#   `oz/siniflama/ortu.json` bir cümlelik düzeltme aldı, özeti değişti ve nöbet kırıldı; kapı
#   yalnız `.ts` yollarına baktığı için sessiz kaldı ve kırmızı sınama depoya gönderildi.
#
#   ORTAM TEMİZLİĞİ (2026-09-19 · yaşanmış kusur): git, kancayı çağırırken GIT_INDEX_FILE ve
#   GIT_DIR gibi değişkenleri ortama yazar. Süitin içinde geçici depolarda gerçek git koşan
#   sınamalar bu değişkenleri miras alınca `git -C <geçici>` komutları ÇALIŞAN DEPONUN
#   indeksine yazar: bağlı çalışma ağacında indeks güdük dosyalarla kirlenmiş ve kapı sahte
#   kırmızı vermiştir. Süit bu yüzden git'in kanca ortamından arındırılmış olarak koşar.
#   Günlük dosyası da işlem kimliğiyle ayrılır, çünkü paralel çalışma ağaçları aynı yolu paylaşıyordu.
#
#   AĞACI OKUYAN NÖBETLER NEDEN HER İŞLEMEDE KOŞAR (HST-YUZ-A01 · yaşanmış kusur): Kapı eskiden
#   bir süiti yalnız kendi paketinin kodu değiştiğinde koşturuyordu. 2026-09-13 tarihli c4e1f7e
#   işlemesi yalnız `is/` altındaki plan dosyalarını değiştirmiş, eklenti süitinin eşdeğerlik
#   nöbeti deponun gerçek ağacını okuduğu için kırmızıya dönmüş, fakat kapı eklenti süitini hiç
#   koşmadığı için kırmızı işleme geçmiş ve kusuru ancak GitHub kontrolleri yakalamıştır. Her
#   sınama dosyası ayrı süreçte koşturulup okuduğu yollar kaydedilmiştir (2026-10-10). Eklenti
#   süitinin elli dosyasının hepsi çekirdeğin kodunu içe alır ve on altısı paketin dışından,
#   yani plan, kanon, tip kaydı, öğreti ve kök dosyalarından veri okur; bir tetikleyici listesi
#   deponun hemen her rafını saymak zorunda kalırdı. Süit yaklaşık sekiz saniye sürdüğü için
#   liste yerine her işlemede koşar ve listenin sessizce eskimesi imkânsız olur. Çekirdek
#   süitinin yüz sekiz dosyasının yetmişi paketin dışını okur, fakat tam süit yaklaşık üç dakika
#   sürdüğü için her işlemede koşamaz. Plan ya da eklenti yollarını okuyan yirmi çekirdek
#   dosyası `urun/cekirdek/package.json` içindeki `test:agac` kümesinde toplanmıştır; küme
#   zamanlamaya bağlı bir iddia taşımadığı için eşzamanlı koşar ve yaklaşık beş saniye sürer.
#   Kümeye yeni bir ağaç okuyucusu eklemek bilinçli bir iştir; kapının görmediğini, her
#   gönderimde iki tam süiti koşturan CI görür.
#
#   BAĞIMLILIK YOKSA: Kodu değiştiği için koşan süit eskisi gibi koşulsuzdur. Yalnız ağaç
#   nöbetleri için koşan süit, gereken paketlerin bağımlılıkları kurulu değilse atlanır ve kapı
#   bunu adıyla söyler; aksi hâlde `npm ci` koşmamış bir katkıcı, belge ya da plan işlemesinde
#   bağımlılık eksikliğinden doğan sahte bir kırmızıyla kilitlenirdi.
#
#   ESKİ DALLAR: `core.hooksPath` mutlak bir yolla ana çalışma ağacının kanca klasörünü gösterir;
#   dolayısıyla bağlı her çalışma ağacı işlemede BU dosyanın ana ağaçtaki kopyasını koşturur,
#   fakat süitleri kendi ağacından koşturur. Kümeyi getiren işlemeden önce ayrılmış bir dalda
#   `test:agac` betiği yoktur; orada küme adıyla atlanır, yoksa her işleme yanıltıcı bir
#   "eksik betik" kırmızısıyla durur ve dal ana dalı alınca küme kendiliğinden devreye girer.
KAPI_GUNLUK="/tmp/sarmal-kapi-test-$$.log"
KAPI_GUNLUK_EKL="/tmp/sarmal-kapi-test-ekl-$$.log"
git_ortami_temizle() { env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_PREFIX "$@"; }
# suit_kos <paket> <npm betiği> <günlük> <kırmızı başlığı> <yeşil iletisi> — kırmızıda işlemeyi durdurur.
suit_kos() {
  if ! (cd "$VARLIK/urun/$1" && git_ortami_temizle npm run --silent "$2" >"$3" 2>&1); then
    echo "✖ sarmal-kapı: $4 — commit bloklandı:"
    grep -E "✖|failing" "$3" | head -10
    echo "  → düzelt, ya da bilinçliyse:  git commit --no-verify"
    exit 1
  fi
  echo "🚪✅ sarmal-kapı: $5"
}
# bagimlilik_var <paket...> — verilen her paketin bağımlılıkları kurulu mu?
bagimlilik_var() { for p in "$@"; do [ -d "$VARLIK/urun/$p/node_modules" ] || return 1; done; }
SAHNE=$(git diff --cached --name-only)
if command -v npm >/dev/null 2>&1; then
  if printf '%s\n' "$SAHNE" | grep -qE "^${ONEK}(urun/cekirdek/(src|sinama)/.*\.ts|yasa/kanon/.*\.sar|oz/siniflama/.*\.json)$"; then
    echo "🚪 sarmal-kapı: çekirdek kodu ya da mühürlenen kaynak değişti → test kapısı…"
    suit_kos cekirdek test "$KAPI_GUNLUK" "ÇEKİRDEK TESTLERİ KIRMIZI" "çekirdek testleri yeşil"
  elif ! grep -q '"test:agac"' "$VARLIK/urun/cekirdek/package.json" 2>/dev/null; then
    echo "🚪 sarmal-kapı: bu ağaçta test:agac betiği yok → çekirdeğin ağaç nöbetleri atlandı (dal, kümeyi getiren işlemenin gerisinde)"
  elif bagimlilik_var cekirdek eklenti; then
    echo "🚪 sarmal-kapı: çekirdeğin ağacı okuyan nöbetleri → test kapısı…"
    suit_kos cekirdek test:agac "$KAPI_GUNLUK" "ÇEKİRDEĞİN AĞAÇ NÖBETLERİ KIRMIZI" "çekirdeğin ağaç nöbetleri yeşil"
  else
    echo "🚪 sarmal-kapı: bağımlılıklar kurulu değil → çekirdeğin ağaç nöbetleri atlandı (iki pakette npm ci)"
  fi
  if printf '%s\n' "$SAHNE" | grep -qE "^${ONEK}urun/eklenti/(src|sinama)/.*\.ts$"; then
    echo "🚪 sarmal-kapı: eklenti kodu değişti → test kapısı…"
    suit_kos eklenti test "$KAPI_GUNLUK_EKL" "EKLENTİ TESTLERİ KIRMIZI" "eklenti testleri yeşil"
  elif bagimlilik_var eklenti; then
    echo "🚪 sarmal-kapı: eklenti süiti deponun ağacını okur → test kapısı…"
    suit_kos eklenti test "$KAPI_GUNLUK_EKL" "EKLENTİ TESTLERİ KIRMIZI" "eklenti testleri yeşil"
  else
    echo "🚪 sarmal-kapı: eklenti bağımlılıkları kurulu değil → eklenti süiti atlandı (urun/eklenti içinde npm ci)"
  fi
else
  echo "🚪 sarmal-kapı: npm yok → süit kapısı atlandı"
fi

# — ④ YASAK SÖZCÜK TARAMASI (KNT-16 · liste depo DIŞINDA yaşar) —
#   Açık depoya müşteri ya da kişi adı, gerçek e-posta ve kapalı ürünün kodları
#   yazılmaz. Yasak adların kendisi de yasak olduğu için liste depoda değil
#   kullanıcının makinesinde durur; liste yoksa tarama atlanır ve bunu söyler.
YASAK="${SARMAL_YASAK_LISTESI:-$HOME/.config/sarmal/yasak-sozcukler.txt}"
if [ -f "$YASAK" ]; then
  DESEN_DOSYASI=$(mktemp)
  grep -vE '^[[:space:]]*(#|$)' "$YASAK" > "$DESEN_DOSYASI"
  if [ -s "$DESEN_DOSYASI" ]; then
    BULGU=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+' | grep -inE -f "$DESEN_DOSYASI" | head -5)
    if [ -n "$BULGU" ]; then
      echo "✖ sarmal-kapı: YASAK AD YA DA KOD sahnelenen içerikte (KNT-16) — commit bloklandı:"
      printf '%s\n' "$BULGU" | cut -c1-160 | sed 's/^/  · /'
      echo "  → adı sil; 'bir müşteri projesi' ya da 'kapalı ürün' de. Liste: $YASAK"
      rm -f "$DESEN_DOSYASI"
      exit 1
    fi
  fi
  rm -f "$DESEN_DOSYASI"
  echo "🚪✅ sarmal-kapı: yasak sözcük taraması temiz"
else
  echo "🚪 sarmal-kapı: yasak sözcük listesi yok ($YASAK) → tarama atlandı"
fi

# — ③ PROJE-ÖZEL KURALLAR (opsiyonel · içi İLERİDE dolar) —
KURAL="$VARLIK/kanca/proje-kurallari.sh"
[ -x "$KURAL" ] && { "$KURAL" || exit 1; }

echo "🚪✅ sarmal-kapı: drift yok — commit geçti"
exit 0
